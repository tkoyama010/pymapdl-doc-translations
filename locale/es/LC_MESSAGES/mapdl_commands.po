#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.psf:18
msgid "Labels identifying the surface load to be shown; see :ref:`psf_tab_1`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.psf:21
msgid "Key to turn surface load symbols on or off:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.psf:23
msgid "``0`` - Off (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.psf:25
msgid ""
"``1`` - On, shown as face outlines. Line surface loads ( :ref:`sfl` ) on "
"solid model plots are shown as arrows."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.psf:28
msgid "``2`` - On, shown as arrows."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.psf:30
msgid ""
"``3`` - On, shown as color filled surfaces. Line and area surface loads ( "
":ref:`sfl` and :ref:`sfa` ) on solid model plots are shown as arrows."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.psf:33
