msgid ""
"Mechanical APDL Command: `/GTHK "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_GTHK.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:9
msgid "Apply thicknesses as selected from the following labels:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:11
msgid ""
"``AXIS`` - Modify thickness of ordinate and abscissa axes on graph displays."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:13
msgid "``GRID`` - Modify thickness of grid lines on graph displays."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:15
msgid ""
"``CURVE`` - Modify thickness of curve lines (when no area fill ( "
":ref:`gropt` ))."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:17
msgid "**thick** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:18
msgid "Thickness ratio (whole numbers only, from -1 to 10):"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:20
msgid ""
"``-1`` - Do not draw the curve, but show only the markers specified by "
":ref:`gmarker`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:22
msgid "``0 or 1`` - Thin lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:24
msgid "``2`` - The default thickness."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:26
msgid "``3`` - 1.5 times the default thickness."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:28
msgid "``etc.`` - (up to 10)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk:44
msgid ""
"Sets line thicknesses for graph lines (in raster mode only). Use "
":ref:`gthk`,STAT to show settings."
msgstr ""

