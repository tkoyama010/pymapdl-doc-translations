"specified in the local direction 4 (ROTX)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.tbplot:41
