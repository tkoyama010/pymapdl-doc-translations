#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.transfer:66
msgid "This command is also valid in the :ref:`slashmap` processor."
msgstr ""

