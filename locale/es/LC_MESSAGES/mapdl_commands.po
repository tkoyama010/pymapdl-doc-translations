msgid ""
"Mechanical APDL Command: `ESORT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_ESORT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/element_table.pydocstring
#: of ansys.mapdl.core._commands.post1.element_table.ElementTable.esort:10
msgid "Use ascending element number order."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/element_table.pydocstring
#: of ansys.mapdl.core._commands.post1.element_table.ElementTable.esort:17
msgid "``ETAB`` - (currently the only ``Item`` available)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/element_table.pydocstring
#: of ansys.mapdl.core._commands.post1.element_table.ElementTable.esort:20
msgid "element table label:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/element_table.pydocstring
#: of ansys.mapdl.core._commands.post1.element_table.ElementTable.esort:22
msgid ""
"``Lab`` - Any user-defined label from the :ref:`etable` command (input in "
"the ``Lab`` field of the :ref:`etable` command)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/element_table.pydocstring
#: of ansys.mapdl.core._commands.post1.element_table.ElementTable.esort:25
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/results.pydocstring of
#: ansys.mapdl.core._commands.post1.results.Results.nsort:15
