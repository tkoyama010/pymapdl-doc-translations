#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp:2
msgid "Selects single or multiple Y-axes graph displays."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp:4
msgid ""
"Mechanical APDL Command: `/GRTYP "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_GRTYP.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp:8
msgid "**kaxis** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp:9
msgid "Axis selection key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp:11
msgid "``0 or 1`` - Single Y-axis. Up to 10 curves scaled to a single Y-axis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp:13
msgid ""
"``2`` - Additional Y-axes (one for each curve) (3 curves maximum). Allows "
"better scaling of curves with widely differing numbering ranges."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp:16
msgid ""
"``3`` - Same as 2 but with additional Y-axis and curves projected out of the"
" plane (6 curves maximum). Allows clearer display with an isometric view. "
"The default view when ``KAXIS`` = 3 is View,1,1,2,3."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp:34
msgid ""
"The basic line graph has one or more curves plotted against the same Y and X"
" axes. Multiple curve graphs can also be plotted with individual Y axes and "
"the same X axis. The Y axis of the first curve is referred to as the base "
"Y-axis and the Y axes of the other curves as additional Y axes. Curves are "
"numbered sequentially from 1 (the base curve) in the order in which they are"
" displayed. See the :ref:`axlab`, :ref:`gropt`, :ref:`grid`, and :ref:`gthk`"
" commands for other display options."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.graphs.Graphs.gthk.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.graphs.Graphs.gthk"
msgstr ""

