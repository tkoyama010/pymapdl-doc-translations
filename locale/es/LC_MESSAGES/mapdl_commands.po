#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.n:4
msgid ""
"Mechanical APDL Command: `N "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_N.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.n:9
msgid ""
"Node number to be assigned. A previously defined node of the same number "
"will be redefined. Defaults to the maximum node number used +1."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.n:13
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
