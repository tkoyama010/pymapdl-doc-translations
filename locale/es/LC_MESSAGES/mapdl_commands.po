msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/session/files.rst:30:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.starlist:2
msgid "Displays the contents of an external, coded file."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.starlist:4
msgid ""
"Mechanical APDL Command: `\\*LIST "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LIST_st.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.starlist:30
msgid ""
"Displays the contents of an external, coded file. The file to be listed "
"cannot be in use (open) at the time (except for the error file, "
