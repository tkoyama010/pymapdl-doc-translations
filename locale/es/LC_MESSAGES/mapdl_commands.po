#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.msopt:88
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.msopt:94
