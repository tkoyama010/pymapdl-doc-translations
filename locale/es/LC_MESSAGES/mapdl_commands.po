msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.cecycms:54
msgid ""
"``1`` - Print the table. If edge nodes are mapped ( ``KMAP`` = ON) and a "
"high edge node is matching a low edge node, the third column labeled MAPPED "
"lists the node number. (See :ref:`Snippets of Table Printed with "
"<CECYCMS_examples_PrintTable>` ``KPRINT`` = 1 on :ref:`cecycms` )."
msgstr ""

