#: ../../pymapdl/doc/source/mapdl_commands/prep7/materials.rst:41:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:2
msgid "Specifies the system of units for magnetic field problems."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:4
msgid ""
"Mechanical APDL Command: `EMUNIT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_EMUNIT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:10
msgid ""
"Rationalized MKS system of units (meters, amperes, henries, webers, etc.). "
"Free-space permeability is set to 4 πe-7 Henries/meter, free-space "
"permittivity is set to 8.85e-12 Farads/meter."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:16
msgid "Label specifying the type of units:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:18
msgid ""
"``MKS`` - Rationalized MKS system of units (meters, amperes, henries, "
"webers, etc.). Free-space permeability is set to 4 πe-7 henries/meter. Free-"
"space permittivity is set to 8.85 e-12 F/m."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:21
msgid ""
"``MUZRO`` - User defined system of units. Free-space permeability is set to "
"the value input for ``VALUE``. Other units must correspond to the "
"permeability units. Relative permeability may be altered to absolute values."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:25
msgid ""
"``EPZRO`` - User defined system of units. Free-space permittivity is set to "
"the value input for VALUE. Other units must correspond to the permittivity "
"units."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:29
msgid ""
"User value of free-space permeability (defaults to 1) if ``Lab`` = MUZRO, or"
" free-space permittivity (defaults to 1) if ``Lab`` = EPZRO."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.emunit:46
msgid ""
"Specifies the system of units to be used for electric and magnetic field "
"problems. The free-space permeability and permittivity values may be set as "
"desired. These values are used with the relative property values ( :ref:`mp`"
" ) to establish absolute property values. If the magnetic source field "
"strength (H:sub:`s` ) has already been calculated ( :ref:`biot` ), switching"
" :ref:`emunit` will not change the values."
msgstr ""

