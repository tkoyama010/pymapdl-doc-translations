#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:15
msgid "**yref** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:16
msgid "Y coordinate of the reference point. Defaults to zero."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:18
msgid "**rotx0** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:19
msgid "Rotation of the ending plane about X in radians Defaults to zero."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:21
msgid "**roty0** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:22
msgid "Rotation of the ending plane about Y in radians Defaults to zero."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:38
msgid ""
"The ending point is automatically determined from the starting (reference) "
"point and the geometry inputs. All inputs are in the global Cartesian "
"coordinate system. For more information about the generalized plane strain "
"feature, see Generalized Plane Strain Option of Current-Technology Solid "
"Elements in the `Element Reference "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_BIBLIO.html>`_."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.imesh"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:2
msgid "Generates nodes and interface elements along lines or areas."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:4
msgid ""
"Mechanical APDL Command: `IMESH "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_IMESH.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:8
msgid "**laky** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:9
msgid "Copies mesh according to the following:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:11
msgid "``LINE or 1`` - Copies line mesh (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:13
msgid "``AREA or 2`` - Copies area mesh."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:15
msgid "**nsla** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:16
msgid ""
"Number that identifies the source line or area. This is the line or area "
"whose mesh will provide the pattern for the interface elements. Mechanical "
"APDL copies the pattern of the line or area elements through the area or "
"volume to create the mesh of area or volume interface elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:20
msgid "**ntla** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:21
msgid ""
"Number that identifies the target line or area. This is the line or area "
"that is opposite the source line or area specified by ``NSLA``. Add ``NTLA``"
" to obtain the copied mesh from the source line or area."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:26
msgid ""
"Number that identifies the particular Mechanical APDL coordinate system."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:29
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:35
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:41
msgid ""
"Incremental translation of node coordinates in the active coordinate system "
"( ``DR``, ``Dθ``, ``DZ`` for cylindrical, and ``DR``, ``Dθ``, ``DΦ`` for "
"spherical or toroidal). The source line or area coordinates + ``DX``, "
"``DY``, ``DZ`` = the target line or area coordinates. If left blank, "
"Mechanical APDL automatically estimates the incremental translation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:47
msgid ""
"Tolerance for verifying topology and geometry. By default, Mechanical APDL "
"automatically calculates the tolerance based on associated geometries."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:64
msgid ""
"Generates nodes and interface elements along lines or areas. The "
":ref:`imesh` command requires that the target line or area exactly match the"
" source line or area. Also, both target and source lines or areas must be in"
" the same area or volume. The area or volume containing the source line or "
"area must be meshed before executing :ref:`imesh`, while the area or volume "
"containing the target line or area must be meshed after executing "
":ref:`imesh`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.imesh:70
msgid ""
"For three dimensional problems where ``LAKY`` = AREA, Mechanical APDL fills "
"the interface layer as follows: This command contains some tables and extra "
"information which can be inspected in the original documentation pointed "
"above."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.katt.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.katt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:2
msgid "Associates attributes with the selected, unmeshed keypoints."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:4
msgid ""
"Mechanical APDL Command: `KATT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_KATT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:13
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:17
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:21
msgid ""
"Material number, real constant set number, type number, and coordinate "
"system number to be associated with selected, unmeshed keypoints."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:38
msgid ""
"Keypoints subsequently generated from the keypoints will also have these "
"attributes. These element attributes will be used when the keypoints are "
"meshed. If a keypoint does not have attributes associated with it (by this "
"command) at the time it is meshed, the attributes are obtained from the then"
" current :ref:`mat`, :ref:`real`, :ref:`type`, and :ref:`esys` command "
"settings. Reissue the :ref:`katt` command (before keypoints are meshed) to "
"change the attributes. A zero (or blank) argument removes the corresponding "
"association."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:45
msgid ""
"If any of the arguments ``MAT``, ``REAL``, ``TYPE``, or ``ESYS`` are defined"
" as -1, then that value will be left unchanged in the selected set."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.katt:48
msgid ""
"In some cases, Mechanical APDL can proceed with a keypoint meshing operation"
" even when no logical element type has been assigned via :ref:`katt`, "
"``TYPE`` or :ref:`type`. For more information, see the discussion on setting"
" element attributes in `Meshing Your Solid Model "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD7_8.html>`_"
" eshing Your Solid Model in the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.kclear.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.kclear"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kclear:2
msgid "Deletes nodes and point elements associated with selected keypoints."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kclear:4
msgid ""
"Mechanical APDL Command: `KCLEAR "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_KCLEAR.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kclear:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kclear:16
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kclear:23
msgid ""
"Delete mesh for keypoints ``NP1`` to ``NP2`` (defaults to ``NP1`` ) in steps"
" of ``NINC`` (defaults to 1). If ``NP1`` = ALL, ``NP2`` and ``NINC`` are "
"ignored and the mesh for all selected keypoints ( :ref:`ksel` ) is deleted. "
"If ``NP1`` = P, graphical picking is enabled and all remaining command "
"fields are ignored (valid only in the GUI). A component name may also be "
"substituted for ``NP1``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kclear:43
msgid ""
"Deletes all nodes and point elements associated with selected keypoints "
"(regardless of whether the nodes or elements are selected). Nodes associated"
" with non-point elements will not be deleted. Attributes assigned as a "
"result of :ref:`katt` are maintained. In the program's response to the "
"command, if a keypoint is tallied as cleared, it means either its node or "
"element reference was deleted."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.kesize"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize:2
msgid "Specifies the edge lengths of the elements nearest a keypoint."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize:4
msgid ""
"Mechanical APDL Command: `KESIZE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_KESIZE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize:9
msgid ""
"Number of the keypoint whose lines will be adjusted. If ALL, use all "
"selected keypoints ( :ref:`ksel` ). If ``NPT`` = P, graphical picking is "
"enabled and all remaining command fields are ignored (valid only in the "
"GUI)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize:14
msgid ""
"Size of elements along lines nearest keypoint ``NPT`` (overrides any other "
"specified size). If ``SIZE`` is zero (or blank), use ``FACT1`` or ``FACT2``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize:18
msgid ""
"Scale factor applied to a previously defined ``SIZE``. Not used if ``SIZE`` "
"is input."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize:21
msgid ""
"Scale factor applied to the minimum element division at keypoint ``NPT`` for"
" any attached line. This feature is useful with adaptive mesh refinement. "
"Not used if ``SIZE`` or ``FACT1`` is input."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize:39
msgid ""
"Affects only the line divisions adjacent to the keypoint on lines not "
"previously assigned divisions by other line commands ( :ref:`lesize`, etc.)."
" The remaining line divisions are determined from the division nearest the "
"keypoint at the other end of the line (specified by another :ref:`kesize` "
"command or the :ref:`esize` command). Divisions are transferred to the lines"
" during the mesh operation. If smart element sizing is being used ( "
":ref:`smrtsize` ), :ref:`kesize` specifications may be overridden (that is, "
"a smaller element size may be used) to accommodate curvature and small "
"features."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kesize:47
msgid ""
"This command is valid in any processor. The command is also valid for "
"`rezoning "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/Hlp_G_ADVRZSMP.html>`_."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.kmesh.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.kmesh"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kmesh:2
msgid "Generates nodes and point elements at keypoints."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kmesh:4
msgid ""
"Mechanical APDL Command: `KMESH "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_KMESH.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kmesh:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kmesh:15
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kmesh:21
msgid ""
"Mesh keypoints from ``NP1`` to ``NP2`` (defaults to ``NP1`` ) in steps of "
"``NINC`` (defaults to 1). If ``NP1`` = ALL, ``NP2`` and ``NINC`` are ignored"
" and all selected keypoints ( :ref:`ksel` ) are meshed. If ``NP1`` = P, "
"graphical picking is enabled and all remaining command fields are ignored "
"(valid only in the GUI). A component name may also be substituted for "
"``NP1``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kmesh:40
msgid ""
"Missing nodes required for the generated elements are created and assigned "
"the lowest available numbers."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.krefine"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:2
msgid "Refines the mesh around specified keypoints."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:4
msgid ""
"Mechanical APDL Command: `KREFINE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_KREFINE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:16
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:23
msgid ""
"Keypoints ( ``NP1`` to ``NP2`` in increments of ``NINC`` ) around which the "
"mesh is to be refined. ``NP2`` defaults to ``NP1``, and ``NINC`` defaults to"
" 1. If ``NP1`` = ALL, ``NP2`` and ``NINC`` are ignored and all selected "
"keypoints are used for refinement. If ``NP1`` = P, graphical picking is "
"enabled and all remaining command fields are ignored (valid only in the "
"GUI). A component name may also be substituted for ``NP1`` ( ``NP2`` and "
"``NINC`` are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:35
msgid ""
"Depth of mesh refinement in terms of the number of elements outward from the"
" indicated keypoints (defaults to 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:49
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:49
msgid ""
"Flag indicating whether quadrilateral elements must be retained in the "
"refinement of an all- quadrilateral mesh. (Mechanical APDL ignores the "
"``RETAIN`` argument when you are refining anything other than a "
"quadrilateral mesh.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:72
msgid ""
":ref:`krefine` performs local mesh refinement around the specified "
"keypoints. By default, the indicated elements are split to create new "
"elements with 1/2 the edge length of the original elements ( ``LEVEL`` = 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:76
msgid ""
":ref:`krefine` refines all area elements and tetrahedral volume elements "
"that are adjacent to the specified keypoints. Any volume elements that are "
"adjacent to the specified keypoints, but are not tetrahedra (for example, "
"hexahedra, wedges, and pyramids), are not refined."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.krefine:80
msgid ""
"You cannot use mesh refinement on a solid model that contains initial "
"conditions at nodes ( :ref:`ic` ), coupled nodes ( :ref:`cp` family of "
"commands), constraint equations ( :ref:`ce` family of commands), or boundary"
" conditions or loads applied directly to any of its nodes or elements. This "
"applies to nodes and elements anywhere in the model, not just in the region "
"where you want to request mesh refinement. See `Revising Your Model "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD8_6.html>`_"
"  in the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_"
" for additional restrictions on mesh refinement."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.kscon"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:2
msgid "Specifies a keypoint about which an area mesh will be skewed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:4
msgid ""
"Mechanical APDL Command: `KSCON "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_KSCON.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:9
msgid ""
"Keypoint number at concentration. If ``NPT`` = ALL, use all selected "
"keypoints. If remaining fields are blank, remove concentration from this "
"keypoint (if unmeshed). If ``NPT`` = P, graphical picking is enabled and all"
" remaining command fields are ignored (valid only in the GUI). A component "
"name may also be substituted for ``NPT``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:14
msgid "**delr** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:15
msgid "Radius of first row of elements about keypoint."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:17
msgid "**kctip** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:18
msgid "Crack tip singularity key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:20
msgid "``0`` - Do not skew midside nodes, if any, within the element."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:22
msgid ""
"``1`` - Skew midside nodes of the first row of elements to the 1/4 point for"
" crack tip singularity."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:25
msgid "**nthet** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:26
msgid ""
"Number of elements in circumferential direction (defaults to approximately "
"one per 45° (or one per 30°, if ``KCTIP`` = 1))."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:29
msgid "**rrat** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:30
msgid ""
"Ratio of 2nd row element size to ``DELR`` (defaults to 0.75, or 0.5 if "
"``KCTIP`` = 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.kscon:46
msgid ""
"Defines a concentration keypoint about which an area mesh will be skewed. "
"Useful for modeling stress concentrations and crack tips. During meshing, "
"elements are initially generated circumferentially about, and radially away,"
" from the keypoint. Lines attached to the keypoint are given appropriate "
"divisions and spacing ratios. Only one concentration keypoint per unmeshed "
"area is allowed. Use :ref:`kscon`,STAT to list current status of "
"concentration keypoints. The :ref:`kscon` command does not support 3D "
"modeling."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.latt.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.latt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:2
msgid "Associates element attributes with the selected, unmeshed lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:4
msgid ""
"Mechanical APDL Command: `LATT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LATT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:13
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:17
msgid ""
"Material number, real constant set number, and type number to be associated "
"with selected, unmeshed lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:20
msgid "**kb** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:21
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:32
msgid ""
"Beginning and ending orientation keypoints to be associated with selected, "
"unmeshed lines. Mechanical APDL uses the location of these keypoints to "
"determine how to orient beam cross sections during beam meshing. Beam "
"elements may be created along a line with a constant orientation by "
"specifying only one orientation keypoint ( ``KB`` ), or a pre-twisted beam "
"may be created by selecting different orientation keypoints at each end of "
"the line ( ``KB`` and ``KE`` ). (For a line bounded by two keypoints ( "
"``KP1`` and ``KP2`` ), the orientation vector at the beginning of the line "
"extends from ``KP1`` to ``KB``, and the orientation vector at the end of the"
" line extends from ``KP2`` to ``KE``. The orientation vectors are used to "
"compute the orientation nodes of the elements.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:31
msgid "**ke** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:42
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.vatt:24
msgid "**secnum** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:43
msgid ""
"Section identifier to be associated with selected, unmeshed lines. For "
"details, see the description of the :ref:`sectype` and :ref:`secnum` "
"commands."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:60
msgid ""
"The element attributes specified by the :ref:`latt` command will be used "
"when the lines are meshed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:62
msgid ""
"Lines subsequently generated from the lines will also have the attributes "
"specified by ``MAT``, ``REAL``, ``TYPE``, and ``SECNUM``. If a line does not"
" have these attributes associated with it (by this command) at the time it "
"is meshed, the attributes are obtained from the then current :ref:`mat`, "
":ref:`real`, :ref:`type`, and :ref:`secnum` command settings."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:67
msgid ""
"In contrast, the values specified by ``KB`` and ``KE`` apply only to the "
"selected lines; t hat is, lines subsequently generated from these lines will"
" not share these attributes. Similarly, if a line does not have ``KB`` and "
"``KE`` attributes associated with it via the :ref:`latt` command at the time"
" it is meshed, Mechanical APDL cannot obtain the attributes from elsewhere. "
"See the discussion on beam meshing in `Meshing Your Solid Model "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD7_8.html>`_"
" in the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_"
" for more information."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:78
msgid ""
"Reissue the :ref:`latt` command (before lines are meshed) to change the "
"attributes. A zero (or blank) argument removes the corresponding "
"association. If any of the arguments are defined as -1, then that value will"
" be left unchanged in the selected set."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.latt:82
msgid ""
"In some cases, Mechanical APDL can proceed with a line meshing operation "
"even when no logical element type has been assigned via :ref:`latt`, "
"``TYPE`` or :ref:`type`. See `Meshing Your Solid Model "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD7_8.html>`_"
" in the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_"
" for more information about setting element attributes."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.lccat"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat:2
msgid "Concatenates multiple lines into one line for mapped meshing."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat:4
msgid ""
"Mechanical APDL Command: `LCCAT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LCCAT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat:15
msgid ""
"Lines to be concatenated. If ``NL1`` = ALL, ``NL2`` is ignored and all "
"selected lines ( :ref:`lsel` ) are concatenated. If ``NL1`` = P, graphical "
"picking is enabled and all remaining command fields are ignored (valid only "
"in the GUI). A component name may also be substituted for ``NL1`` ( ``NL2`` "
"is ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat:34
msgid ""
"Concatenates multiple, adjacent lines (the input lines) into one line (the "
"output line) in preparation for mapped meshing. An area that contains too "
"many lines for mapped meshing can still be mapped meshed if some of the "
"lines in that area are first concatenated (see `Meshing Your Solid Model "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD7_8.html>`_"
" in the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_"
" for details on mapped meshing restrictions)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat:42
msgid ""
":ref:`lccat` is meant to be used solely for meshing and cannot be used for "
"any other purposes. Specifically, (a) the output line and any areas that "
"have the output line on their line list ( :ref:`alist` ) cannot be used as "
"input to any other solid modeling operation (not even another :ref:`lccat` "
"command); and (b) the output line cannot accept solid model boundary "
"conditions ( :ref:`dl`, :ref:`sfl` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat:48
msgid ""
"The output line will take on the element divisions of the input lines and "
"will not accept element divisions that are directly assigned ( :ref:`lesize`"
" ). The output line from the :ref:`lccat` operation will be coincident with "
"the input lines and the input lines will be retained. Consider the "
":ref:`lcomb` command instead of :ref:`lccat` if you wish to delete the input"
" lines and if the lines to be combined have similar slopes at the common "
"keypoint(s). When an :ref:`lccat` command is issued, area line lists ( "
":ref:`alist` ) that contain all of the input lines will be updated so that "
"the area line lists refer to the output line instead of the input lines. "
"Deletion of the output line ( :ref:`ldele` ) effectively reverses the "
":ref:`lccat` operation and restores area line lists to their original "
"condition."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lccat:58
msgid ""
"You can use the :ref:`lsel` command to select lines that were created by "
"concatenation, and then follow it with an :ref:`ldele`,ALL command to delete"
" them. Also see `Meshing Your Solid Model "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD7_8.html>`_"
"  in the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_"
" for a discussion on how to easily select and delete concatenated lines in "
"one step."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.lclear.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.lclear"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lclear:2
msgid "Deletes nodes and line elements associated with selected lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lclear:4
msgid ""
"Mechanical APDL Command: `LCLEAR "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LCLEAR.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lclear:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lclear:16
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lclear:23
msgid ""
"Delete mesh for lines ``NL1`` to ``NL2`` (defaults to ``NL1`` ) in steps of "
"``NINC`` (defaults to 1). If ``NL1`` = ALL, ``NL2`` and ``NINC`` are ignored"
" and the mesh for all selected lines ( :ref:`lsel` ) is deleted. If ``NL1`` "
"= P, graphical picking is enabled and all remaining command fields are "
"ignored (valid only in the GUI). A component name may also be substituted "
"for ``NL1`` ( ``NL2`` and ``NINC`` are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lclear:43
msgid ""
"Deletes all nodes and line elements associated with selected lines "
"(regardless of whether the nodes or elements are selected). Nodes shared by "
"adjacent meshed lines and nodes associated with non-line elements will not "
"be deleted. Attributes assigned as a result of :ref:`latt` are maintained. "
"In the program's response to the command, if a line or keypoint is tallied "
"as \"cleared,\" it means either its node or element reference was deleted."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.lesize"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:2
msgid "Specifies the divisions and spacing ratio on unmeshed lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:4
msgid ""
"Mechanical APDL Command: `LESIZE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LESIZE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:9
msgid ""
"Number of the line to be modified. If ALL, modify all selected lines ( "
":ref:`lsel` ). If ``NL1`` = P, graphical picking is enabled and all "
"remaining command fields are ignored (valid only in the GUI). A component "
"name may also be substituted for ``NL1``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:14
msgid ""
"If ``NDIV`` is blank, ``SIZE`` is the division (element edge) length. The "
"number of divisions is automatically calculated from the line length "
"(rounded upward to next integer). If ``SIZE`` is zero (or blank), use "
"``ANGSIZ`` or ``NDIV``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:18
msgid "**angsiz** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:19
msgid ""
"The division arc (in degrees) spanned by the element edge (except for "
"straight lines, which always result in one division). The number of "
"divisions is automatically calculated from the line length (rounded upward "
"to next integer)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:24
msgid ""
"If positive, ``NDIV`` is the number of element divisions per line. If -1 "
"(and ``KFORC`` = 1), ``NDIV`` is assumed to be zero element divisions per "
"line. TARGE169 with a rigid specification ignores ``NDIV`` and will always "
"mesh with one element division."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:29
msgid ""
"Spacing ratio. If positive, nominal ratio of last division size to first "
"division size (if > 1.0, sizes increase, if < 1.0, sizes decrease). If "
"negative, \\| ``SPACE`` \\| is nominal ratio of center division(s) size to "
"end divisions size. Ratio defaults to 1.0 (uniform spacing). For layer-"
"meshing, a value of 1.0 normally is used. If ``SPACE`` = FREE, ratio is "
"determined by other considerations"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:35
msgid "**kforc** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:36
msgid ""
"``KFORC`` 0-3 are used only with ``NL1`` = ALL. Specifies which selected "
"lines are to be modified."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:38
msgid "``0`` - Modify only selected lines having undefined (zero) divisions."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:40
msgid "``1`` - Modify all selected lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:42
msgid ""
"``2`` - Modify only selected lines having fewer divisions (including zero) "
"than specified with this command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:45
msgid ""
"``3`` - Modify only selected lines having more divisions than specified with"
" this command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:47
msgid ""
"``4`` - Modify only nonzero settings for ``SIZE``, ``ANGSIZ``, ``NDIV``, "
"``SPACE``, ``LAYER1``, and ``LAYER2``. If ``KFORC`` = 4, blank or 0 settings"
" remain unchanged."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:50
msgid "**layer1** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:51
msgid ""
"Layer-meshing control parameter. Distance which defines the thickness of the"
" inner mesh layer, ``LAYER1``. Elements in this layer are uniformly-sized "
"with edge lengths equal to the specified element size for the line (either "
"through ``SIZE`` or line-length/ ``NDIV`` ). A positive value for ``LAYER1``"
" is interpreted as an absolute length, while a negative value in interpreted"
" as a multiplier on the specified element size for the line. As a general "
"rule, the resulting thickness of the inner mesh layer should be greater than"
" or equal to the specified element size for the line. If ``LAYER1`` = OFF, "
"layer-meshing control settings are cleared for the selected lines. The "
"default value is 0.0"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:60
msgid "**layer2** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:61
msgid ""
"Layer-meshing control parameter. Distance which defines the thickness of the"
" outer mesh layer, ``LAYER2``. Elements in this layer transition in size "
"from those in ``LAYER1`` to the global element size. A positive value of "
"``LAYER2`` is interpreted as an absolute length, while a negative value is "
"interpreted as a mesh transition factor. A value of ``LAYER2`` = -2 would "
"indicate that elements should approximately double in size as the mesh "
"progresses normal to ``LAYER1``. The default value is 0.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:68
msgid "**kyndiv** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:69
msgid ""
"0, No, and Off means that SmartSizing cannot override specified divisions "
"and spacing ratios. Mapped mesh fails if divisions do not match. This "
"defines the specification as hard."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:72
msgid ""
"1, Yes, and On means that SmartSizing can override specified divisions and "
"spacing ratios for curvature or proximity. Mapped meshing can override "
"divisions to obtain required matching divisions. This defines the "
"specification as soft."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lesize:90
msgid ""
"Defines the number of divisions and the spacing ratio on selected lines. "
"Lines with previously specified divisions may also be changed."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.lmesh.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.lmesh"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lmesh:2
msgid "Generates nodes and line elements along lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lmesh:4
msgid ""
"Mechanical APDL Command: `LMESH "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LMESH.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lmesh:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lmesh:16
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lmesh:23
msgid ""
"Mesh lines from ``NL1`` to ``NL2`` (defaults to ``NL1`` ) in steps of "
"``NINC`` (defaults to 1). If ``NL1`` = ALL, ``NL2`` and ``NINC`` are ignored"
" and all selected lines ( :ref:`lsel` ) are meshed. If ``NL1`` = P, "
"graphical picking is enabled and all remaining command fields are ignored "
"(valid only in the GUI). A component name may also be substituted for "
"``NL1`` ( ``NL2`` and ``NINC`` are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lmesh:43
msgid ""
"Generates nodes and line elements along lines. Missing nodes required for "
"the generated elements are created and assigned the lowest available "
"numbers."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.lrefine"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:2
msgid "Refines the mesh around specified lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:4
msgid ""
"Mechanical APDL Command: `LREFINE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LREFINE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:16
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:23
msgid ""
"Lines ( ``NL1`` to ``NL2`` in increments of ``NINC`` ) around which the mesh"
" is to be refined. ``NL2`` defaults to ``NL1``, and ``NINC`` defaults to 1. "
"If ``NL1`` = ALL, ``NL2`` and ``NINC`` are ignored and all selected lines "
"are used for refinement. If ``NL1`` = P, graphical picking is enabled and "
"all remaining command fields are ignored (valid only in the GUI). A "
"component name may also be substituted for ``NL1`` ( ``NL2`` and ``NINC`` "
"are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:35
msgid ""
"Depth of mesh refinement in terms of the number of elements outward from the"
" indicated lines (defaults to 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:72
msgid ""
":ref:`lrefine` performs local mesh refinement around the specified lines. By"
" default, the indicated elements are split to create new elements with 1/2 "
"the edge length of the original elements ( ``LEVEL`` = 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:76
msgid ""
":ref:`lrefine` refines all area elements and tetrahedral volume elements "
"that are adjacent to the specified lines. Any volume elements that are "
"adjacent to the specified lines, but are not tetrahedra (for example, "
"hexahedra, wedges, and pyramids), are not refined."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.lrefine:80
msgid ""
"You cannot use mesh refinement on a solid model that contains initial "
"conditions at nodes ( :ref:`ic` ), coupled nodes ( :ref:`cp` family of "
"commands), constraint equations ( :ref:`ce` family of commands), or boundary"
" conditions or loads applied directly to any of its nodes or elements. This "
"applies to nodes and elements anywhere in the model, not just in the region "
"where you want to request mesh refinement. For additional restrictions on "
"mesh refinement, see `Revising Your Model "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD8_6.html>`_"
" in the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.mat.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.mat"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mat:2
msgid "Sets the element material attribute pointer."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mat:4
msgid ""
"Mechanical APDL Command: `MAT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_MAT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mat:9
msgid ""
"Assign this material number to subsequently defined elements (defaults to "
"1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mat:25
msgid ""
"Identifies the material number to be assigned to subsequently defined "
"elements. This number refers to the material number ( ``MAT`` ) defined with"
" the material properties ( :ref:`mp` ). Material numbers may be displayed ( "
":ref:`pnum` )."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.mcheck"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:2
msgid "Checks mesh connectivity."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:4
msgid ""
"Mechanical APDL Command: `MCHECK "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_MCHECK.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:9
msgid "Operation:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:11
msgid "``ESEL`` - Unselects the valid elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:27
msgid ""
"Wherever two area or volume elements share a common face, :ref:`mcheck` "
"verifies that the way the elements are connected to the face is consistent "
"with their relative normals or integrated volumes. (This may detect folds or"
" otherwise overlapping elements.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:31
msgid ""
":ref:`mcheck` verifies that the element exterior faces form simply-connected"
" closed surfaces. (This may detect unintended cracks in a mesh.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:34
msgid ""
":ref:`mcheck` warns if the number of element facets in a 2D loop or 3D shell"
" is not greater than a computed limit. This limit is the smaller of either "
"three times the number of faces on one element, or one-tenth the total "
"number of element faces in the model. (This may detect holes in the middle "
"of a mesh.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:39
msgid ""
"The :ref:`mcheck` command will perform a number of validity checks on the "
"selected elements, including: **Normal check:** Wherever two area elements "
"share a common edge, :ref:`mcheck` verifies that the ordering of the nodes "
"on each element is consistent with their relative normals."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:44
msgid ""
"**Volume check:** Wherever two volume elements share a common face, "
":ref:`mcheck` verifies that the sign of the integrated volume of each "
"element is consistent."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:47
msgid ""
"**Closed surface check:**  :ref:`mcheck` verifies that the element exterior "
"faces form simply- connected closed surfaces (this may detect unintended "
"cracks in a mesh)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mcheck:50
msgid ""
"**Check for holes in the mesh:**  :ref:`mcheck` warns if the number of "
"element faces surrounding an interior void in the mesh is small enough to "
"suggest one or more accidentally omitted elements, rather than a "
"deliberately formed hole. For this test, the number of faces around the void"
" is compared to the smaller of a) three times the number of faces on one "
"element, or b) one-tenth the total number of element faces in the model."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.modmsh"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:2
msgid "Controls the relationship of the solid model and the FE model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:4
msgid ""
"Mechanical APDL Command: `MODMSH "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_MODMSH.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:9
msgid "Relationship key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:11
msgid ""
"``STAT`` - Gives status of command (default). This applies only to the CHECK"
" option (no status is provided for the DETACH option)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:14
msgid ""
"``NOCHECK`` - Deactivates the checking of the solid model and the finite "
"element model. Allows elements and nodes generated with the mesh commands to"
" be modified directly ( :ref:`emodif`, :ref:`nmodif`, :ref:`edele`, "
":ref:`ndele`, etc.). Also deactivates solid model hierarchical checking so "
"that areas attached to volumes may be deleted etc."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:19
msgid "``CHECK`` - Reactivates future checking of the solid model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:21
msgid ""
"``DETACH`` - Releases all associativity between the current solid model and "
"finite element model. Mechanical APDL deletes any element attributes that "
"were assigned to the affected solid model entities through default "
"attributes (that is, through the :ref:`type`, :ref:`real`, :ref:`mat`, "
":ref:`secnum`, and :ref:`esys` command settings and a subsequent meshing "
"operation). However, attributes that were assigned directly to the solid "
"model entities (via the :ref:`katt`, :ref:`latt`, :ref:`aatt`, and "
":ref:`vatt` commands) are not deleted."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:42
msgid ""
"Affects the relationship of the solid model (keypoints, lines, areas, "
"volumes) and the finite element model (nodes, elements, and boundary "
"conditions)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:45
msgid ""
"Specify ``Lab`` = NOCHECK carefully. By deactivating checking, the solid "
"model database can be corrupted by subsequent operations."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.modmsh:48
msgid ""
"After specifying ``Lab`` = DETACH, it is no longer possible to select or "
"define finite element model items in terms of the detached solid model or to"
" clear the mesh."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.mopt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:2
msgid "Specifies meshing options."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:4
msgid ""
"Mechanical APDL Command: `MOPT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_MOPT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:9
msgid "Meshing option to be specified (determines the meaning of ``Value`` ):"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:11
msgid ""
"``AORDER`` - Mesh by ascending area size order. Set ``Value`` to ON to mesh "
"smaller areas first. Using this results in finer meshes in critical areas "
"for volume meshes; this can be used for cases where :ref:`smrtsize` does not"
" mesh as needed. Default is OFF."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:15
msgid ""
"``EXPND`` - Area mesh expansion (or contraction) option. (This option is the"
" same as :ref:`smrtsize`,,,EXPND.) This option is used to size internal "
"elements in an area based on the size of the elements on the area's "
"boundaries."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:19
msgid ""
"``Value`` is the expansion (or contraction) factor. For example, issuing "
":ref:`mopt`,EXPND,2 before meshing an area will allow a mesh with elements "
"that are approximately twice as large in the interior of an area as they are"
" on the boundary. If ``Value`` is less than 1, a mesh with smaller elements "
"on the interior of the area will be allowed. ``Value`` for this option "
"should be greater than 0.5 but less than 4."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:25
msgid ""
"``Value`` defaults to 1, which does not allow expansion or contraction of "
"internal element sizes (except when using :ref:`aesize` sizing). If "
"``Value`` = 0, the default value of 1 will be used. The actual size of the "
"internal elements will also depend on the TRANS option (or upon "
":ref:`aesize` or :ref:`esize` sizing, if used)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:30
msgid ""
"``TETEXPND`` - Tet-mesh expansion (or contraction) option. This option is "
"used to size internal elements in a volume based on the size of the elements"
" on the volume's boundaries."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:33
msgid ""
"``Value`` is the expansion (or contraction) factor. For example, issuing "
":ref:`mopt`,TETEXPND,2 before meshing a volume will allow a mesh with "
"elements that are approximately twice as large in the interior of the volume"
" as they are on the boundary. If ``Value`` is less than 1, a mesh with "
"smaller elements on the interior of the volume will be allowed. ``Value`` "
"for this option should be greater than 0.1 but less than 3."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:39
msgid ""
"``Value`` defaults to 1, which does not allow expansion or contraction of "
"internal element sizes. If ``Value`` = 0, the default value of 1 will be "
"used. If ``Value`` is greater than 2, mesher robustness may be affected."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:43
msgid ""
"The TETEXPND option is supported for both the :ref:`vmesh` and :ref:`fvmesh`"
" commands. Tet-mesh expansion is the only mesh control supported by "
":ref:`fvmesh`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:46
msgid ""
"``TRANS`` - Mesh-transition option. Controls how rapidly elements are "
"permitted to change in size from the boundary to the interior of an area. "
"(This option performs the same operation as :ref:`smrtsize`,,,,TRANS.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:50
msgid ""
"``Value`` is the transitioning factor. ``Value`` defaults to 2.0, which "
"permits elements to approximately double in size as they approach the "
"interior of the area. (If ``Value`` = 0, the default value of 2 will be "
"used.) ``Value`` must be greater than 1 and, for best results, should be "
"less than 4. The actual size of the internal elements will also depend on "
"the EXPND option (or upon :ref:`aesize` or :ref:`esize` sizing, if used)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:56
msgid ""
"For a quad mesh with any element size, this option has no effect, as the "
"program strictly respects any face size to ensure the most uniform quad mesh"
" possible. To obtain a graded mesh using this option, apply :ref:`lesize` to"
" the lines of the desired face."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:60
msgid ""
"``AMESH`` - Triangle surface-meshing option. Valid inputs for ``Value`` are:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:62
msgid ""
"``DEFAULT`` - Allows the program to choose which triangle mesher to use. In "
"most cases, the program chooses the main triangle mesher, which is the "
"Riemann space mesher. If the chosen mesher fails for any reason, the program"
" invokes the alternate mesher and retries the meshing operation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:66
msgid ""
"``MAIN`` - The program uses the main triangle mesher (Riemann space mesher),"
" and it does not invoke an alternate mesher if the main mesher fails. The "
"Riemann space mesher is well suited for most surfaces."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:70
msgid ""
"``ALTERNATE`` - The program uses the first alternate triangle mesher (3D "
"tri-mesher), and it does not invoke another mesher if this mesher fails. "
"This option is not recommended due to speed considerations. However, for "
"surfaces with degeneracies in parametric space, this mesher often provides "
"the best results."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:75
msgid ""
"``ALT2`` - The program uses the second alternate triangle mesher (2D "
"parametric space mesher), and it does not invoke another mesher if this "
"mesher fails. This option is not recommended for use on surfaces with "
"degeneracies (spheres, cones, etc.) or poorly parameterized surfaces because"
" poor meshes may result."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:80
msgid ""
"``QMESH`` - Quadrilateral surface meshing option. (Quadrilateral surface "
"meshes will differ based on which triangle surface mesher is selected. This "
"is true because all free quadrilateral meshing algorithms use a triangle "
"mesh as a starting point.) Valid inputs for ``Value`` are:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:84
msgid ""
"``DEFAULT`` - Let the program choose which quadrilateral mesher to use. In "
"most cases, the program will choose the main quadrilateral mesher, which is "
"the Q-Morph (quad-morphing) mesher. For very coarse meshes, the program may "
"choose the alternate quadrilateral mesher instead. In most cases, the "
"Q-Morph mesher results in higher quality elements. If either mesher fails "
"for any reason, the program invokes the other mesher and retries the meshing"
" operation. (Default.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:90
msgid ""
"``MAIN`` - The program uses the main quadrilateral mesher (Q-Morph mesher), "
"and it does not invoke the alternate mesher if the main mesher fails."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:93
msgid ""
"``ALTERNATE`` - The program uses the alternate quadrilateral mesher, and it "
"does not invoke the Q-Morph mesher if the alternate mesher fails. To use the"
" alternate quadrilateral mesher, you must also select "
":ref:`mopt`,AMESH,ALTERNATE or :ref:`mopt`,AMESH,ALT2."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:97
msgid ""
"``VMESH`` - Tetrahedral element meshing option. Valid inputs for ``Value`` "
"are:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:99
msgid "``DEFAULT`` - Let the program choose which tetrahedra mesher to use."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:101
msgid ""
"``MAIN`` - Use the main tetrahedra mesher (Delaunay technique mesher). "
"(GHS3D meshing technology by P. L. George, INRIA, France.) For most models, "
"this mesher is significantly faster than the alternate mesher."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:105
msgid ""
"``ALTERNATE`` - Use the alternate tetrahedra mesher (advancing front "
"mesher). This mesher does not support the generation of a tetrahedral volume"
" mesh from facets ( :ref:`fvmesh` ). If this mesher is selected and you "
"issue the :ref:`fvmesh` command, the program uses the main tetrahedra mesher"
" to create the mesh from facets and issues a warning message to notify you."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:110
msgid ""
"``SPLIT`` - Quad splitting option for non-mapped meshing. If ``Value`` = 1, "
"ON, or ERR, quadrilateral elements in violation of shape error limits are "
"split into triangles (default). If ``Value`` = 2 or WARN, quadrilateral "
"elements in violation of either shape error or warning limits are split into"
" triangles. If ``Value`` = OFF, splitting does not occur, regardless of "
"element quality."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:116
msgid ""
"``LSMO`` - Line smoothing option. ``Value`` can be ON or OFF. If ``Value`` ="
" ON, smoothing of nodes on area boundaries is performed during smoothing "
"step of meshing. During smoothing, node locations are adjusted to achieve a "
"better mesh. If ``Value`` = OFF (default), no smoothing takes place at area "
"boundaries."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:121
msgid ""
"``CLEAR`` - This option affects the element and node numbering after "
"clearing a mesh. If ``Value`` = ON (default), the starting node and element "
"numbers will be the lowest available number after the nodes and elements are"
" cleared. If ``Value`` = OFF, the starting node and element numbers are not "
"reset after the clear operation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:126
msgid ""
"``PYRA`` - Transitional pyramid elements option. ``Value`` can be ON or OFF."
" If ``Value`` = ON (default), the program automatically creates transitional"
" pyramid elements, when possible. Pyramids may be created at the interface "
"of tetrahedral and hexahedral elements, or directly from quadrilateral "
"elements. For pyramids to be created, you must also issue the command "
":ref:`mshape`,1,3D (degenerate 3D elements). If ``Value`` = OFF, the program"
" does not create transitional pyramid elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:133
msgid ""
"``TIMP`` - Identifies the level of tetrahedra improvement to be performed "
"when the next free volume meshing operation is initiated ( :ref:`vmesh`, "
":ref:`fvmesh` ). (For levels 2-5, improvement occurs primarily through the "
"use of face swapping and node smoothing techniques.) Valid inputs for "
"``Value`` are:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:136
msgid ""
"``0`` - Turn off tetrahedra improvement. Although this value can lead to "
"faster tetrahedral mesh creation, it is not recommended because it often "
"leads to poorly shaped elements and mesh failures."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:139
msgid ""
"``1`` - Do the minimal amount of tetrahedra improvement. (Default.) This "
"option is supported by the main tetrahedra mesher only ( "
":ref:`mopt`,VMESH,MAIN). If the alternate tetrahedra mesher ( "
":ref:`mopt`,VMESH,ALTERNATE) is invoked with this setting, the program "
"automatically performs tetrahedra improvement at level 3 instead ( "
":ref:`mopt`,TIMP,3)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:144
msgid ""
"``2`` - Perform the least amount of swapping/smoothing. No improvement "
"occurs if all tetrahedral elements are within acceptable limits."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:147
msgid ""
"``3`` - Perform an intermediate amount of swapping/smoothing. Some "
"improvement is always done."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:149
msgid ""
"``4`` - Perform the greatest amount of swapping/smoothing. Meshing takes "
"longer with this level of improvement, but usually results in a better mesh."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:152
msgid ""
"``5`` - Perform the greatest amount of swapping/smoothing, plus additional "
"improvement techniques. This level of improvement usually produces results "
"that are similar to those at level 4, except for very poor meshes."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:156
msgid ""
"``6`` - For linear tetrahedral meshes, this value provides the same level of"
" improvement as :ref:`mopt`,TIMP,5. For quadratic tetrahedral meshes, this "
"value provides an additional pass of cleanup. This value is supported for "
"both the main ( :ref:`mopt`,VMESH,MAIN) and alternate ( "
":ref:`mopt`,VMESH,ALTERNATE) tetrahedra meshers."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:161
msgid ""
"``STAT`` - Display status of :ref:`mopt` settings. ``Value`` is ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:163
msgid ""
"``DEFA`` - Set all :ref:`mopt` options to default values. ``Value`` is "
"ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:166
msgid "Value, as described for each different ``Lab`` above."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mopt:182
msgid ""
"See the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_"
" for more information on the :ref:`mopt` command and its options."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.meshing.Meshing.mshape"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/meshing.rst:74:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:2
msgid ""
"For elements that support multiple shapes, specifies the element shape to be"
" used for meshing."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:4
msgid ""
"Mechanical APDL Command: `MSHAPE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_MSHAPE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:9
msgid "Key indicating the element shape to be used:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:11
msgid ""
"``0`` - Mesh with quadrilateral-shaped elements when ``Dimension`` = 2D mesh"
" with hexahedral- shaped elements when ``Dimension`` = 3D."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:14
msgid ""
"``1`` - Mesh with triangle-shaped elements when ``Dimension`` = 2D mesh with"
" tetrahedral-shaped elements when ``Dimension`` = 3D."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:17
msgid "**dimension** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:18
msgid "Specifies the dimension of the model to be meshed:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:20
msgid "``2D`` - 2D model (area mesh)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:22
msgid "``3D`` - 3D model (volume mesh)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshape:38
msgid ""
"If no value is specified for ``Dimension`` the value of ``KEY`` determines "
"the element shape that will be used for both 2D and 3D meshing. In other "
"words, if you specify :ref:`mshape`,0, quadrilateral-shaped and hexahedral-"
"shaped elements will be used. If you specify :ref:`mshape`,1, triangle-"
"shaped and tetrahedral-shaped elements will be used."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy.rst:2
