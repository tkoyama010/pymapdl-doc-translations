msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/session/files.rst:30:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:2
