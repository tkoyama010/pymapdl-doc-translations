#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.contour:10
msgid ""
"Nine contour values uniformly spaced between the extreme values, or no "
"contours if the ratio of range to minimum value (or range to maximum if "
"minimum = 0) is less than 0.001."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.contour:18
