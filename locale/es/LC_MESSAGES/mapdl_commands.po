#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.nlist:23
msgid ""
"List nodes from ``NODE1`` to ``NODE2`` (defaults to ``NODE1`` ) in steps of "
"``NINC`` (defaults to 1). If ``NODE1`` = ALL (default), ``NODE2`` and "
"``NINC`` are ignored and all selected nodes ( :ref:`nsel` ) are listed. If "
"``NODE1`` = P, graphical picking is enabled and all remaining command fields"
" are ignored (valid only in the GUI). A component name may also be "
"substituted for ``NODE1`` ( ``NODE2`` and ``NINC`` are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.nlist:29
msgid "**lcoord** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
