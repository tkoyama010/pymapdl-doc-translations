"Mechanical APDL Command: `CYCFILES "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_CYCFILES.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycfiles:11
msgid ""
"No defaults are available for the :ref:`cycfiles` command. You must issue "
"this command to properly postprocess the results of a cyclic symmetry mode-"
"superposition harmonic analysis. If issued with no arguments, the "
"postprocessing will be done using :file:`Jobname.rst` and "
":file:`Jobname.rfrq` from the current working directory."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycfiles:18
msgid "**fnamerst** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycfiles:19
msgid ""
"The file name and directory path of the results file from the cyclic modal "
"solution. Defaults to :file:`Jobname`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycfiles:22
msgid "**extrst** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycfiles:23
msgid "File name extension for ``FnameRst``. Defaults to :file:`rst`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycfiles:25
msgid "**fnamerfrq** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
