" 5. The default value is 1. The window number applies only to the AMOUNT "
"argument."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cycexpand:13
