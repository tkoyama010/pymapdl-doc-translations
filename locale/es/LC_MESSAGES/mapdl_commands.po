"``2`` - Like 1 except with antisymmetric boundary conditions (K:sub:`I` = "
"0)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/_special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1._special_purpose.SpecialPurpose.kcalc:26
msgid ""
