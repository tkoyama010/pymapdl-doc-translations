#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:184
msgid ""
"``EINT`` - Gauss integration point (defaults to ALL). Not valid for "
"material-based initial-state data ( ``Val1`` = MAT) or node-based initial "
"state ( ``Val2`` = NODE)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
