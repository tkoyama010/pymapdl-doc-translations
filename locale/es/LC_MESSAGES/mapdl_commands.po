msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:236
msgid "**Command Specifications for Action= CENC**"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:240
msgid ""
"``Par1`` - Crack-extension node component name ( :ref:`cm` ). (Must be 32 "
"characters or less.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:242
msgid ""
"``Par2`` - Crack-tip node. The crack-tip node defaults to the first node of "
"the crack-extension node component."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:245
msgid ""
"``Par3, Par4`` - Coordinate system number ( ``Par3`` ) and the number of the"
" axis that is coincident with the crack direction ( ``Par4`` ). When these "
"parameters are defined, ``Par5``, ``Par6`` and ``Par7`` are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:249
msgid ""
"``Par5, Par6, Par7`` - Global x, y, and z components of the crack-extension "
"direction vector. ( ``Par3`` and ``Par4`` must be blank.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:252
msgid "**Command Specifications for Action= TYPE**"
