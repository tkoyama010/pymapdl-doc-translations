msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:2
msgid "Generates circular lines by rotating a keypoint pattern about an axis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:4
msgid ""
"Mechanical APDL Command: `LROTAT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LROTAT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:15
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:21
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:27
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:33
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:39
msgid ""
"List of keypoints in the pattern to be rotated (6 maximum if using keyboard "
"entry). If ``NK1`` = P, graphical picking is enabled and all remaining "
"command fields are ignored (valid only in the GUI). If ``NK1`` = ALL, all "
"selected keypoints (except ``PAX1`` and ``PAX2`` ) will define the pattern "
"to be rotated. A component name may also be substituted for ``NK1``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:45
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:48
msgid ""
"Keypoints defining the axis about which the keypoint pattern is to be "
"rotated."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:51
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/volumes.pydocstring of
#: ansys.mapdl.core._commands.prep7.volumes.Volumes.vrotat:57
msgid ""
"Arc length (in degrees). Positive follows right-hand rule about ``PAX1`` - "
"``PAX2`` vector. Defaults to 360."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:55
msgid ""
"Number of lines (8 maximum) around circumference. Defaults to minimum "
"required for 90° (maximum) arcs, that is, 4 for 360°, 3 for 270°, etc."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lrotat:72
msgid ""
"Generates circular lines (and their corresponding keypoints) by rotating a "
"keypoint pattern about an axis. Keypoint patterns are generated at regular "
"angular locations (based on a maximum spacing of 90°). Line patterns are "
"generated at the keypoint patterns. Keypoint and line numbers are "
"automatically assigned (beginning with the lowest available values ( "
":ref:`numstr` ))."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lsscale.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lsscale"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:2
msgid "Generates a scaled set of lines from a pattern of lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:4
msgid ""
"Mechanical APDL Command: `LSSCALE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LSSCALE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:16
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:23
msgid ""
"Set of lines ( ``NL1`` to ``NL2`` in steps of ``NINC`` ) that defines the "
"pattern to be scaled. ``NL2`` defaults to ``NL1``, ``NINC`` defaults to 1. "
"If ``NL1`` = ALL, ``NL2`` and ``NINC`` are ignored and the pattern is "
"defined by all selected lines. If ``NL1`` = P, graphical picking is enabled "
"and all remaining command fields are ignored (valid only in the GUI). A "
"component name may also be substituted for ``NL1`` ( ``NL2`` and ``NINC`` "
"are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:30
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:38
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:46
msgid ""
"Scale factors to be applied to the X, Y, Z keypoint coordinates in active "
"coordinate system ( RR, R θ, RZ for cylindrical; RR, R θ, R Φ for "
"spherical). Note that the R θ and R Φ scale factors are interpreted as "
"angular offsets. For example, for :ref:`csys`,1, RR, R θ, RZ input of "
"(1.5,10,3) would scale the specified keypoints 1.5 times in the radial and 3"
" times in the Z direction, while adding an offset of 10 degrees to the "
"keypoints. Zero, blank, or negative scale factor values are assumed to be "
"1.0. Zero or blank angular offsets have no effect."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:60
msgid ""
"``0`` - Nodes and line elements associated with the original lines will be "
"generated (scaled) if they exist."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:63
msgid "``1`` - Nodes and line elements will not be generated."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:66
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:46
msgid "Specifies whether lines will be moved or newly defined:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:68
msgid "``0`` - Additional lines will be generated."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:70
msgid ""
"``1`` - Original lines will be moved to new position ( ``KINC`` and "
"``NOELEM`` are ignored). Use only if the old lines are no longer needed at "
"their original positions. Corresponding meshed items are also moved if not "
"needed at their original position."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:88
msgid ""
"This command generates a scaled set of lines (and their corresponding "
"keypoints and mesh) from a pattern of lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:91
msgid ""
"The MAT, TYPE, REAL, and ESYS attributes are based on the lines in the "
"pattern and not the current settings."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsscale:94
msgid ""
"Scaling occurs in the active coordinate system. Lines in the pattern could "
"have been generated in any coordinate system."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lstr.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lstr"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lstr:2
msgid "Defines a straight line irrespective of the active coordinate system."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lstr:4
msgid ""
"Mechanical APDL Command: `LSTR "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LSTR.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lstr:9
msgid ""
"Keypoint at the beginning of line. If ``P1`` = P, graphical picking is "
"enabled and all remaining command fields are ignored (valid only in the GUI)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lstr:33
msgid ""
"Defines a straight line from ``P1`` to ``P2`` using the global Cartesian "
"coordinate system. The active coordinate system will be ignored. The line "
"shape is invariant with the coordinate system after it is generated. Lines "
"may be redefined only if not yet attached to an area."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lstr:40
msgid ""
"Create a cartesian straight line regardless of the coordinate system being "
"in cylindrical."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lsum.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lsum"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsum:2
msgid "Calculates and prints geometry statistics of the selected lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsum:4
msgid ""
"Mechanical APDL Command: `LSUM "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LSUM.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsum:21
msgid ""
"Calculates and prints geometry statistics (length, centroid, moments of "
"inertia, etc.) associated with the selected lines. Geometry items are "
"reported in the global Cartesian coordinate system. A unit density is "
"assumed, irrespective of any material associations ( :ref:`latt`, :ref:`mat`"
" ). Items calculated by :ref:`lsum` and later retrieved by a :ref:`get` or "
":ref:`starvget` command are valid only if the model is not modified after "
"the :ref:`lsum` command is issued."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lsymm.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lsymm"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:2
msgid "Generates lines from a line pattern by symmetry reflection."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:4
msgid ""
"Mechanical APDL Command: `LSYMM "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LSYMM.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:18
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:25
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:32
msgid ""
"Reflect lines from pattern beginning with ``NL1`` to ``NL2`` (defaults to "
"``NL1`` ) in steps of ``NINC`` (defaults to 1). If ``NL1`` = ALL, ``NL2`` "
"and ``NINC`` are ignored and pattern is all selected lines ( :ref:`lsel` ). "
"If ``NL1`` = P, graphical picking is enabled and all remaining command "
"fields are ignored (valid only in the GUI). A component name may also be "
"substituted for ``NL1`` ( ``NL2`` and ``NINC`` are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:52
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:48
msgid "``0`` - Generate additional lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:54
msgid ""
"``1`` - Move original lines to new position retaining the same keypoint "
"numbers ( ``KINC`` and ``NOELEM`` are ignored). Valid only if the old lines "
"are no longer needed at their original positions. Corresponding meshed items"
" are also moved if not needed at their original position."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:72
msgid ""
"Generates a reflected set of lines (and their corresponding keypoints and "
"mesh) from a given line pattern by a symmetry reflection (see analogous node"
" symmetry command, :ref:`nsym` ). The MAT, TYPE, REAL, and ESYS attributes "
"are based upon the lines in the pattern and not upon the current settings. "
"Reflection is done in the active coordinate system by changing a particular "
"coordinate sign. The active coordinate system must be Cartesian. Lines in "
"the pattern may have been generated in any coordinate system. However, solid"
" modeling in a toroidal coordinate system is not recommended. Lines are "
"generated as described in the :ref:`lgen` command."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.ltan.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.ltan"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:2
msgid "Generates a line at the end of, and tangent to, an existing line."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:4
msgid ""
"Mechanical APDL Command: `LTAN "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LTAN.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:9
msgid ""
"Number of the line the generated line is tangent to. If negative, assume "
"``P1`` (see below), instead of ``P2``, is the second keypoint of line "
"``NL1``. If ``NL1`` = P, graphical picking is enabled and all remaining "
"command fields are ignored (valid only in the GUI)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:16
msgid "**xv3** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:17
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:22
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:27
msgid ""
"Location (in the active coordinate system) of the head of the \"slope "
"vector\" corresponding to the slope at the ``P3`` end of the line. The tail "
"of the vector is at the coordinate system origin."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:21
msgid "**yv3** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:26
msgid "**zv3** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:36
msgid "Line number of the line generated."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:49
msgid ""
"This function contains specificities regarding the argument definitions. "
"Please refer to the `command documentation "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LTAN.html>`_"
" for further explanations."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:55
msgid ""
"Generates a line ( ``P2`` - ``P3`` ) tangent at end point ( ``P2`` ) of line"
" ``NL1`` ( ``P1`` - ``P2`` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltan:61
msgid ""
"Create a circular arc and generate a tangent spline at the end of it "
"directed to a new keypoint."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.ltran.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.ltran"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:2
msgid "Transfers a pattern of lines to another coordinate system."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:4
msgid ""
"Mechanical APDL Command: `LTRAN "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LTRAN.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:14
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:21
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:28
msgid ""
"Transfer lines from pattern beginning with ``NL1`` to ``NL2`` (defaults to "
"``NL1`` ) in steps of ``NINC`` (defaults to 1). If ``NL1`` = ALL, ``NL2`` "
"and ``NINC`` are ignored and pattern is all selected lines ( :ref:`lsel` ). "
"If ``NL1`` = P, graphical picking is enabled and all remaining command "
"fields are ignored (valid only in the GUI). A component name may also be "
"substituted for ``NL1`` ( ``NL2`` and ``NINC`` are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:50
msgid ""
"``1`` - Move original lines to new position retaining the same keypoint "
"numbers ( ``KINC`` and ``NOELM`` are ignored). Valid only if the old lines "
"are no longer needed at their original positions. Corresponding meshed items"
" are also moved if not needed at their original position."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:68
msgid ""
"Transfers a pattern of lines (and their corresponding keypoints and mesh) "
"from one coordinate system to another (see analogous node transfer command, "
":ref:`transfer` ). The MAT, TYPE, REAL, and ESYS attributes are based upon "
"the lines in the pattern and not upon the current settings. Coordinate "
"systems may be translated and rotated relative to each other. Initial "
"pattern may be generated in any coordinate system. However, solid modeling "
"in a toroidal coordinate system is not recommended. Coordinate and slope "
"values are interpreted in the active coordinate system and are transferred "
"directly. Lines are generated as described in the :ref:`lgen` command."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.spline.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.spline"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.spline:2
msgid "Generates a segmented spline through a series of keypoints."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.spline:4
msgid ""
"Mechanical APDL Command: `SPLINE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SPLINE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.spline:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.spline:14
