"when in PowerGraphics mode ( :ref:`graphics`,POWER)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.edge:66
msgid "The :ref:`edge` command is valid in any processor."
msgstr ""

