msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:4
msgid ""
"Mechanical APDL Command: `RESWRITE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_RESWRITE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:13
msgid "The file name extension varies as follows:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:15
msgid ":file:`.rst` for structural, fluid, or coupled-field analyses"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:16
msgid ":file:`.rth` for thermal or electrical analyses"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:17
msgid ":file:`.rmg` for magnetic analyses"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:19
msgid "**cflag** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:20
msgid ""
"``0`` - The complex results flag is set to 0 in the results file header. "
"This is the default option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:23
msgid ""
"``1`` - The complex results flag is set to 1 in the results file header."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:39
msgid ""
"The :ref:`reswrite` command appends a data set to the specified file by "
"writing the results data currently in the database. If the intended results "
"file does not exist, it will be created and will include the geometry "
"records. The current load step, substep, and time (or frequency) value are "
"maintained. All data (summable and nonsummable) are written."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:44
msgid ""
"When complex results are appended, ``cFlag`` must be set to 1 so that the "
"header is consistent with the results written on the file."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:47
msgid ""
"The command is primarily intended for use in a top-down substructuring "
"analysis, where the full model is resumed and the results data read from the"
" `use pass "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_substr/an9Auq1d6ldm.html#advobsl5jla062999>`_"
" results file ( :ref:`set` ), and subsequently from all substructure "
"`expansion pass "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_substr/axcAuq367ldm.html#adv5note4jla062999>`_"
" results files ( :ref:`append` ). The full set of data in memory can then be"
" written out via the :ref:`reswrite` command to create a complete results "
"file (as though you had run a nonsubstructured analysis)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.reswrite:56
msgid ""
"The :ref:`reswrite` command can also be used to write a global results file "
"for a distributed-memory parallel ( DMP ) solution. This should only be "
"necessary if the :ref:`rescombine` command was used to combine results from "
"local results files into the database. The :ref:`reswrite` command can then "
"be used to write the combined results into a new results file. This new "
"results file will essentially contain the current set of results data for "
"the entire (that is, global) model."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.rmflvec.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.post1.special\\_purpose.SpecialPurpose.rmflvec"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/special_purpose.rst:57:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.rmflvec:2
msgid ""
"Writes eigenvectors of fluid nodes to a file for use in damping parameter "
"extraction."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.rmflvec:4
msgid ""
"Mechanical APDL Command: `RMFLVEC "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_RMFLVEC.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.rmflvec:21
msgid ""
":ref:`rmflvec` extracts the modal information from the modal results file "
"for all nodes specified in a node component called 'FLUN'. This component "
"should include all nodes which are located at the fluid-structural "
"interface. Mode shapes, element normal orientation, and a scaling factor are"
" computed and stored in a file :file:`Jobname.EFL`. For damping parameter "
"extraction, use the :ref:`dmpext` command macro. See  for more information "
"on thin film analyses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.rmflvec:27
msgid ""
"``FLUID136`` and ``FLUID138`` are used to model the fluid interface. Both "
"the structural and fluid element types must be active. The fluid interface "
"nodes must be grouped into a component 'FLUN'. A results file of the last "
"modal analysis must be available."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.rsplit.rst:2
msgid "ansys.mapdl.core.\\_commands.post1.special\\_purpose.SpecialPurpose.rsplit"
