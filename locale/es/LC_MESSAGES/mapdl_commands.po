msgid ""
"Meshed line/area to be copied, or a component name containing a list. If "
"``LAPTRN`` = P, graphical picking is enabled (valid only in the GUI)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy:16
msgid "**lacopy** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy:17
msgid ""
"Unmeshed line/area to get copied mesh, or a component name containing a "
"list. If ``LACOPY`` = P, graphical picking is enabled (valid only in the "
"GUI)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy:21
msgid ""
"In coordinate system ``KCN``, ``LAPTRN`` + ``DX``  ``DY``  ``DZ`` = "
"``LACOPY``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy:24
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy:28
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy:32
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ngen:38
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ngen:42
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ngen:46
msgid ""
"Node location increments in the active coordinate system (DR, Dθ, DZ for "
"cylindrical, DR, Dθ, DΦ for spherical or toroidal)."
