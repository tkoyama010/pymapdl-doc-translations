msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.prmc:15
msgid ""
"As an alternative to ``LSTEP`` and ``SBSTEP``, print the solution at the "
"time value ``TIMFRQ`` (for :ref:`antype`,TRANS) or frequency value "
"``TIMFRQ`` (for :ref:`antype`,HARMIC). ``LSTEP`` and ``SBSTEP`` should be "
"left blank."
msgstr ""

