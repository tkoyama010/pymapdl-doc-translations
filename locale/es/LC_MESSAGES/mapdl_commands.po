msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.nlist:4
msgid ""
"Mechanical APDL Command: `NLIST "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NLIST.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
