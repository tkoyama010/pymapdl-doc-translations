#: of
#: ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cycexpand:38
msgid ""
"``Value1`` - The component name of the elements to expand. The default is "
"all selected components."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cycexpand:40
msgid "``EDGE`` - Sector edge display key. Possible ``Value1`` settings are:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cycexpand:42
msgid ""
"``-1`` - Suppresses display of edges between sectors even if the cyclic "
"count varies between active windows. This setting is not valid for cyclic "
"mode-superposition (MSUP) harmonic analyses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cycexpand:47
msgid ""
"Plots with fewer than the maximum number of repetitions may have missing "
"element faces at the sector boundaries."
msgstr ""

