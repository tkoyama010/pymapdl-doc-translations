#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:2
msgid "Specifies the number of substeps to be taken this load step."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:4
msgid ""
"Mechanical APDL Command: `NSUBST "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NSUBST.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:8
msgid "**nsbstp** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:9
msgid ""
"Number of substeps to be used for this load step (that is, the time step "
"size or frequency increment). If automatic time stepping is used ( "
":ref:`autots` ), ``NSBSTP`` defines the size of the first substep."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:13
msgid ""
"If contact elements ( ``TARGE169``, ``TARGE170``, ``CONTA172``, "
"``CONTA174``, ``CONTA175``, or ``CONTA177`` ) are used, defaults to 1 or 20 "
"substeps, depending on the physics of the model. If none of these contact "
"elements are used, defaults to 1 substep."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:17
msgid "**nsbmx** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:18
msgid ""
"Maximum number of substeps to be taken (that is, the minimum time step size)"
" if automatic time stepping is used. The program automatically determines "
"the default based on the physics of the model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:22
msgid "**nsbmn** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:23
msgid ""
"Minimum number of substeps to be taken (that is, the maximum time step size)"
" if automatic time stepping is used. The program automatically determines "
"the default based on the physics of the model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:28
msgid ""
"Time step carryover key (program-determined default depending on the problem"
" physics):"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:30
msgid ""
"``OFF`` - Use ``NSBSTP`` to define time step at start of each load step."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:51
msgid ""
"See :ref:`deltim` for an alternative input. It is recommended that all "
"fields of this command be specified for solution efficiency and robustness."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:54
msgid ""
"When the arc-length method is active ( :ref:`arclen` command), the ``NSBMX``"
" and ``NSBMN`` arguments are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:57
msgid ""
"Changing the number of substeps upon restarting an analysis during a load "
"step is not recommended. You should only change the number of substeps "
"between load steps."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.load\\_step\\_options.LoadStepOptions.numexp"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/load_step_options.rst:36:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:2
msgid ""
"Specifies solutions to be expanded from mode-superposition analyses or "
"substructure analyses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:4
msgid ""
"Mechanical APDL Command: `NUMEXP "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NUMEXP.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:9
msgid "The number of solutions to expand. This value is required."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:11
msgid "``Num`` - Number of solutions to expand."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:13
msgid ""
"``ALL`` - Expand all substeps between ``BEGRNG`` and ``ENDRNG`` (provided "
"that ``ENDRNG`` > 0). If ``BEGRNG`` and ``ENDRNG`` have no specified values,"
" this option expands all substeps of all load steps."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:17
msgid "**begrng** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:18
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:22
msgid ""
"Beginning and ending time (or frequency) range for expanded solutions. The "
"default is 0 for both values."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:21
msgid "**endrng** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:26
msgid "The element-calculation key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:28
msgid ""
"``YES`` - Calculate element results, nodal loads, and reaction loads. This "
"value is the default."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:44
msgid "**Command Defaults**"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:48
msgid ""
"Issuing this command with no arguments is invalid. You must specify the "
"number of solutions, or all solutions, to expand ( ``NUM`` ). The default "
"value for both the beginning ( ``BEGRNG`` ) and ending ( ``ENDRNG`` ) time "
"or frequency is 0. The default behavior of the command is to calculate "
"element results, nodal loads, and reaction loads ( ``Elcalc`` = YES)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:55
msgid ""
"Specifies a range of solutions to be expanded from analyses that use mode-"
"superposition methods ( :ref:`antype`,HARMIC or TRANS) or substructuring ( "
":ref:`antype`,SUBSTR)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:58
msgid ""
"For :ref:`antype`,TRANS, ``NUM``, evenly spaced solutions are expanded "
"between time ``BEGRNG`` and time ``ENDRNG``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:61
msgid ""
"For :ref:`antype`,HARMIC, ``NUM``, evenly spaced solutions are expanded "
"between frequency ``BEGRNG`` and frequency ``ENDRNG``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:64
msgid ""
"The first expansion in all cases is done at the first point beyond "
"``BEGRNG`` (that is, at ``BEGRNG`` + ( ``ENDRNG`` - ``BEGRNG`` ) / ``NUM`` "
"))."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:67
msgid ""
"The resulting results file will maintain the same load step, substep, and "
"time (or frequency) values as the use pass."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:70
msgid ""
"For a single expansion of a solution, or for multiple expansions when the "
"solutions are not evenly spaced (such as in a mode-superposition harmonic "
"analysis with the cluster option), Ansys, Inc. recommends issuing one or "
"more :ref:`expsol` commands."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:74
msgid ":ref:`numexp` is invalid in these cases:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:76
msgid ""
"In a substructing analysis ( :ref:`antype`, ``SUBST`` ) when a factorized "
"matrix file (the :file:`.LN22` file generated by the sparse solver) does not"
" exist, causing Mechanical APDL to use the full- resolve method."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:80
msgid "If the full-resolve option is selected ( :ref:`seopt` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.numexp:82
msgid ""
"In both situations, issue :ref:`expsol` to perform a single expansion for "
"each solution desired."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.load\\_step\\_options.LoadStepOptions.time"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/load_step_options.rst:36:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time:2
msgid "Sets the time for a load step."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time:4
msgid ""
"Mechanical APDL Command: `TIME "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TIME.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time:9
msgid "Time at the end of the load step."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time:25
msgid ""
"Associates the boundary conditions at the end of the load step with a "
"particular ``TIME`` value."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time:27
msgid ""
"``TIME`` must be a positive, nonzero, monotonically increasing quantity that"
" \"tracks\" the input history. Units of time should be consistent with those"
" used elsewhere (for properties, creep equations, etc.)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time:31
msgid ""
"Typically, for the first load step ``TIME`` defaults to 1. However, for the "
"first load step of a mode-superposition transient analysis ( "
":ref:`antype`,TRANS and  :ref:`trnopt`,MSUP), the :ref:`time` command is "
"ignored and a static solution is performed at ``TIME`` = 0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time:35
msgid ""
"For a full transient analyses, the command's default behavior does not "
"apply. You must specify a time for each load step and it must be greater "
"than the time at the end of the prior load step."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.time:38
msgid ""
"``TIME`` does not apply to modal ( :ref:`antype`,MODAL), harmonic ( "
":ref:`antype`,HARMIC), or substructure ( :ref:`antype`,SUBSTR) analyses."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.tref.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.load\\_step\\_options.LoadStepOptions.tref"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/load_step_options.rst:36:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.tref:2
msgid "Defines the reference temperature for thermal strain calculations."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.tref:4
msgid ""
"Mechanical APDL Command: `TREF "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TREF.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.tref:8
msgid "**tref** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.tref:9
msgid "Reference temperature for thermal expansion."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.tref:11
msgid ""
"If the uniform temperature ( :ref:`tunif` ) is not specified, it is also set"
" to this value."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.tref:27
msgid ""
"Defines the reference temperature for the thermal strain calculations in "
"structural analyses. Thermal strains are given by α * (T - TREF), where α is"
" the coefficient of thermal expansion. Input the strain via ALPX, ALPY, ALPZ"
" (the secant or mean coefficient value), or CTEX, CTEY, CTEZ (the "
"instantaneous coefficient value), or the thermal strain value (THSX, THSY, "
"THSZ). T is the element temperature. If α is temperature-dependent, ``TREF``"
" should be in the range of temperatures you define using the :ref:`mptemp` "
"command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.tref:34
msgid ""
"Reference temperatures may also be input per material by specifying a value "
