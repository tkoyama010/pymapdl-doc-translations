msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:85
msgid ""
"``3`` - Infinite norm (check each degree of freedom separately). The "
"reference is calculated using the infinite norm of the displacement "
"increment of the substep. Valid only for ``Lab`` = U."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:88
