msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:4
msgid ""
"Mechanical APDL Command: `/ANGLE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_ANGLE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:12
msgid ""
"Angle (degrees) for changing display orientation (positive, counterclockwise"
" about specified axis)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:16
msgid ""
"Rotation axis: XS, YS, or ZS (default) for the screen axes; XM, YM, or ZM "
"for the global Cartesian model axes. ZS is normal to the screen; all axes "
"pass through the focus point."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:19
msgid "**kincr** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:20
msgid "Cumulative rotation key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:22
msgid "``0`` - Do not use cumulative successive rotations."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:24
msgid ""
"``1`` - Use cumulative rotations. Rotations are relative to the previous "
"rotation. View settings ( :ref:`view` ) are recalculated."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:41
msgid ""
"Default orientation is YS vertical. When the :ref:`xfrm` command is set for "
"rotation about two points, or for entities, the :ref:`angle` command is "
"functional only for ``Axis`` = ZS or ZM and ``KINCR`` = 1."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.auto.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.auto"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.auto:2
msgid ""
"Resets the focus and distance specifications to \"automatically "
"calculated.\""
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.auto:4
msgid ""
"Mechanical APDL Command: `/AUTO "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_AUTO.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.auto:25
msgid ""
"Focus point and distance will be automatically calculated during next "
"display. Settings may still be changed with the :ref:`focus` and :ref:`dist`"
" commands after this command has been issued. See also the :ref:`user` "
"command."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.dist.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.dist"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:2
msgid "Specifies the viewing distance for magnifications and perspective."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:4
msgid ""
"Mechanical APDL Command: `/DIST "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_DIST.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:10
msgid ""
"Distance is automatically calculated to produce full window magnification."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:17
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/operations.pydocstring
#: of ansys.mapdl.core._commands.post26.operations.Operations.filldata:24
msgid "**dval** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:18
msgid ""
"Distance along the view line from the observer to the focus point (defaults "
"to value producing full- window display). Distances \"too close\" to the "
"object will produce excessive magnifications. If ``DVAL`` = AUTO, zero, or "
"blank, the program will calculate the distance automatically. If ``DVAL`` = "
"USER, the distance of last display will be used (useful when last display "
"automatically calculated distance)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:24
msgid "**kfact** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:25
msgid "``DVAL`` interpretation key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:27
msgid "``0`` - Interpret numerical ``DVAL`` values as described above."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:29
msgid ""
"``1`` - Interpret ``DVAL`` as a multiplier on the current distance ( "
"``DVAL`` of 2 gives twice the current distance; 0.5 gives half the current "
"distance, etc.)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.dist:46
msgid ""
"The scale factor is relative to the window shape. For example, for objects "
"centered in a square window and with parallel projection (no perspective), a"
" distance of :math:`equation not available` /2 (+10%) producesa full window "
"magnification, where   :math:`equation not available`  isthe largest in-"
"plane vertical or horizontal dimension.  See also  :ref:`auto` and "
":ref:`user` commands."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.focus.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.focus"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:2
msgid "Specifies the focus point (center of the window)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:4
msgid ""
"Mechanical APDL Command: `/FOCUS "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_FOCUS.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:11
msgid "**xf** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:12
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:17
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:22
msgid ""
"Location of the object to be at the focus point (center of the window) in "
"the global Cartesian coordinate system. If ``XF`` = AUTO, allow automatic "
"location calculation. If ``XF`` = USER, use focus location of last display "
"(useful when last display had auto focus)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:16
msgid "**yf** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:21
msgid "**zf** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:26
msgid "**ktrans** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:27
msgid "Translate key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:29
msgid ""
"``0`` - Interpret numerical ``XF``, ``YF``, ``ZF`` values as described "
"above."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:31
msgid ""
"``1`` - Interpret ``XF``, ``YF``, ``ZF`` values as multiples of half-screens"
" to translate from the current position in the screen coordinate system. "
"Example: ``XF`` of 2.4 translates the display approximately 2.4 half-screens"
" to the left in the screen X (horizontal) direction."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:35
msgid ""
"``2`` - Interpret ``XF``, ``YF``, ``ZF`` values as multiples of half-screens"
" to translate from the current position in the global Cartesian coordinate "
"system. Example: ``XF`` of 1.5 translates the display approximately 1.5 "
"half-screens in the global Cartesian X direction of the model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.focus:53
msgid ""
"Specifies the location on (or off) the model which is to be located at the "
"focus point (center of the window). For section and capped displays, the "
"cutting plane is also assumed to pass through this location (unless the "
"working plane is used via :ref:`cplane` ). See also :ref:`auto` and "
":ref:`user` commands."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.user.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.user"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.user:2
msgid "Conveniently resets :ref:`focus` and :ref:`dist` to USER."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.user:4
msgid ""
"Mechanical APDL Command: `/USER "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_USER.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.user:25
msgid ""
"Conveniently resets scale parameters to USER on the :ref:`focus` and "
":ref:`dist` commands. Scale parameters will be internally respecified to "
"those used for the last display. Convenient when the last scale parameters "
"were automatically calculated. User specified parameters hold until changed "
"or removed ( :ref:`auto` ). Parameters may be reset on the individual "
"commands after this command has been issued."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.vcone.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.vcone"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vcone:2
msgid "Defines the view cone angle for perspective displays."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vcone:4
msgid ""
"Mechanical APDL Command: `/VCONE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_VCONE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vcone:11
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.xfdata:20
msgid "**phi** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vcone:12
msgid ""
"View cone angle (0.0 to 85.°) to define perspective. Use ``PHI`` = 45.0° for"
" typical perspective. Increase angle for more perspective, decrease angle "
"for less. If the distance ( :ref:`dist` ) is not specified, it will be "
"automatically calculated to give full window magnification. If the distance "
"is also specified, ``PHI`` controls both the perspective and the "
"magnification. The larger the angle, the more the perspective and the less "
"the magnification. Defaults to 0.0 (no perspective)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vcone:33
msgid ""
"Perspective shows the true depth of the object in the display. A variable "
"magnification results since the back plane of the object is further from the"
" observer than the front plane. The largest magnification occurs at the "
"front plane. With perspective, the magnification factor (MAGF) is not only a"
" function of the distance from the object, but also the window shape and the"
" perspective (or view cone) angle Φ as follows:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vcone:43
msgid ""
"where :math:`equation not available`, for square windows, is thelargest in-"
"plane vertical or horizontal dimension, d is the distance fromthe observer "
"to the plane of  :math:`equation not available`  (usuallythe front plane of "
"the object), and :math:`\\Phi` is the view cone angle (definedwith the  "
":ref:`vcone` command). The bigger the cone angle, the more the perspective. "
"The magnification factor proportionally decreases with increasing Φ. The "
"distance can be defined with the :ref:`dist` or the :ref:`focus` command. "
"Note, the distance input on the :ref:`dist` command is equal to d only if "
"the focus point is located on the plane of :math:`equation not available`.  "
"It is recommended that if a general perspective is desired(that is, not any "
"specific cone angle), use :math:`\\Phi` = 45.0 (since TAN(45.0) = 1.0)and "
"let the d value be automatically calculated for full window magnification."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vcone:55
msgid ""
"Note that any number of :ref:`dist`, :ref:`focus`, and :ref:`vcone` "
"combinations can be used to produce the same magnification. Distances less "
"than the object depth will produce views from within the object."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vcone:59
msgid ""
"A magnification factor of 1.0 just fills the window. If the automatic "
"scaling option is used ( :ref:`auto` ), the magnification factor is fixed at"
" 0.91 (to allow a 10% margin around the object) and d is automatically "
"calculated for the given :ref:`vcone` and :ref:`focus` values. Any value of "
"Φ between 0.0 and 85.0 (usually 45.0) may be used to activate the "
"perspective. Views from inside the object are not possible when d is "
"automatically calculated (use manual scaling ( :ref:`user` ) along with "
":ref:`dist` specification)."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.view.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.view"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.view:2
msgid "Defines the viewing direction for the display."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.view:4
msgid ""
"Mechanical APDL Command: `/VIEW "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_VIEW.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.view:12
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.view:18
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.view:24
msgid ""
"The object is viewed along the line from point ``XV``, ``YV``, ``ZV`` (in "
"the global coordinate system) to the global coordinate system origin. For "
"section displays, the cutting plane is assumed to be perpendicular to this "
"line. If ``XV`` = WP, modify view to be normal to the currently defined "
"working plane. Defaults to (0,0,1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.view:43
msgid ""
"The view line is always normal to the screen. The view is selected by "
"defining a point (in the global Cartesian coordinate system) representing a "
"point along the viewing line. This point, and the global Cartesian "
"coordinate system origin, define the line along which the object is viewed "
"while looking toward the origin. Any point along the view line may be used, "
"that is, (1,1,1) and (2,2,2) give the same view. The display orientation may"
" be changed as desired ( :ref:`angle` ). The display coordinate system type "
"may be changed (from Cartesian to cylindrical, spherical, toroidal, etc.) "
"with the :ref:`dsys` command."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.vup.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.vup"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:2
msgid ""
"Specifies the global Cartesian coordinate system reference orientation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:4
msgid ""
"Mechanical APDL Command: `/VUP "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_VUP.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:12
msgid "Orientation:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:14
msgid ""
"``Y`` - Y vertical upward, X horizontal to the right, Z out from the screen "
"(default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:16
msgid ""
"``-Y`` - Y vertical downward, X horizontal to the left, Z out from the "
"screen."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:18
msgid ""
"``X`` - X vertical upward, Y horizontal to the left, Z out from the screen."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:20
msgid ""
"``-X`` - X vertical downward, Y horizontal to the right, Z out from the "
"screen."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:22
msgid ""
"``Z`` - Z vertical upward, Y horizontal to the right, X out from the screen."
" With this choice, you should use a view other than the :ref:`view` default "
"of (0,0,1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:25
msgid ""
"``-Z`` - Z vertical downward, Y horizontal to the left, X out from the "
"screen. With this choice, you should use a view other than the :ref:`view` "
"default of (0,0,1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.vup:42
msgid ""
"Specifies the global Cartesian coordinate system reference orientation. The "
":ref:`view` and :ref:`angle` commands may be used to reorient the view and "
"are relative to this reference orientation. All coordinate systems are "
"right-handed."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.xfrm.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.xfrm"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:2
msgid "Controls the centroid or the axis of dynamic rotation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:4
msgid ""
"Mechanical APDL Command: `/XFRM "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_XFRM.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:10
msgid ""
"Issuing :ref:`xfrm`, with no ``LAB`` defined sets the center of rotation at "
"the focal point specified by the :ref:`focus` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:16
msgid ""
"The location or entity (centroid) used to define the center or axis of "
"rotation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:18
msgid ""
"``NODE`` - If NODE is chosen for the center of rotation, the node number "
"will be ``X1``. If the rotation is to be about an axis, then ``X1`` and "
"``Y1`` define the two nodes between which a line is drawn to determine the "
"axis. The remaining arguments are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:22
msgid ""
"``ELEMENT`` - If ELEMENT is chosen for the center of rotation, the element "
"number will be ``X1``. If the rotation is to be about an axis, then ``X1`` "
"and ``Y1`` define the two elements between which a line is drawn to "
"determine the axis. The remaining arguments are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:26
msgid ""
"``KP`` - If KP is chosen for the center of rotation, the keypoint number "
"will be ``X1``. If the rotation is to be about an axis, then ``X1`` and "
"``Y1`` define the two keypoints between which a line is drawn to determine "
"the axis. The remaining arguments are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:30
msgid ""
"``LINE`` - If LINE is chosen for the center of rotation, the line number "
"will be ``X1``. If the rotation is to be about an axis, then ``X1`` and "
"``Y1`` define the two lines between which a line is drawn to determine the "
"axis. The remaining arguments are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:34
msgid ""
"``AREA`` - If AREA is chosen for the center of rotation, the area number "
"will be ``X1``. If the rotation is to be about an axis, then ``X1`` and "
"``Y1`` define the two areas between which a line is drawn to determine the "
"axis. The remaining arguments are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:38
msgid ""
"``VOLUME`` - If VOLUME is chosen for the center of rotation, the volume "
"number will be ``X1``. If the rotation is to be about an axis, then ``X1`` "
"and ``Y1`` define the two volumes between which a line is drawn to determine"
" the axis. The remaining arguments are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:42
msgid ""
"``XYZ`` - If XYZ is chosen for the center of rotation, the location of that "
"center is determined by the coordinates ``X1``, ``Y1``, ``Z1``. If values "
"are specified for ``X2``, ``Y2``, ``Z2``, then the axis of rotation will be "
"about the line between those two points."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:46
msgid ""
"``OFF`` - If ``LAB`` = OFF, DEFAULT, FOCUS or if no value is specified, then"
" the center of rotation is set at the FOCUS point, as defined by the "
":ref:`focus` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:50
msgid "The entity number or X coordinate for the center of rotation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:53
msgid "The entity number or Y coordinate for the center of rotation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:56
msgid "The Z coordinate for the center of rotation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:59
msgid "The X coordinate for the axis of rotation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:62
msgid "The Y coordinate for the axis of rotation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:65
msgid "The Z coordinate for the axis of rotation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:81
msgid ""
"The :ref:`xfrm` command is active only when the cumulative rotation key is "
"specified ON for the :ref:`angle` command ( ``KINCR`` = 1). This command "
"affects dynamic manipulations only."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:84
msgid ""
"For center rotation, the middle mouse button will rotate the model about the"
" screen Z axis and the right mouse button will rotate the model about the "
"screen X and Y axis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.xfrm:87
msgid ""
"For rotation about an axis, the middle mouse button will rotate the model "
"about the defined axis of rotation and the right mouse button will be "
"deactivated."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.views.Views.zoom.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.views.Views.zoom"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:2
msgid "Zooms a region of a display window."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:4
msgid ""
"Mechanical APDL Command: `/ZOOM "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_ZOOM.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:9
msgid "Window number to which command applies (defaults to 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:12
msgid "Label to define the desired type of zoom:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:14
msgid "``OFF`` - Turns zoom off (refits image of entire model to the window)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:16
msgid ""
"``BACK`` - Goes back to previous zoom setting (five successive back ups, "
"maximum)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:18
msgid ""
"``SCRN`` - Interprets X1,Y1 as the screen coordinates of the center of a "
"square zoom region; X2,Y2 as the screen coordinates of a point on one side "
"of that square."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:21
msgid ""
"``RECT`` - Interprets X1,Y1 and X2,Y2 as the screen coordinates of two "
"opposite corners of a rectangular zoom region."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:25
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:31
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:37
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:43
msgid ""
"The description of the argument is missing in the Python function. Please, "
"refer to the `command documentation "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_ZOOM.html>`_"
" for further information."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:62
msgid ""
"Zooms (centers and magnifies) the specified region of a display window. "
":ref:`zoom` will operate on a display that has been formed by an explicit "
"graphics action command ( :ref:`aplot`, :ref:`eplot`, etc.). :ref:`zoom` has"
" no effect on an \"immediate\" graphics display. When :ref:`zoom` is "
"executed, the display is automatically replotted such that the specified "
"zoom region is centered and sized to fill the window."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.zoom:68
msgid ""
"Auto resizing is disabled when you issue the :ref:`zoom` command. To restore"
" auto resizing, issue the :ref:`auto` command, or select FIT from the `Pan, "
"Zoom, Rotate "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_wid/Hlp_UI_PanZoom.html#wpanzoomk>`_"
" box."
msgstr ""

