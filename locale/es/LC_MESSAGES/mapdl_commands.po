msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.cecycms:10
msgid ""
"The name of a component for the nodes located on the low angle edge of the "
"sector (up to 256 characters enclosed in single quotes)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.cecycms:13
