#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.race:17
msgid "**tcur** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.race:18
msgid "Total current, amp-turns (MKS), flowing in the source."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.race:21
msgid "In-plane thickness of the racetrack source."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.race:24
msgid "Out-of-plane thickness (depth) of the racetrack source."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.race:43
msgid ""
":ref:`race` invokes a Mechanical APDL macro which defines a racetrack "
"current source in the working plane coordinate system."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.race:49
msgid ""
"The current source is generated from bar and arc source primitives using "
"``SOURC36`` (which is assigned the next available element type number)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.race:52
msgid ""
"The macro is valid for use in 3D magnetic field analysis using a scalar "
"potential formulation."
