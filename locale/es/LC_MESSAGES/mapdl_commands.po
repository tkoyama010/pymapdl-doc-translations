msgid ""
"Copy line mesh (default) if LINE, 0 or 1. Copy area mesh if AREA, or 2."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy:12
