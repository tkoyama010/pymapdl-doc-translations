#: of ansys.mapdl.core._commands.graphics.scaling.Scaling.vscale:18
msgid "``0`` - Use relative length scaling among vectors based on magnitudes."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/scaling.pydocstring
#: of ansys.mapdl.core._commands.graphics.scaling.Scaling.vscale:20
