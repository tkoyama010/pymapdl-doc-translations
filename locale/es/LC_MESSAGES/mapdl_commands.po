msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:138
msgid ""
"For node-based initial state ( ``Val2`` = NODE), element ID number (if "
"specified). The :ref:`inistate` command is applied only to the specified "
"element (unlike the default behavior, where the command is applied to all "
"selected elements containing the specified node)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:142
msgid ""
"Not valid for material-based initial-state data ( ``Val1`` = MAT) or node-"
"based initial state ( ``Val2`` = NODE)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:145
msgid ""
"``KLAYER`` - Layer number (for layered solid/shell elements) or cell number "
"for beam/pipe elements. Blank for other supported element types and "
"material-based initial-state data. Default = ALL or -1."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:149
msgid ""
"``ParmInt`` - Section integration point within a layer, or cell-integration "
"point for beams (typically four integration points). Default = ALL or -1. "
"Not valid for material-based initial-state data ( ``Val1`` = MAT) or node-"
"based initial state ( ``Val2`` = NODE)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:153
msgid "Not valid for material-based initial-state data ( ``Val1`` = MAT)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:155
msgid ""
"Not used for node-based initial state with elements that do not have a "
"beam/pipe/shell section defined."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:158
msgid ""
"For node-based initial state with beams/pipes, values 1 through 4 can be "
"used to specify the values at corner nodes within a cell."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:161
msgid ""
"For node-based initial state with layered sections, values can be specified "
"at TOP, BOT, and MID, or left blank (ALL or -1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:164
msgid ""
"``Cxx, Cyy, Czz, Cxy, Cyz, Cxz`` - Stress (S), strain (EPEL), or plastic "
"strain (EPPL) values."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
#: of ansys.mapdl.core._commands.prep7.data_tables.DataTables.inistate:166
msgid ""
"You can issue the :ref:`inistate` command repeatedly to define multiple sets"
" of initial-state values. initial-state data can be specified according to "
"elements, layers or integration points."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/data_tables.pydocstring
