#: ../../pymapdl/src/ansys/mapdl/core/_commands/apdl/array_parameters.pydocstring
#: of
#: ansys.mapdl.core._commands.apdl.array_parameters.ArrayParameters.voper:28
#: ../../pymapdl/src/ansys/mapdl/core/_commands/apdl/array_parameters.pydocstring
#: of
#: ansys.mapdl.core._commands.apdl.array_parameters.ArrayParameters.voper:144
