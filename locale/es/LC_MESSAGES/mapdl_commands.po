msgid "ansys.mapdl.core.\\_commands.prep7.database.Database.cdopt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/database.rst:32:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdopt:2
msgid "Specifies format to be used for archiving geometry."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdopt:4
msgid ""
"Mechanical APDL Command: `CDOPT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_CDOPT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdopt:9
msgid ""
"``IGES`` - Write solid model geometry information using IGES format "
"(default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdopt:11
msgid ""
"``ANF`` - Write solid model geometry information using Ansys Neutral File "
"(ANF) format."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdopt:13
msgid "``STAT`` - Print out the current format setting."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdopt:29
msgid ""
"This command controls your solid model geometry format for :ref:`cdwrite` "
"operations. The ANF option affects only the COMB and SOLID options of the "
":ref:`cdwrite` command. All other options remain unaffected."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdopt:33
msgid "This option setting is saved in the database."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.database.Database.cdread.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.database.Database.cdread"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/database.rst:32:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:2
msgid ""
"Reads a file of solid model and database information into the database."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:4
msgid ""
"Mechanical APDL Command: `CDREAD "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_CDREAD.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:9
msgid "Selects which data to read:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:11
msgid ""
"``ALL`` - Read all geometry, material property, load, and component data "
"(default). Solid model geometry and loads will be read from the file "
":file:`fnamei.exti`. All other data will be read from the file "
":file:`fname.ext.` None"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:15
msgid ""
"``DB`` - Read all database information contained in file :file:`Fname.Ext`. "
"This file should contain all information mentioned above except the solid "
"model loads. If reading a :file:`.CDB` file written with the GEOM option of "
"the :ref:`cdwrite` command, element types ( :ref:`et` ) compatible with the "
"connectivity of the elements on the file must be defined prior to reading."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:20
msgid ""
"``SOLID`` - Read the solid model geometry and solid model loads from the "
"file :file:`Fnamei.Exti`. This file could have been written by the "
":ref:`cdwrite` or :ref:`igesout` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:23
msgid ""
"``COMB`` - Read the combined solid model and database information from the "
"file :file:`Fname.Ext.` None"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:32
msgid ""
"Filename extension (eight-character maximum). The extension defaults to "
":file:`.cdb` if ``Fname`` is blank."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:35
msgid "**fnamei** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:36
msgid ""
"Name of the IGES file and its directory path (248 characters maximum, "
"including directory). If you do not specify a directory path, it will "
"default to your working directory and you can use all 248 characters for the"
" file name."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:40
msgid ""
"The file name defaults to ``Fname``. Used only if ``Option`` = ALL or SOLID."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:42
msgid "**exti** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:43
msgid ""
"Filename extension (eight-character maximum). Defaults to IGES if ``Fnamei``"
" is blank."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:59
msgid ""
"This command causes coded files of solid model (in IGES format) and database"
" (in command format) information to be read. These files are normally "
"written by the :ref:`cdwrite` or :ref:`igesout` command. Note that the "
"active coordinate system in these files has been reset to Cartesian ( "
":ref:`csys`,0)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:64
msgid ""
"If a set of data exists prior to the :ref:`cdread` operation, that data set "
"is offset upward to allow the new data to fit without overlap. The "
":ref:`nooffset` command allows this offset to be ignored on a set-by-set "
"basis, causing the existing data set to be overwritten with the new data "
"set."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:69
msgid ""
"When you write the geometry data using the :ref:`cdwrite`,GEOM option, you "
"use the :ref:`cdread`,DB option to read the geometry information."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:72
msgid ""
"Using the :ref:`cdread`,COMB option will not write :ref:`numoff` commands to"
" offset entity ID numbers if there is no solid model in the database."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/database.pydocstring of
#: ansys.mapdl.core._commands.prep7.database.Database.cdread:75
msgid ""
"Multiple :file:`.cdb` file imports cannot have elements with real constants "
"in one file and section definitions in another. The section attributes will "
"override the real constant attributes. If you use :ref:`cdread` to import "
"multiple CDB files, define all of the elements using only real constants, or"
" using only section definitions. Combining real constants and section "
