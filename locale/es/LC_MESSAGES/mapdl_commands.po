"Often used before the :ref:`lcoper` command. Same as :ref:`lcoper`,ZERO."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.load_case_calculations.LoadCaseCalculations.rappnd.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.post1.load\\_case\\_calculations.LoadCaseCalculations.rappnd"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/load_case_calculations.rst:28:<autosummary>:1
