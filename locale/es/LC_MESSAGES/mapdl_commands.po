msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/piping.pydocstring of
#: ansys.mapdl.core._commands.prep7.piping.Piping.bellow:21
msgid ""
"Element number to be assigned to bellows (defaults to the previous maximum "
"element number (MAXEL) + 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/piping.pydocstring of
#: ansys.mapdl.core._commands.prep7.piping.Piping.bellow:38
msgid ""
"Defines a bellows (straight-pipe element PIPE16 with adjusted specifications"
