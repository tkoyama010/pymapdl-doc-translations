msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.ednb:35
