#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.czmesh:13
msgid ""
"Component name or number for the opposing (from ``ecomps1`` ) group of plane"
" or solid structural elements adjacent to the interface being meshed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.czmesh:17
msgid ""
"Coordinate system number for the separation surface and normal direction. "
"(if ``ecomps1`` and ``ecomps2`` not specified)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.czmesh:20
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
