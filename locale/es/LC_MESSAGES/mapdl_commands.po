#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:194
msgid "``VAL4`` - ``KCRC`` -- The wave-current interaction key."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:196
msgid ""
"Adjustments to the current profile are available via the ``KCRC`` constant "
"of the water motion table. Typically, these options are used only when the "
"wave amplitude is large relative to the water depth, such that significant "
"wave-current interaction exists."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:200
msgid ""
"0 -- Use the current profile (as input) for wave locations below the mean "
"water level, and the top current profile value for wave locations above the "
"mean water level (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:202
msgid ""
"1 -- Linearly stretch or compress the current profile from the mud line to "
"the top of the wave."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:203
msgid ""
"2 -- Similar to ``KCRC`` = 1, but also adjusts the current profile "
"horizontally such that total flow continuity is maintained with the input "
"profile. All current directions ``Th`` (j) must be identical."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:206
msgid "The following option is valid only when KWAVE = 5 through 7:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:207
msgid ""
"3 -- Nonlinear stretch or compress the current profile, as recommended in "
"API RP 2A Codes of Practice for Designing and Constructing Fixed Offshore "
"Platforms."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:210
msgid ""
"``VAL5`` - ``KMF`` -- The MacCamy-Fuchs adjustment key, typically used only "
"for larger-diameter"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:211
msgid "pipes in relatively shallow water:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:213
msgid "0 -- Do not apply the adjustment (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:214
msgid "1 -- Apply the adjustment (valid only when ``KWAVE`` = 0 or 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:216
msgid "``VAL6`` - ``PRKEY`` -- The wavelength wave-printout key:"
msgstr ""

