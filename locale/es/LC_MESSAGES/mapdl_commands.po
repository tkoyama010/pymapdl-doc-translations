#: ansys.mapdl.core._commands.solution.ocean.Ocean.octable:70
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.octable:200
