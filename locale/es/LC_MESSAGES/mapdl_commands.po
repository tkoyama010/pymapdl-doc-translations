"In coordinate system ``KCN``, elements are created between node 1 and node 2"
" (= node 1 + dx dy dz)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.eintf:36
