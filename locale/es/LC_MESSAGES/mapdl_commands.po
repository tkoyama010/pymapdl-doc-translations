#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ldrag:82
msgid ""
"Generates lines (and their corresponding keypoints) by sweeping a given "
"keypoint pattern along a characteristic drag path. If the drag path consists"
" of multiple lines, the drag direction is determined by the sequence in "
"which the path lines are input ( ``NL1``, ``NL2``, etc.). If the drag path "
"is a single line ( ``NL1`` ), the drag direction is from the keypoint on the"
" drag line that is closest to the first keypoint of the given pattern to the"
" other end of the drag line."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ldrag:88
msgid ""
"The magnitude of the vector between the keypoints of the given pattern and "
"the first path keypoint remains constant for all generated keypoint patterns"
" and the path keypoints. The direction of the vector relative to the path "
"slope also remains constant so that patterns may be swept around curves. "
"Keypoint and line numbers are automatically assigned (beginning with the "
"lowest available values ( :ref:`numstr` )). For best results, the entities "
"to be dragged should be orthogonal to the start of the drag path. Drag "
"operations that produce an error message may create some of the desired "
"entities prior to terminating."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lextnd.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lextnd"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lextnd:2
msgid "Extends a line at one end by using its slope."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lextnd:4
msgid ""
"Mechanical APDL Command: `LEXTND "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LEXTND.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lextnd:9
msgid ""
"Number of the line to be extended. If ``NL1`` = P, graphical picking is "
"enabled and all remaining command fields are ignored (valid only in the "
"GUI)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lextnd:13
msgid "Number of keypoint at the end of line ``NL1`` to be extended."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lextnd:16
msgid "Distance that the line will be extended."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lextnd:23
msgid ""
"``1`` - Do not modify old line. New line will overlay old line and have "
"unique keypoints."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lextnd:43
msgid ""
"Extends a line at one end by using its slope. Lines may be redefined only if"
" not yet attached to an area. Line divisions are set to zero (use "
":ref:`lesize`, etc. to modify). Note that solid modeling in a toroidal "
"coordinate system is not recommended."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lextnd:50
msgid "Create a circular arc and extend it at one of its keypoints"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lfillt.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lfillt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lfillt:2
msgid "Generates a fillet line between two intersecting lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lfillt:4
msgid ""
"Mechanical APDL Command: `LFILLT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LFILLT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lfillt:9
msgid ""
"Number of the first intersecting line. If ``NL1`` = P, graphical picking is "
"enabled and all remaining command fields are ignored (valid only in the "
"GUI)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lfillt:13
msgid "Number of the second intersecting line."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lfillt:16
msgid ""
"Radius of fillet to be generated. Radius should be less than the lengths of "
"the two lines specified with ``NL1`` and ``NL2``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lfillt:20
msgid ""
"Number to be assigned to generated keypoint at fillet arc center. If zero "
"(or blank), no keypoint is generated."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lfillt:41
msgid ""
"Generates a fillet line between two intersecting lines ``NL1`` ( ``P1`` - "
"``PINT`` ) and ``NL2`` ( ``P2`` - ``PINT`` ). Three keypoints may be "
"generated, two at the fillet tangent points ( ``PTAN1`` and ``PTAN2`` ) and "
"one (optional) at the fillet arc center ( ``PCENT`` ). Line ``P1`` - "
"``PINT`` becomes ``P1`` - ``PTAN1``, ``P2`` - ``PINT`` becomes ``P2`` - "
"``PTAN2``, and new arc line ``PTAN1`` - ``PTAN2`` is generated. Generated "
"keypoint and line numbers are automatically assigned (beginning with the "
"lowest available values ( :ref:`numstr` )). Line divisions are set to zero "
"(use :ref:`lesize`, etc. to modify)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lfillt:52
msgid ""
"Create two intersecting lines at a right angle and add a fillet between "
"them."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lgen.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lgen"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:2
msgid "Generates additional lines from a pattern of lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:4
msgid ""
"Mechanical APDL Command: `LGEN "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LGEN.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/volumes.pydocstring of
#: ansys.mapdl.core._commands.prep7.volumes.Volumes.vgen:9
msgid ""
"Do this generation operation a total of ``ITIME`` s, incrementing all "
"keypoints in the given pattern automatically (or by ``KINC`` ) each time "
"after the first. ``ITIME`` must be > 1 for generation to occur."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:14
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:21
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:28
msgid ""
"Generate lines from pattern beginning with ``NL1`` to ``NL2`` (defaults to "
"``NL1`` ) in steps of ``NINC`` (defaults to 1). If ``NL1`` = ALL, ``NL2`` "
"and ``NINC`` are ignored and pattern is all selected lines ( :ref:`lsel` ). "
"If ``NL1`` = P, graphical picking is enabled and all remaining command "
"fields are ignored (valid only in the GUI). A component name may also be "
"substituted for ``NL1`` ( ``NL2`` and ``NINC`` are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:35
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:39
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:43
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/volumes.pydocstring of
#: ansys.mapdl.core._commands.prep7.volumes.Volumes.vgen:35
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/volumes.pydocstring of
#: ansys.mapdl.core._commands.prep7.volumes.Volumes.vgen:39
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/volumes.pydocstring of
#: ansys.mapdl.core._commands.prep7.volumes.Volumes.vgen:43
msgid ""
"Keypoint location increments in the active coordinate system (--, Dθ, DZ for"
" cylindrical, --, Dθ, -- for spherical)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:53
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lsymm:45
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.ltran:41
msgid ""
"``0`` - Generate nodes and elements associated with the original lines, if "
"they exist."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:58
msgid "Specifies whether to redefine the existing lines:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:60
msgid ""
"``0`` - Generate additional lines as requested with the ``ITIME`` argument."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:62
msgid ""
"``1`` - Move original lines to new position retaining the same keypoint "
"numbers ( ``ITIME``, ``KINC``, and ``NOELM`` are ignored). Valid only if the"
" old lines are no longer needed at their original positions. Corresponding "
"meshed items are also moved if not needed at their original position."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lgen:81
msgid ""
"Generates additional lines (and their corresponding keypoints and mesh) from"
" a given line pattern. The MAT, TYPE, REAL, and ESYS attributes are based "
"upon the lines in the pattern and not upon the current settings. End slopes "
"of the generated lines remain the same (in the active coordinate system) as "
"those of the given pattern. For example, radial slopes remain radial, etc. "
"Generations which produce lines of a size or shape different from the "
"pattern (that is, radial generations in cylindrical systems, radial and phi "
"generations in spherical systems, and theta generations in elliptical "
"systems) are not allowed. Note that solid modeling in a toroidal coordinate "
"system is not recommended. New line numbers are automatically assigned "
"(beginning with the lowest available values ( :ref:`numstr` ))."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.llist.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.llist"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:2
msgid "Lists the defined lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:4
msgid ""
"Mechanical APDL Command: `LLIST "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LLIST.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:16
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:23
msgid ""
"List lines from ``NL1`` to ``NL2`` (defaults to ``NL1`` ) in steps of "
"``NINC`` (defaults to 1). If ``NL1`` = ALL (default), ``NL2`` and ``NINC`` "
"are ignored and all selected lines ( :ref:`lsel` ) are listed. If ``NL1`` = "
"P, graphical picking is enabled and all remaining command fields are ignored"
" (valid only in the GUI). A component name may also be substituted for "
"``NL1`` ( ``NL2`` and ``NINC`` are ignored)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:32
msgid ""
"``(blank)`` - Prints information about all lines in the specified range."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:34
msgid ""
"``RADIUS`` - Prints the radius of certain circular arcs, along with the "
"keypoint numbers of each line. Straight lines, non-circular curves, and "
"circular arcs not internally identified as arcs (which depends upon how each"
" arc is created) will print a radius value of zero."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:38
msgid "``LAYER`` - Prints layer-mesh control specifications."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:40
msgid ""
"``HPT`` - Prints information about only those lines that contain hard "
"points. HPT is not supported in the GUI."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:43
msgid ""
"``ORIENT`` - Prints a list of lines, and identifies any orientation "
"keypoints and any cross section IDs that are associated with the lines. Used"
" for beam meshing with defined orientation nodes and cross sections."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:61
msgid ""
"There are 2 listings for the number of element divisions and the spacing "
"ratio. The first listing shows assignments from :ref:`lesize` only, followed"
" by the \"hard\" key ( ``KYNDIV`` ). See :ref:`lesize` for more information."
" The second listing shows ``NDIV`` and ``SPACE`` for the existing mesh, if "
"one exists. Whether this existing mesh and the mesh generated by "
":ref:`lesize` match at any given point depends upon meshing options and the "
"sequence of meshing operations."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:67
msgid ""
"A -1 in the nodes column indicates that the line has been meshed but that "
"there are no interior nodes."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.llist:70
msgid ""
"An attribute (TYPE, MAT, REAL, or ESYS) listed as a zero is unassigned; one "
"listed as a positive value indicates that the attribute was assigned with "
"the :ref:`latt` command (and will not be reset to zero if the mesh is "
"cleared); one listed as a negative value indicates that the attribute was "
"assigned using the attribute pointer ( :ref:`type`, :ref:`mat`, :ref:`real`,"
" or :ref:`esys` ) that was active during meshing (and will be reset to zero "
"if the mesh is cleared)."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lplot.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lplot"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lplot:2
msgid "Displays the selected lines."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lplot:4
msgid ""
"Mechanical APDL Command: `LPLOT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LPLOT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lplot:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lplot:14
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lplot:19
msgid ""
"Display lines from ``NL1`` to ``NL2`` (defaults to ``NL1`` ) in steps of "
"``NINC`` (defaults to 1). If ``NL1`` = ALL (default), ``NL2`` and ``NINC`` "
"are ignored and display all selected lines ( :ref:`lsel` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lplot:37
msgid ""
"Mesh divisions on plotted lines are controlled by the ``LDIV`` option of the"
" :ref:`psymb` command."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lreverse.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.lines.Lines.lreverse"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/lines.rst:45:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:2
msgid ""
"Reverses the normal of a line, regardless of its connectivity or mesh "
"status."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:4
msgid ""
"Mechanical APDL Command: `LREVERSE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LREVERSE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:8
msgid "**lnum** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:9
msgid ""
"Line number of the line whose normal direction is to be reversed. If "
"``LNUM`` = ALL, the normals of all selected lines will be reversed. If "
"``LNUM`` = P, graphical picking is enabled. A component name may also be "
"substituted for ``LNUM``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:14
msgid ""
"Indicates whether you want to change the normal direction of the existing "
"elements on the reversed line(s) so that they are consistent with each "
"line's new normal direction."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:17
msgid ""
"``0`` - Make the normal direction of existing elements on the reversed "
"line(s) consistent with each line's new normal direction (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:20
msgid ""
"``1`` - Do not change the normal direction of existing elements on the "
"reversed line(s)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:36
msgid ""
"You cannot use the :ref:`lreverse` command to change the normal direction of"
" any element that has a body or surface load. We recommend that you apply "
"all of your loads only after ensuring that the element normal directions are"
" acceptable."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/lines.pydocstring of
#: ansys.mapdl.core._commands.prep7.lines.Lines.lreverse:43
msgid ""
"For more information, see `Revising Your Model "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD8_6.html>`_"
"  in the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.lines.Lines.lrotat.rst:2
