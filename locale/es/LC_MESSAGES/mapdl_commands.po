#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:17
msgid "Apply display items as selected from the following labels:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:19
msgid ""
"``INFO`` - Controls the display of the legend (ON or OFF) and allows the "
"choice of preset or Multi-legend placement. Control is provided by the "
"``KEY`` values. (Defaults to ``KEY`` =3 when the GUI is on. Defaults to "
"``KEY`` = 2 otherwise.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:23
msgid "``LEG1`` - Header portion of legend column (defaults to ON)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:25
msgid ""
"``LEG2`` - View portion of legend column (defaults to ON (except off with "
"contour displays))."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:27
msgid ""
"``LEG3`` - View the contour section of the legend column (defaults to ON)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:29
msgid "``FRAME`` - Frame border lines around windows (defaults to ON)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:31
msgid "``TITLE`` - Title (bottom left text) (defaults to ON)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:33
msgid "``MINM`` - Min-Max symbols on contour displays (defaults to ON)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:35
msgid ""
"``LOGO`` - Ansys logo (defaults to OFF (displayed as text at top of legend "
"column)). If ``KEY`` = ON, the text is removed from legend column but the "
"logo symbol is displayed in whichever active window is either in the "
"uppermost right corner and on top, or if there is no window in that "
"location, then in the window to the furthest right of the screen. Version "
"information remains in the legend column."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:41
msgid ""
"``WINS`` - Controls whether graphics windows automatically stretch or shrink"
" to adjust to screen size as the legend column is turned off or on ( "
":ref:`plopts`,INFO) (defaults to ON). If WINS is on and the legend column is"
" changed from off to on, all windows are shrunk regardless of what their "
"correct size is."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:46
msgid ""
"``WP`` - Working plane (defaults to OFF). The working plane is drawn as part"
" of the display ( not just an overlaid image as in :ref:`wpstyl` ). This "
"option is best used in combination with a hidden- line technique ( "
":ref:`slashtype` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:50
msgid ""
"``DATE`` - Controls the display of the date and time in your legend. "
"Subsequent ``KEY`` values control the display as follows:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:52
msgid "0 - No date or time displays are included in your legend."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:53
msgid "1 - Only the date is shown."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:54
msgid "2 - Both the date and time are shown (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:56
msgid ""
"``FILE`` - Controls the display of the Mechanical APDL jobname in your "
"legend. Subsequent ``KEY`` values control the display as follows:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:58
msgid ""
"0 - The Mechanical APDL jobname is not included in your legend (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:59
msgid "1 - The Mechanical APDL jobname is included in your legend."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:62
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:55
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.udoc:57
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.gtype:29
msgid "Switch:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:64
msgid ""
"``OFF or 0`` - Do not apply this display item. For ``Label`` = DATE, no time"
" or date are displayed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:67
msgid ""
"``ON or 1`` - Apply this display item. For ``Label`` = DATE, show only the "
"date."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:69
msgid ""
"``AUTO or 2`` - For ``Label`` = INFO, initiate Auto-legend mode. If the "
"display has contours, the legend is ON; if the display has no contours, the "
"legend is OFF. For ``Label`` = DATE, display both the date and time."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:73
msgid ""
"``3`` - For ``Label`` = INFO, switch to Multi-legend mode. See the "
":ref:`udoc` command for the available legend configurations."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:90
msgid ""
"Use :ref:`plopts`,STAT to display settings. Use :ref:`plopts`,DEFA to reset "
"all specifications back to their defaults."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:93
msgid ""
"When you perform multiple results displays, contours on the legend column "
"may be truncated. To avoid this, specify :ref:`plopts`,LEG1,0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.plopts:96
msgid ""
"The Multi-legend mode provides a number of legend data item priority and "
"placement options. These options are accessed via the GUI at Utility Menu> "
"PlotCtrls> Window Controls> Window Options. The :ref:`udoc` command provides"
" command line o ptions for this capability."
msgstr ""

