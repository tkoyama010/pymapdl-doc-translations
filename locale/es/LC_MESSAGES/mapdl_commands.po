msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/dynamic_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.dynamic_options.DynamicOptions.mxpand:62
msgid "The mode shapes are normalized to the mass matrix."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/dynamic_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.dynamic_options.DynamicOptions.mxpand:64
msgid "``FREQB`` and ``FREQE`` are blank or 0.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/dynamic_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.dynamic_options.DynamicOptions.mxpand:66
msgid "No superelement is defined."
msgstr ""

