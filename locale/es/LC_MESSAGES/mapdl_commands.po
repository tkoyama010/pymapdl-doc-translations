msgid ""
"File name and directory path (248 characters maximum, including the "
"characters needed for the directory path). An unspecified directory path "
"defaults to the working directory; in this case, you can use all 248 "
"characters for the file name. The file name defaults to :file:`Jobname` if "
"``Fname`` is left blank."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/cross_sections.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.cross_sections.CrossSections.secwrite:18
msgid "**elem_type** : :class:`python:str`"
msgstr ""

