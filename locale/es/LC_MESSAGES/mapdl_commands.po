#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grid:2
msgid "Selects the type of grid on graph displays."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grid:4
msgid ""
"Mechanical APDL Command: `/GRID "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_GRID.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grid:9
msgid "Grid key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grid:11
msgid "``0 (OFF)`` - No grid."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grid:13
msgid "``1 (ON)`` - Full grid (X and Y grid lines)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grid:15
msgid "``2 (X)`` - Partial grid (X grid lines only)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grid:17
msgid "``3 (Y)`` - Partial grid (Y grid lines only)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.grid:33
msgid ""
"Selects the type of grid on graph displays. Graphs with multiple Y-axes can "
"have multiple grids ( :ref:`grtyp` ). The grid of the first curve is also "
"used as the background grid (above and behind the curve). Grids for other "
"curves are limited to be under the curves. See also :ref:`gthk` and "
":ref:`gropt` for other grid options."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.graphs.Graphs.gropt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/graphs.rst:25:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:2
msgid "Sets various line graph display options."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:4
msgid ""
"Mechanical APDL Command: `/GROPT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_GROPT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:9
msgid "Apply display style as selected from the following labels:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:11
msgid "``AXDV`` - Axis division (tick) marks (defaults to ``KEY`` = ON)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:13
msgid ""
"``AXNM`` - Axis scale numbers (defaults to ``KEY`` = ON, which puts numbers "
"at the back plane of the graph). If ``KEY`` = FRONT, numbers are on the "
"front plane of the graph."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:16
msgid ""
"``AXNSC`` - Axis number size scale factor. Input the scale value for ``KEY``"
" (defaults to 1.0)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:18
msgid ""
"``ASCAL`` - Automatic scaling of additional Y-axes for multi-curve ( "
":ref:`grtyp`, 2 or 3) graphs (defaults to ``KEY`` = ON). If ``KEY`` = OFF, "
"use base Y-axis scaling (see the :ref:`yrange` command)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:22
msgid "``LOGX`` - Log X scale (defaults to ``KEY`` = OFF (linear))."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:24
msgid ""
"``LOGY`` - Log Y scale (applies only to the base Y axis) (defaults to "
"``KEY`` = OFF (linear))."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:26
msgid "``FILL`` - Color fill areas under curves (defaults to ``KEY`` = OFF)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:28
msgid ""
"``CGRID`` - Superimpose background grid ( :ref:`grid` ) over areas under "
"filled curves (defaults to ``KEY`` = OFF)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:31
msgid ""
"``DIG1`` - Number of significant digits before decimal point for axis "
"values. Input the value for ``KEY`` (defaults to 4)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:34
msgid ""
"``DIG2`` - Number of significant digits after decimal point for axis values."
" Input the value for ``KEY`` (defaults to 3)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:37
msgid ""
"``VIEW`` - View key for graph displays (defaults to ``KEY`` = OFF, in which "
"case the view is (0,0,1) for 2D graph displays or (1,2,3) for 3D graph "
"displays). If ``KEY`` = ON, the view settings for graph displays are the "
"same as the view settings for the model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:41
msgid "``REVX`` - Plots the values on the X-axis in reverse order."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:43
msgid "``REVY`` - Plots the values on the Y-axis in reverse order."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:45
msgid ""
"``DIVX`` - Determines the number of divisions (grid markers) that will be "
"plotted on the X axis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:47
msgid ""
"``DIVY`` - Determines the number of divisions (grid markers) that will be "
"plotted on the Y axis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:49
msgid ""
"``LTYP`` - Specifies whether program-generated ( ``KEY`` = 1) or system-"
"derived ( ``KEY`` = 0) fonts are used for the axis labels."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:52
msgid ""
"``CURL`` - Determines the position of the curve labels. If ( ``KEY`` = 1), "
"the curve label will be plotted in the legend column, and the label will be "
"displayed in the same color as the curve. If ( ``KEY`` = 0) the curve labels"
" will be plotted near the curve. (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:56
msgid ""
"``XAXO`` - When you use this label, the subsequent ``KEY`` value will "
"determine an offset amount from the default (along the bottom) location for "
"the X axis. If ``KEY`` = 1.0, a full offset occurs (the X axis is moved to "
"the top of the graph). If ``KEY`` = 0.5, the axis is offset to the midpoint "
"of the graph, and if ``KEY`` = 0 the axis remains in the original position, "
"along the bottom of the graph. For any offset, a grey copy of the original "
"axis (containing the axis numbering) remains at the original location."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:63
msgid ""
"``YAXO`` - When you use this label, the subsequent ``KEY`` value will "
"determine an offset amount from the default (along the left side of the "
"graph) location for the Y axis. If ``KEY`` = 1.0, a full offset occurs (the "
"Y axis is moved to the right side of the graph). If ``KEY`` = 0.5, the axis "
"is offset to the midpoint of the graph, and if ``KEY`` = 0 the axis remains "
"in the original position, along the left side of the graph. For any offset, "
"a gray copy of the original axis (containing the axis numbering) remains at "
"the original location."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:71
msgid "Option values:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:73
msgid "``OFF (0)`` - Do not apply selected style."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:75
msgid "``ON (1)`` - Apply selected style."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:77
msgid "``nnnn`` - If ``Lab`` is DIG1 or DIG2, input the number of digits."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:79
msgid "``nn`` - If ``Lab`` is AXNSC, input the scale factor."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:81
msgid "``FRONT`` - If ``Lab`` is AXNM, FRONT may also be input."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:83
msgid ""
"``Ndiv`` - If ``Lab`` is DIVX or DIVY, determines the number of divisions "
"(1-99) that will be applied to the axis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:86
msgid ""
"``Kfont`` - If ``Lab`` is LTYP, ``Kfont`` is ON (1) or OFF(0). ON uses "
"program-generated fonts for the axis labels, while OFF uses SYSTEM (Windows,"
" X-system, etc.) fonts. Default: ``Kfont`` = ON (Mechanical APDL fonts)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:104
msgid ""
"Sets various line graph display options. Issue :ref:`gropt`,STAT to display "
"the current settings."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:106
msgid "Issue :ref:`gropt`,DEFA to reset default specifications."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:108
msgid ""
"Unless you issue :ref:`gropt`,VIEW,ON, the program indicates that graph-view"
" manipulation is inactive."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:111
msgid ""
"See :ref:`axlab`, :ref:`grtyp`, :ref:`grid`, and :ref:`gthk` for other "
"graph-control options."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/graphs.pydocstring of
#: ansys.mapdl.core._commands.graphics.graphs.Graphs.gropt:113
msgid ""
"Automatic scaling using the :ref:`xrange` and :ref:`yrange` commands often "
"yields inappropriate range values for logarithmic scales ( :ref:`gropt`, "
"LOGX or :ref:`gropt`, LOGY)."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.graphs.Graphs.grtyp.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.graphs.Graphs.grtyp"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/graphs.rst:25:<autosummary>:1
