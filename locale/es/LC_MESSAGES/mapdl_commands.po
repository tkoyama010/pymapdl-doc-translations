msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.mpread:25
msgid ""
"Reads material library files previously written with the :ref:`mpwrite` "
"command. (See the description of the LIB option for the :ref:`mpwrite` "
"command.) The only allowed value for LIB is LIB."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.mpread:29
msgid ""
"The LIB field indicates that the specified file was written by "
":ref:`mpwrite` using the LIB option, and that the file is consistent with "
"the material library file format. When the :ref:`mpread` command executes, "
"Mechanical APDL reads material properties defined in the specified file into"
" the current Mechanical APDL working database. The currently selected "
"material, as defined by the :ref:`mat` command ( :ref:`mat`,MAT), determines"
" the material number used when reading the material properties. The LIB "
"option for :ref:`mpread` and :ref:`mpwrite` supports storing and retrieving "
"both linear and nonlinear properties."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.mpread:51
msgid ""
"Material properties written to a file without the LIB option do not support "
"nonlinear properties. Also, properties written to a file without the LIB "
"option are restored in the same material number as originally defined. To "
"avoid errors, use :ref:`mpread` with the LIB option only when reading files "
"written using :ref:`mpwrite` with the LIB option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.mpread:56
msgid ""
"If you omit the LIB option for :ref:`mpread`, this command supports only "
"linear properties."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/materials.pydocstring of
#: ansys.mapdl.core._commands.prep7.materials.Materials.mpread:58
msgid ""
"Material numbers are hardcoded. If you write a material file without "
"specifying the LIB option, then read that file in via the :ref:`mpread` "
"command with the LIB option, Mechanical APDL does not write the file to a "
"new material number; instead, it writes the file to the old material number "
"(the number specified on the :ref:`mpwrite` command that created the file.)"
msgstr ""

