"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_FDELE_sl.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.slashfdele:9
msgid ""
"Mechanical APDL file name identifier. Valid identifiers are: EMAT, ESAV, "
