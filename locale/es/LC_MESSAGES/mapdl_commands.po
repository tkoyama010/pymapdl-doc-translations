#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:12
msgid "``NLAY`` - The sculpting layer adjustment:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:14
msgid ""
"``VAL1`` - The number of sculpting layers, beginning with detected seed "
"elements. Valid for 2D and 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:17
msgid "Default: ``VAL1`` = 10 for 2D analysis, ``VAL1`` = 2 for 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:18
msgid ""
"For local (partial) remeshing, this option helps the remesher to detect "
"remeshing regions from the whole deformed model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:20
msgid ""
"Generally, a larger ``VAL1`` leads to larger remeshing regions and tends to "
"unite isolated multiple regions. A larger value also tends to result in "
"better remeshing quality (and increases mapping and solution overhead "
"accordingly)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:23
msgid ""
"Only elements with the same element and material properties as seed elements"
" are included into the remeshing regions."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:25
msgid ""
"``VAL1`` = 0 is not valid, as the remeshing regions would contain only the "
"detected seed elements, resulting in many small cavities within remeshing "
"regions (especially if the specified mesh- quality metric threshold ( "
":ref:`nladaptive` ) is relatively large)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:29
msgid ""
"``VAL2`` - Same as ``VAL1``, except that ``VAL1`` controls remeshing to "
"remove distortion and ``VAL2`` controls element refinement. Default: "
"``VAL2`` = 1 for 2D analysis, ``VAL2`` = 2 for 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:33
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:86
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:131
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:145
msgid ""
"Not used in a `NLAD-ETCHG analysis "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/nladetchgexample.html>`_."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:36
msgid ""
"For more information about this control, see `Sculpting Layers Control "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnanewmesh.html#>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:39
msgid ""
"``BDRA`` - The boundary angle threshold in degrees. Use this adjustment to "
"retain geometry features of the original (source) mesh. Valid for both 2D "
"and 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:42
msgid ""
"In a 3D analysis, this value is the dihedral angle (the angle between the "
"normal vectors from two neighboring surface facets). In a 2D analysis, this "
"value is the 2D patch boundary edge normal angle. If the edge angle or "
"dihedral angle is larger than the specified threshold, the node shared by 2D"
" edges or edges shared by 3D facets are retained during remeshing."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:47
msgid "Valid values: 0 < ``VAL1`` < 80."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:49
msgid ""
"Default for 2D analysis: ``VAL1`` = 10. Default for 3D analysis: ``VAL1`` = "
"15."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:51
msgid ""
"Generally, a larger ``VAL1`` improves the quality of the new mesh (and may "
"even repair local tiny edges or facets of poor quality). Too large a value, "
"however, may also smooth out some geometric features, leading to slightly "
"different results and possibly causing convergence issues in the substeps "
"immediately following remeshing."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:56
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:70
msgid ""
"For more information about this control, see `Boundary-Angle and Edge-Angle "
"Control "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnanewmesh.html#>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:59
msgid ""
"``AEDG`` - The edge angle threshold in degrees. Valid for 3D analysis only."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:61
msgid ""
"Use this control to split 3D patch segments. The edge angle is the angle "
"between adjacent surface segment edges sharing a node. If the edge angle is "
"larger than the specified threshold (VAL1), the segment splits and the node "
"is automatically treated as a node to be retained."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:65
msgid "Default: ``VAL1`` = 10."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:67
msgid ""
"Generally, a larger ``VAL1`` improves the quality of the new mesh, but may "
"result in loss of feature nodes. The effect is similar to that of boundary "
"angles ( ``Control`` = BDRA)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:73
msgid "``SRAT`` - The global sizing ratio. Valid for 2D and 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:75
msgid "``VAL1`` - The global sizing ratio for remeshing."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:77
msgid ""
"Default: ``VAL1`` = 1.0. The default value results in the new mesh having a "
"size similar to that of the original mesh."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:79
msgid ""
"Generally, set the value ( ``VAL1`` ) to >= 0.7. The model can be refined (<"
" 1.0) or coarsened (> 1.0) up to 3x depending on the mesh-sizing gradient "
"and number of 3D elements, and approximately 2x for 2D elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:83
msgid ""
"``VAL2`` - Same as ``VAL1``, except that ``VAL1`` controls remeshing to "
"remove distortion and ``VAL2`` controls element refinement. Default: "
"``VAL2`` = 0.75."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:89
msgid ""
"For more information about this control, see `Global Sizing Control "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnanewmesh.html#>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:92
msgid ""
"``GRAD`` - Adjusts the new mesh-sizing gradient during remeshing. Valid for "
"2D and 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:94
msgid ""
"Valid values: ``VAL1`` = 0, 1, 2, or 3. Default: ``VAL1`` = 2 for 2D "
"analysis, ``VAL1`` = 3 for 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:97
msgid ""
"``VAL1`` = 0 -- The mesh-sizing gradient is not retained. The new mesh is "
"uniform and has an approximate average size on the entire remeshed "
"domain(s), even if the original mesh has sizing gradients."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:100
msgid ""
"``VAL1`` = 1 -- The new mesh follows the original mesh-sizing gradient to "
"retain the element averaged-edge length. This value tends to coarsen the "
"mesh in the location of the distorted elements during remeshing."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:103
msgid ""
"``VAL1`` = 2 -- The new mesh follows the sizing gradient of the original "
"mesh, with additional sizing compensation based on the element size change "
"due to deformation during solution. This value tends to refine the mesh at "
"the location of the distorted elements, where the distortion may have "
"originated from deformation during solution."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:107
msgid ""
"``VAL1`` = 3 -- Similar to ``VAL1`` = 2, but assumes that perfect mesh "
"quality is not required, thus avoiding over-refinement of minor distorted "
"regions. Valid for 3D analysis only."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:110
msgid "For more information about this control, see."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:112
msgid ""
"``QTOL`` - The new mesh-acceptance tolerance ( ``PLANE182``, ``PLANE222``, "
"``SOLID187``, ``SOLID227``, and ``SOLID285`` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:115
msgid "``VAL1`` - Controls remeshing to remove distortion. Default: 0.05."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:117
msgid "``VAL2`` - Controls element refinement. Default: 0.5."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:119
msgid ""
"For ``PLANE182`` and ``PLANE222``, ``VAL2`` is the only valid option (for "
"mesh refinement), and the new mesh is accepted when ( MaxCornerAngleNew - "
"MaxCornerAngleOld ) / MaxCornerAngleOld <= ``QTOL``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:122
msgid ""
"For ``SOLID285``, the new mesh is accepted when ( SkewnessNew - SkewnessOld "
") / SkewnessOld <= ``QTOL``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:125
msgid ""
"For ``SOLID187`` and ``SOLID227``, the new mesh is accepted when, in "
"addition to skewness, ( JacobianOld - JacobianNew ) / JacobianOld <= "
"``QTOL``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:128
msgid ""
"The program uses both tolerance and mesh-quality parameters to determine "
"whether or not a new mesh is accepted."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:134
msgid ""
"``REFA`` - The refinement algorithm adjustment ( ``PLANE182``, ``PLANE222``,"
" and ``SOLID285`` ). Valid for 2D and 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:137
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:151
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:162
msgid "``VAL1`` -"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:139
msgid ""
"SPLIT - Use mesh `splitting "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnanewmesh.html#>`_"
" instead of general remeshing. This is the only valid value."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:143
msgid ""
"If not specified, mesh refinement occurs via general remeshing (except for "
"``PLANE183`` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:148
msgid ""
"``TCOR`` - Coordinate truncation adjustments for nodal locations of the "
"meshes during remeshing. Valid for 2D and 3D analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:153
msgid ""
"ON - Truncates the decimal value after the seventh position. Default "
"behavior for ``PLANE182``, ``PLANE222``, and ``SOLID285`` (augmented "
"Lagrange and penalty contact formulations only)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:155
msgid ""
"OFF - No truncation occurs on the decimal value. Default behavior for "
"``SOLID187`` and ``SOLID227`` (all contact formulations), and ``PLANE182`` "
"and ``PLANE222`` (Lagrange multiplier contact formulation only)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:158
msgid ""
"``AGGR`` - Aggressive remeshing. Creates meshes with improved shape metrics."
" May change some global remeshing control parameters applied by other "
":ref:`nlmesh` commands, and may increase remeshing time. Valid for both 2D "
"and 3D nonlinear adaptivity analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:164
msgid "ON - Enable aggressive remeshing."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:165
msgid "OFF - Disable aggressive remeshing (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:166
msgid ""
"``ELSZ`` - Reduces the set of remeshable (seed) elements used for remeshing "
"by filtering out elements based on their size, preventing over- or under-"
"refinement in the remeshing regions. Valid only in `general remeshing "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnanewmesh.html#nladsimultaneous>`_"
" using an energy -, position-, or `contact "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnacriteria.html#advczmcriterion>`_"
" -based refinement criterion."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:174
msgid ""
"``Val1`` is a user-defined lower bound of the element size, and ``Val2`` is "
"a user-defined upper bound of the element size. If both are specified, seed "
"elements selected via the specified criterion are filtered out if their size"
" is < ``Val1`` or > ``Val2``. If ``Val1`` is unspecified, only the size "
"check with ``Val2`` occurs. If ``Val2`` is unspecified, only the size check "
"with ``Val1`` occurs."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:180
msgid ""
"``NSTR`` - Reduces the set of remeshable (seed) elements used for remeshing "
"by filtering out elements based on their (maximum) equivalent stress level, "
"preventing over- or under-refinement in the remeshing regions based on the "
"stress state. Valid only in `general remeshing "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnanewmesh.html#nladsimultaneous>`_"
" using an energy -, position-, or `contact "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnacriteria.html#advczmcriterion>`_"
" -based refinement criterion."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:188
msgid ""
"``Val1`` is a user-defined lower bound of element equivalent stress, and "
"``Val2`` is a user-defined upper bound of the element equivalent stress. If "
"both are specified, seed elements selected by the specified criterion are "
"filtered out if their (maximum) equivalent stress is < ``Val1`` or > "
"``Val2``. If ``Val1`` is unspecified, only the equivalent stress check with "
"``Val2`` occurs. If ``Val2`` is unspecified, only the equivalent stress "
"check with ``Val1`` occurs."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:194
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:210
msgid ""
"**Important:** Before specifying this option, copy the integration-point "
"results to the nodes ( :ref:`eresx`,NO)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:196
msgid ""
"``NSTN`` - Reduces the set of remeshable (seed) elements used for remeshing "
"by filtering out elements based on their (maximum) equivalent strain level, "
"preventing over- or under-refinement in the remeshing regions based on the "
"strain state. Valid only in `general remeshing "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnanewmesh.html#nladsimultaneous>`_"
" using an energy -, position-, or `contact "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnacriteria.html#advczmcriterion>`_"
" -based refinement criterion."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:204
msgid ""
"``Val1`` is a user-defined lower bound of the element equivalent strain, and"
" ``Val2`` is a user- defined upper bound of the element equivalent strain. "
"If both are specified, seed elements selected by the specified criterion are"
" filtered out if their (maximum) equivalent strain is < ``Val1`` or > "
"``Val2``. If ``Val1`` is unspecified, only the equivalent strain check with "
"``Val2`` occurs. If ``Val2`` is unspecified then only the equivalent strain "
"check with ``Val1`` occurs."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:212
msgid "``LIST`` - Lists all mesh-quality control parameters."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:214
msgid ""
"If ``VAL1`` has been specified for a given mesh control, the most recently "
"specified value is listed. If a value was not explicitly specified, the "
"default value is listed (assuming that the problem has been solved at least "
"once)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:219
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:225
msgid ""
"Numerical input value that varies according to the specified ``Control`` "
"option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:221
msgid ""
"Valid for all ``Control`` options. Can be used when controlling remeshing "
"for both distortion removal and for element refinement."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:227
msgid ""
"Valid only for these ``Control`` options: NLAY, SRAT, and QTOL. Also used "
"for controlling remeshing for element refinement."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:244
msgid ""
":ref:`nlmesh` is a global control command enabling mesh-quality adjustments "
"for remeshing in `nonlinear adaptivity "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/advmnaexample.html>`_."
" The command can be used when components are associated with mesh-quality "
"criteria ( :ref:`nladaptive` with ``Criterion`` = MESH, or another criterion"
" with mesh change through general refinement)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlmesh:250
msgid ""
"Issue the :ref:`nlmesh` command only in cases where advanced mesh-quality "
"control is desirable for remeshing in nonlinear adaptivity. The control "
"values specified apply to all components having mesh- quality-based criteria"
" defined, or components having mesh change through general refinement, and "
"can be modified at every load step during the nonlinear adaptive solution or"
" when performing a restart analysis."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.nropt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:2
msgid ""
"Specifies the Newton-Raphson options in a static or full transient analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:4
msgid ""
"Mechanical APDL Command: `NROPT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NROPT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:11
msgid "``AUTO`` - Let the program choose the option (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:13
msgid "``FULL`` - Use full Newton-Raphson."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:15
msgid "``MODI`` - Use modified Newton-Raphson."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:17
msgid "``INIT`` - Use the previously computed matrix (initial-stiffness)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:19
msgid ""
"``UNSYM`` - Use full Newton-Raphson with unsymmetric matrices of elements "
"where the unsymmetric option exists."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:25
msgid ""
"``CRPL`` - When applicable in a static creep analysis, activates modified "
"Newton-Raphson with a creep-ratio limit. Valid only when ``Option1`` = AUTO."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:28
msgid "**optval** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:29
msgid ""
"If ``Option2`` is blank, ``Optval`` is the Adaptive Descent Key ( ``Adptky``"
" ):"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:31
msgid ""
"``ON`` - Use adaptive descent (default if frictional contact exists). "
"Explicit ON is valid only if ``Option`` = FULL."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:34
msgid "``OFF`` - Do not use adaptive descent (default in all other cases)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:36
msgid "If ``Option2`` = CRPL, ``Optval`` is the creep ratio limit:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:38
msgid ""
"``CRLIMIT`` - The creep ratio limit for use with the modified Newton-Raphson"
" procedure. Valid only when ``Option1`` = AUTO (default) and ``Option2`` = "
"CRPL. Typically, this value should not exceed 0.15 in order to make the "
"modified Newton-Raphson solution converge efficiently. For more information "
"about the creep ratio limit, see the :ref:`cutcontrol` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:57
msgid ""
"The :ref:`nropt` command specifies the Newton-Raphson option used to solve "
"the nonlinear equations in a static or full transient analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:60
msgid ""
"The automatic modified Newton-Raphson procedure with creep-ratio limit "
"control ( :ref:`nropt`,AUTO,CRPL, ``CRLIMIT`` ) applies to static creep "
"analysis only. When the creep ratio is smaller than the value of the creep "
"ratio limit specified, the modified Newton-Raphson procedure is used. If "
"convergence difficulty occurs during solution, use the full Newton-Raphson "
"procedure."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:65
msgid ""
"The command :ref:`nropt`,UNSYM is also valid in a linear non-prestressed "
"modal analysis that is used to perform a brake squeal analysis. In this "
"special case, the command is used only to generate the unsymmetric stiffness"
" matrix; no Newton-Raphson iterations are performed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:69
msgid ""
":ref:`nropt`,MODI and :ref:`nropt`,INIT are only applicable with the sparse "
"solver ( :ref:`eqslv`,SPARSE). Thermal analyses will always use full Newton-"
"Raphson irrespective of the ``Option1`` value selected."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:73
msgid ""
"See Newton-Raphson Option in the `Structural Analysis Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_str/str_enercalc_app.html>`_"
" for more information."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:79
msgid "**Switching Between the Symmetric and Unsymmetric Option**"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:81
msgid ""
"Normally, switching from the symmetric Newton-Raphson option ( "
":ref:`nropt`,FULL) to the unsymmetric option ( :ref:`nropt`,UNSYM) or from "
"the unsymmetric option to the symmetric option is allowed between load steps"
" within the same analysis type. This is applicable to linear and nonlinear, "
"static and full transient analyses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:86
msgid ""
"Under the following circumstances, the solution could be slightly different "
"or inaccurate if you switch from symmetric to unsymmetric or vice versa:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:89
msgid ""
"The underlying elements or materials are unsymmetric by their mathematical "
"definition, and you switch from unsymmetric to symmetric."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:92
msgid ""
"You change analysis types and also switch from symmetric to unsymmetric (or "
"vise versa) at the same time. This situation could result in failures such "
"as data corruption or a core dump and should therefore be avoided."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:96
msgid ""
"In some rare cases, switching between the symmetric and unsymmetric options "
"can cause a system core dump when reading/writing the :file:`.ESAV` or "
":file:`.OSAV` file, and the analysis terminates. Typically, this happens "
"when the record length of the element nonlinear saved variables cannot be "
"altered between load steps by their mathematical definition."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:101
msgid ""
"If all the elements and the material are symmetric by their mathematical "
"definition and you use the unsymmetric option, the solution accuracy is the "
"same as the symmetric option. However, the analysis will run twice as slow "
"as the symmetric case."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nropt:105
msgid ""
"In a static or full transient linear perturbation base analysis, be aware "
"that if the unsymmetric Newton-Raphson procedure is used, you must specify "
"the UNSYM or DAMP eigensolver option in the downstream modal analysis, which"
" may be more expensive than symmetric modal analysis."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.pred"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:2
msgid "Activates a predictor in a nonlinear analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:4
msgid ""
"Mechanical APDL Command: `PRED "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_PRED.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:10
msgid ""
"The default command behavior is to use prediction ( ``Sskey`` = AUTO). The "
"AUTO option chooses to either use the linear predictor or to turn the "
"predictor OFF. However, prediction does not occur if one or more of these "
"conditions exist:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:14
msgid ""
"Over prediction occurs due to a large residual force or excessive element "
"distortion."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:16
msgid ""
"You are mapping ( :ref:`mapsolve` ) variables to a new mesh during `rezoning"
" "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_nlad/Hlp_G_ADVRZSMP.html>`_."
" (Prediction does not occur for any :ref:`mapsolve` substeps, nor for the "
"first substep afterwards.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:21
msgid ""
"You have steady-state analysis defined ( :ref:`sstate` ), and contact "
"elements exist in the model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:25
msgid "**sskey** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:26
msgid "Substep predictor key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:28
msgid ""
"``AUTO`` - The program uses a predictor but, within certain exceptions, "
"automatically switches prediction off. This behavior is the default; see "
":ref:`PRED_default` for details."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:31
msgid "``OFF`` - No prediction occurs."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:33
msgid ""
"``LINEAR (or ON)`` - Use the linear predictor on all substeps after the "
"first."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:35
msgid ""
"``QUADRATIC`` - Use the quadratic predictor on all substeps after the "
"second."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:37
msgid "**lskey** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:38
msgid "Load step predictor:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:40
msgid ""
"``OFF`` - No prediction across load steps occurs. This is the default "
"behavior."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:42
msgid ""
"``ON`` - Use a predictor also on the first substep of the load step. ( "
"``Sskey`` = ON is required.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:59
msgid ""
"Activates a predictor in a nonlinear analysis on the degree-of-freedom "
"solution for the first equilibrium iteration of each substep."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:62
msgid ""
"When using the arc-length method ( :ref:`arclen`, :ref:`arctrm` ), you "
"cannot issue the DOF solution predictor command ( :ref:`pred` ), the "
"automatic time stepping command ( :ref:`autots` ), or the line search "
"command ( :ref:`lnsrch` ). If you activate the arc-length method after you "
"set :ref:`pred`, :ref:`autots`, or :ref:`lnsrch`, a warning message appears."
" If you elect to proceed with the arc-length method, the program disables "
"your DOF predictor, automatic time stepping, and line search settings, and "
"the time step size is controlled by the arc-length method internally."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:69
msgid ""
"When using step-applied loads, such as :ref:`tunif`, :ref:`bfunif`, etc., or"
" other types of non- monotonic loads, the predictor may adversely affect the"
" convergence. If the solution is discontinuous, the predictor may need to be"
" turned off."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pred:73
msgid ""
"When performing a nonlinear analysis involving large rotations, the "
"predictor may require using smaller substeps. If the model has rotational "
"degrees-of-freedom, the quadratic predictor could work more efficiently than"
" the linear predictor."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.pstres"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:2
msgid "Specifies whether prestress effects are calculated or included."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:4
msgid ""
"Mechanical APDL Command: `PSTRES "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_PSTRES.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:9
msgid "Prestress key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:11
msgid "``OFF`` - Do not calculate (or include) prestress effects (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:13
msgid "``ON`` - Calculate (or include) prestress effects."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:29
msgid ""
"The :ref:`pstres` command specifies whether or not prestress effects are to "
"be calculated or included. The command should be issued after the "
":ref:`antype` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:32
msgid ""
"Prestress effects are calculated in a static or transient analysis for "
"inclusion in a buckling, modal, harmonic (Method = FULL), or substructure "
"generation analysis. If used in the solution processor ( :ref:`slashsolu` ),"
" this command is valid only within the first load step."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:36
msgid ""
"If you apply thermal body forces during a static analysis to calculate "
"prestress effects, do not delete the forces during any subsequent full "
"harmonic analyses. If you delete the thermal body forces, the thermal "
"prestress effects will not be included in the harmonic analysis. Temperature"
" loads used to define the thermal prestress will also be used in the full "
"harmonic analysis as sinusoidally time-varying temperature loads."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:42
msgid ""
"A prestress effect applied with non-follower loads resists rigid body "
"rotation of the model. For example, an unsupported beam with axial tensile "
"forces applied to both ends will have two nonzero rotational rigid body "
"modes."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.pstres:46
msgid ""
"If tabular loading ( :ref:`dim`, TABLE ) was used in the prestress static "
"analysis step, the corresponding value of :ref:`time` will be used for "
"tabular evaluations in the modal analysis."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.semiimplicit"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:2
msgid "Specifies parameters for a semi-implicit solution."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:4
msgid ""
"Mechanical APDL Command: `SEMIIMPLICIT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SEMI.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:11
msgid ""
"``ETOI`` - Criterion for transitioning from the semi-implicit solution phase"
" to the implicit solution phase."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:14
msgid ""
"``MSCA`` - Selective mass scaling factor used during the semi-implicit "
"solution phase."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:16
msgid ""
"``SFAC`` - Safety factor for time incrementation used during the semi-"
"implicit solution phase."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:18
msgid ""
"``AUTS`` - Automatic time stepping and bisection controls used during the "
"semi-implicit solution phase."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:21
msgid ""
"``BVIS`` - Bulk viscosity controls used during the semi-implicit solution "
"phase."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:23
msgid ""
"``EFRQ`` - Output and restart file frequency used during the semi-implicit "
"solution phase."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:26
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:16
msgid ""
"Additional input; varies depending on the ``Option`` value. See table below."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:29
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:19
msgid ""
"Additional input; varies depending on the ``Option`` and ``Type`` values. "
"See table below."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:45
msgid ""
"This command triggers a `semi-implicit solution scheme "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_adv/semi_limitations.html>`_"
" in which the analysis transitions to a semi-implicit solution method when "
"the implicit solution method fails to converge. The command is valid only in"
" the solution processor ( :ref:`slashsolu` ) and must be defined before the "
"first :ref:`solve` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:51
msgid ""
"The :ref:`semiimplicit` command can be used in a restart, even if the base "
"analysis did not include the command. Therefore, a problem that failed in "
"the implicit analysis can be restarted with this command so that it can "
"transition to the semi-implicit method and solve further."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.semiimplicit:55
msgid ""
"The :ref:`semiimplicit` command can overwrite the values on some commands, "
"as described in the following table."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.soloption"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:2
msgid "Specifies solution transition options."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:4
msgid ""
"Mechanical APDL Command: `SOLOPTION "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SOLO.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:9
msgid "Transition option:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:11
msgid ""
"``STOT`` - Use criterion for transitioning from a static solution to a "
"transient dynamic solution."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:13
msgid ""
"``TTOS`` - Use criterion for transitioning from a transient dynamic solution"
" to a static solution."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:35
msgid ""
"This command triggers an automatic transition from a static solution to a "
"transient solution based on the specified criterion. The command is valid "
"only in the solution processor ( :ref:`slashsolu` ) and must be defined "
"either before the first :ref:`solve` command or during a restart analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:39
msgid ""
"If :ref:`soloption` is issued with no arguments specified, the static "
"solution will transition to a quasi-static transient solution if the static "
"solution fails to converge (that is, :ref:`soloption`,STOT,CONV,QUASI)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:43
msgid ""
":ref:`soloption` can be used in a restart even if the base analysis did not "
"include the command. Therefore, a problem that failed in the static analysis"
" can be restarted using this command so that it transitions to a transient "
"solution and solves further. Material densities are required for the "
"transient solution, but they must be defined during the static solution "
"since the restart framework does not permit material density to be defined "
"in the restart analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.soloption:49
msgid ""
"For more information on using :ref:`soloption`, see `Automatic Transition "
"Between Static and Transient Solutions "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_adv/solutran_limitations.html>`_"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.ssopt.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.ssopt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.ssopt:2
msgid "Defines a solution option for soil analysis."
msgstr ""

