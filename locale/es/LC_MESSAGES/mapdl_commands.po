#: ../../pymapdl/doc/source/mapdl_commands/prep7/areas.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:2
msgid "Calculates and prints geometry statistics of the selected areas."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:4
msgid ""
"Mechanical APDL Command: `ASUM "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_ASUM.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/volumes.pydocstring of
#: ansys.mapdl.core._commands.prep7.volumes.Volumes.vsum:9
msgid ""
"Controls the degree of tessellation used in the calculation of area "
"properties. If ``LAB`` = DEFAULT, area calculations will use the degree of "
"tessellation set through the :ref:`facet` command. If ``LAB`` = FINE, area "
"calculations are based on a finer tessellation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:27
msgid ""
"Calculates and prints geometry statistics (area, centroid location, moments "
"of inertia, volume, etc.) associated with the selected areas. :ref:`asum` "
"should only be used on perfectly flat areas."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:30
msgid ""
"Geometry items are reported in the global Cartesian coordinate system. A "
"unit thickness is assumed unless the areas have a non-zero total thickness "
"defined by real constant or section data."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:33
msgid ""
"For layered areas, a unit density is always assumed. For single-layer areas,"
" a unit density is assumed unless the areas have a valid material (density)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:36
msgid ""
"The thickness and density are associated to the areas via the :ref:`aatt` "
"command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:38
msgid ""
"Items calculated via :ref:`asum` and later retrieved via a :ref:`get` or "
":ref:`starvget` command are valid only if the model is not modified after "
"issuing the :ref:`asum` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:41
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/volumes.pydocstring of
#: ansys.mapdl.core._commands.prep7.volumes.Volumes.vsum:33
msgid ""
"Setting a finer degree of tessellation will provide area calculations with "
"greater accuracy, especially for thin, hollow models. However, using a finer"
" degree of tessellation requires longer processing."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/areas.pydocstring of
#: ansys.mapdl.core._commands.prep7.areas.Areas.asum:45
msgid ""
"For very narrow (sliver) areas, such that the ratio of the minimum to the "
"maximum dimension is less than 0.01, the :ref:`asum` command can provide "
"erroneous area information. To ensure that the calculations are accurate, "
"subdivide such areas so that the ratio of the minimum to the maximum is at "
"least 0.05."
msgstr ""

