#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:4
msgid ""
"Mechanical APDL Command: `/REPLOT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_REPLOT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:9
msgid "Controls the type of replot."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:11
msgid ""
"``RESIZE`` - Issued internally when a graphics window resize occurs "
"(Default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:13
msgid ""
"``FAST`` - Only applicable for 3D devices that allow a fast redisplay for "
"changes in the view characteristics only."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:30
msgid ""
"Reissues the last display command ( :ref:`nplot`, :ref:`eplot`, "
":ref:`kplot`, :ref:`plnsol`, :ref:`plvar`, etc.), along with its parameters,"
" for convenience. The current display specifications are used."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:34
msgid ""
"When the last display command is invalid in a given processor, :ref:`replot`"
" is also invalid in that processor. However, if you attempt a :ref:`replot` "
"and the last display command is invalid in the current processor, Mechanical"
" APDL generates an element display ( :ref:`eplot` ) instead, as long as the "
"last display command was  :ref:`plnsol`, :ref:`plesol`, or  :ref:`pldisp`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:40
msgid "Example: :ref:`replot` Replaced by :ref:`eplot` Automatically"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:42
msgid ""
":ref:`plnsol`, used to display solution results as continuous contours, is a"
" valid command in the POST1 general postprocessor."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:45
msgid ""
"If you issue :ref:`plnsol` followed by :ref:`replot` while in POST1, "
":ref:`replot` effectively reissues your earlier :ref:`plnsol` command, along"
" with its parameters."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:48
msgid ""
"If you then exit POST1, enter the PREP7 preprocessor, and again issue "
":ref:`replot`, the program uses :ref:`eplot` internally instead."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:51
msgid ""
"The command substitution occurs because :ref:`plnsol` is not a valid command"
" in PREP7."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:53
msgid ""
"When you click one of the buttons on the `Pan, Zoom, Rotate "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_wid/Hlp_UI_PanZoom.html#wpanzoomk>`_"
" dialog box to manipulate the view of a model, :ref:`replot` is issued "
"internally. Thus, the substitution of :ref:`replot` with :ref:`eplot` as "
"described above may also occur for operations that you perform via with the "
"`Pan, Zoom, Rotate "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_wid/Hlp_UI_PanZoom.html#wpanzoomk>`_"
" dialog box."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:61
msgid ""
":ref:`replot` does not show boundary conditions if they are applied only to "
"a solid model and the last display command (such as :ref:`eplot` ) displays "
"the finite element model. To show boundary conditions, the following options"
" are available:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:65
msgid ""
"Issue :ref:`replot` after you issue :ref:`sbctran` to transfer solid model "
"boundary conditions to the finite element model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:68
msgid ""
"Issue :ref:`replot` after you issue a solid model display command (such as "
":ref:`vplot` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.replot:70
msgid "This command is valid in any processor (except as noted above)."
msgstr ""

