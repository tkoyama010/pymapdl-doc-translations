#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.octable:55
msgid "You can define the following ocean data types:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:80
msgid ""
"For a better understanding of how to set up a basic ocean type, see "
":ref:`ocdatafigbasic`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:82
msgid ""
"``VAL1`` - ``DEPTH`` -- The depth of the ocean (that is, the distance "
"between the mean sea level and the mud line). The water surface is assumed "
"to be level in the XY plane, with Z being positive upwards. This value is "
"required and must be positive."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:86
msgid ""
"``VAL2`` - ``MATOC`` -- The material number of the ocean. This value is "
"required and is used to input the required density. It is also used to input"
" the viscosity if the Reynolds number is used ( :ref:`octable` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:90
msgid "``VAL3`` - ``KFLOOD`` -- The inside-outside fluid-interaction key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:92
msgid ""
"0 -- The density and pressure of fluid inside and outside of the pipe "
"element ( ``PIPE288`` or ``PIPE289`` ) are independent of each other. This "
"behavior is the default."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:94
msgid ""
"1 -- The density and pressure of fluid inside of the pipe element ( "
"``PIPE288`` or ``PIPE289`` ) are set to equal the values outside of the pipe"
" element."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:97
msgid ""
"For beam subtype CTUBE and HREC used with ``BEAM188`` or ``BEAM189`` and "
"ocean loading, ``KFLOOD`` is always set to 1."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:100
msgid ""
"``VAL4`` - ``Cay`` -- The ratio of added mass of the external fluid over the"
" mass of the fluid displaced by the element cross section in the y direction"
" (normal). The added mass represents the mass of the external fluid (ocean "
"water) that moves with the pipe, beam, or link element when the element "
"moves in the element y direction during a dynamic analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:105
msgid ""
"If no value is specified, and the coefficient of inertia ``CMy`` is not "
"specified ( :ref:`octable` ), both values default to 0.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:108
msgid ""
"If no value is specified, but ``CMy``  is specified, this value defaults to "
"``Cay`` = ``CMy`` - 1.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:110
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:124
msgid "If this value should be 0.0, enter 0.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:112
msgid ""
"``VAL5`` - ``Caz`` -- The ratio of added mass of the external fluid over the"
" mass of a cross section in the element z direction (normal). The added mass"
" represents the mass of the external fluid (ocean water) that moves with the"
" pipe, beam, or link element when the element moves in the element z "
"direction during a dynamic analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:117
msgid ""
"If no value is specified, and Cay is specified, this value defaults to Cay."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:119
msgid ""
"If no value is specified, and the coefficient of inertia ``CMz`` is not "
"specified ( :ref:`octable` ), both values default to 0.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:122
msgid ""
"If no value is specified, but ``CMz``  is specified, this value defaults to "
"``Cay`` = ``CMz`` - 1.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:126
msgid ""
"``VAL6`` - ``Cb`` -- The ratio of buoyancy force used over buoyancy force "
"based on the outside diameter and water density. Accept the default value in"
" most cases. Adjust this option only when you must account for additional "
"hardware (such as a control valve) attached to the pipe exterior. A non- "
"default value may lead to small non-physical inconsistencies; testing is "
"therefore recommended for non-default values."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:132
msgid "If no value is specified, this value defaults to 1.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:134
msgid ""
"If this value should be 0.0 (useful when troubleshooting your input), enter "
"0.0."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:136
msgid ""
"``VAL7`` - ``Zmsl`` -- A vertical offset from the global origin to the mean "
"sea level. The default"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:137
msgid "value is"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:138
msgid "zero (meaning that the origin is located at the mean sea level)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:140
msgid "Two example cases for ``Zmsl`` are:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:142
msgid "A structure with its origin on the sea floor ( ``Zmsl`` = ``DEPTH`` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:144
msgid ""
"A tidal change ( ``tc`` ) above the mean sea level ( ``Zmsl`` = ``tc``, and "
"``DEPTH`` becomes ``DEPTH`` + ``tc`` )"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:147
msgid ""
"``VAL8`` - ``Ktable`` -- The dependency of ``VAL1`` on the :ref:`octable` "
"command:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:149
msgid ""
"Z (or 1) -- Values on the :ref:`octable` command depend on the Z levels "
"(default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:150
msgid ""
"RE (or 2) -- Values on the :ref:`octable` command depend on the Reynolds "
"number."
msgstr ""

