#: of
#: ansys.mapdl.core._commands.solution.fe_surface_loads.FeSurfaceLoads.sfe:212
msgid "0 - Pressure loading occurs on the current mesh (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/fe_surface_loads.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.fe_surface_loads.FeSurfaceLoads.sf:148
