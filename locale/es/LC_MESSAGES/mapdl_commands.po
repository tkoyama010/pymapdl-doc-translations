"Mechanical APDL Command: `BCSOPTION "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_BCSOPTION.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.bcsoption:10
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.dspoption:10
