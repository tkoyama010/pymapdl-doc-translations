msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/morphing.pydocstring of
#: ansys.mapdl.core._commands.prep7.morphing.Morphing.morph:85
msgid "Diffusion ``PLANE238``, ``SOLID239``, and ``SOLID240``,"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/morphing.pydocstring of
#: ansys.mapdl.core._commands.prep7.morphing.Morphing.morph:87
msgid ""
"Coupled-field ``PLANE222``, ``PLANE223``, ``SOLID225``, ``SOLID226``, and "
"``SOLID227`` with no structural degrees of freedom."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/morphing.pydocstring of
#: ansys.mapdl.core._commands.prep7.morphing.Morphing.morph:90
msgid ""
"The following structural elements types are supported by ``StrOpt`` = YES:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/morphing.pydocstring of
#: ansys.mapdl.core._commands.prep7.morphing.Morphing.morph:92
msgid ""
"``PLANE182``, ``PLANE183``, ``SOLID185``, ``SOLID186``, ``SOLID187``, "
"``SOLSH190``,"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/morphing.pydocstring of
#: ansys.mapdl.core._commands.prep7.morphing.Morphing.morph:94
msgid ""
"Coupled-field ``PLANE222``, ``PLANE223``, ``SOLID225``, ``SOLID226``, and "
