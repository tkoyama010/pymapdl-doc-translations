#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.slashreset:4
msgid ""
"Mechanical APDL Command: `/RESET "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_RESET_sl.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.slashreset:21
msgid ""
"Resets slash display specifications ( :ref:`window`, :ref:`slashtype`, "
":ref:`view`, etc.) back to their initial default settings (for convenience)."
" Also resets the focus location to the geometric center of the object."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.set_up.SetUp.tiff.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.set\\_up.SetUp.tiff"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/set_up.rst:44:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.tiff:2
msgid "Provides TIFF file export for Mechanical APDL displays."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.tiff:4
msgid ""
"Mechanical APDL Command: `TIFF "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TIFF.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.tiff:9
msgid "Specifies various TIFF file export options."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.tiff:11
msgid ""
"``COMP`` - If ``Kywrd`` = COMP, then ``OPT`` controls data compression for "
"the output file. If COMP = 0, then compression is off. If COMP = 1 "
"(default), then compression is on."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
