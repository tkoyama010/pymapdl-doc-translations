#: ../../pymapdl/doc/source/mapdl_commands/graphics/views.rst:28:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/views.pydocstring of
#: ansys.mapdl.core._commands.graphics.views.Views.angle:2
