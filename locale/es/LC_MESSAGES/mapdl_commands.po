msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:9
msgid "Matrix reform option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:11
msgid ""
"``FULL`` - Use the full Newton-Raphson solution option (default). All "
"subsequent input values are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:14
msgid ""
"``QUASI`` - Use a selective reform solution option based on ``REFORMTOL``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:16
msgid "**reformtol** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:17
msgid ""
"Property change tolerance for Matrix Reformation (.05 default). The thermal "
"matrices are reformed if the maximum material property change in an element "
"(from the previous reform time) is greater than the reform tolerance. Valid "
"only when ``Refopt`` = QUASI."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:21
msgid "**ntabpoints** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:22
msgid ""
"Number of points in Fast Material Table (64 default). Valid only when "
"``Refopt`` = QUASI."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:24
msgid "**tempmin** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:25
msgid ""
"Minimum temperature for Fast Material Table. Defaults to the minimum "
"temperature defined by the :ref:`mptemp` command for any material property "
"defined. Valid only when ``Refopt`` = QUASI."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:28
msgid "**tempmax** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:29
msgid ""
"Maximum temperature for Fast Material Table. Defaults to the maximum "
"temperature defined by the :ref:`mptemp` command for any material property "
"defined. Valid only when ``Refopt`` = QUASI."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:32
msgid "**algo** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:33
msgid "Specifies which solution algorithm to apply:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:35
msgid "``0`` - Multipass (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:37
msgid "``1`` - Iterative."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:39
msgid "Valid only when ``Refopt`` = QUASI."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:55
msgid ""
"The QUASI matrix reform option is supported by the ICCG, JCG, PCG, and "
"sparse solvers only ( :ref:`eqslv` ). The Quasi method is an approximation "
"to the FULL method and will not be as accurate when the nonlinearity is "
"strong. However, you can control the inaccuracy by using small time steps."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:59
msgid "For ``Refopt`` = QUASI:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:61
msgid ""
"Results from a restart may be different than results from a single run "
"because the stiffness matrices are always recreated in a restart run, but "
"may or may not be in a single run (depending on the behavior resulting from "
"the ``REFORMTOL`` setting). Additionally, results may differ between two "
"single runs as well, if the matrices are reformed as a result of the "
"``REFORMTOL`` setting."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.thopt:67
msgid ""
"For more information, see `Solution Algorithms Used in Transient Thermal "
"Analysis "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_the/thermsolualgors.html#therm_fullquasirad>`_"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.toffst.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.analysis\\_options.AnalysisOptions.toffst"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/analysis_options.rst:70:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.toffst:2
msgid "Specifies the temperature offset from absolute zero to zero."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.toffst:4
msgid ""
"Mechanical APDL Command: `TOFFST "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TOFFST.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.toffst:9
msgid ""
"Degrees between absolute zero and zero of temperature system used (should be"
" positive)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.toffst:25
msgid ""
"Specifies the difference (in degrees) between absolute zero and the zero of "
"the temperature system used. Absolute temperature values are required in "
"evaluating certain expressions, such as for creep, swelling, radiation heat "
"transfer, ``MASS71``, etc. (The offset temperature is not used in evaluating"
" emissivity.) Examples are 460° for the Fahrenheit system and 273° for the "
"Celsius system. The offset temperature is internally included in the element"
" calculations and does not affect the temperature input or output. If used "
"in SOLUTION, this command is valid only within the first load step."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.birth_and_death.BirthAndDeath.ealive.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.birth\\_and\\_death.BirthAndDeath.ealive"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/birth_and_death.rst:21:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/birth_and_death.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.birth_and_death.BirthAndDeath.ealive:2
msgid "Reactivates an element (for the birth and death capability)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/birth_and_death.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.birth_and_death.BirthAndDeath.ealive:4
msgid ""
"Mechanical APDL Command: `EALIVE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_EALIVE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/birth_and_death.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.birth_and_death.BirthAndDeath.ealive:9
msgid ""
"Element to be reactivated. If ALL, reactivate all selected elements ( "
":ref:`esel` ). If ``ELEM`` = P, graphical picking is enabled and all "
"remaining command fields are ignored (valid only in the GUI). A component "
"name may also be substituted for ``ELEM``. To specify a table, enclose the "
"table name in percent signs (%), e.g. :ref:`ealive`,``tabname``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/birth_and_death.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.birth_and_death.BirthAndDeath.ealive:28
msgid ""
"Reactivates the specified element when the birth and death capability is "
"being used. An element can be reactivated only after it has been deactivated"
" ( :ref:`ekill` )."
