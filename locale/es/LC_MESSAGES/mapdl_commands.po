#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.resp:25
msgid "``0 or 1`` - Displacement (relative to base excitation)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.resp:27
msgid "``2`` - Velocity (relative to base excitation)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.resp:29
msgid "``3`` - Acceleration response spectrum (absolute)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.resp:31
msgid "``4`` - Pseudo-velocity"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.resp:33
msgid "``5`` - Pseudo-acceleration"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.resp:35
