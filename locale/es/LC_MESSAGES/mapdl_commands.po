"Axisymmetric harmonic element results are not supported for ``Type`` = AXIS."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.slashexpand:194
