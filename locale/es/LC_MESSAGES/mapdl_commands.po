#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.rsplit:23
msgid ""
"``ALL`` - Use all selected element components ( :ref:`cmsel` ) (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
