#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:73
msgid ""
"PC: The values are encoded in a PC logical font structure. Value 1 is a "
"character string, and the remaining values are integers:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:76
msgid ""
"``Val1`` - Family name (for example, Courier\\2New) Substitute an asterisk "
"(\\2) for any blank character that appears in a family name. If ``Val1`` = "
"MENU, all other values are ignored and a font selection menu appears (GUI "
"must be active). When this value is blank, Mechanical APDL uses the first "
"available resource it finds."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:81
msgid "``Val2`` - Weight (0 - 1000)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:83
msgid "``Val3`` - Orientation (in tenths of a degree)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:85
msgid "``Val4`` - Height (in logical units)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:87
msgid "``Val5`` - Width (in logical units)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:89
msgid "``Val6`` - Italics (0 = OFF, 1 = ON)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:91
msgid ""
"``TEXT`` - Text size specification for the Mechanical APDL graphics window. "
"Using this label with the :ref:`device` command requires the following form:"
" :ref:`device`,TEXT, ``KEY``, ``PERCENT``. ``KEY`` = 1 for LEGEND fonts; "
"``KEY`` = 2 for ENTITY fonts. ``PERCENT`` specifies the new text size as a "
"percent of the default text size. If ``PERCENT`` = 100, the new text size is"
" precisely the default size. If ``PERCENT`` = 200, the new text size is "
"twice the default text size."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:98
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
