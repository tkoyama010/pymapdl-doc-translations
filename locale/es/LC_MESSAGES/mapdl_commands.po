msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post26/display.rst:24:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/display.pydocstring of
#: ansys.mapdl.core._commands.post26.display.Display.keep:2
