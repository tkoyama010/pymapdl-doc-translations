"1.0 for temperature (TEMP) when the iterative QUASI solver is used ( "
":ref:`thopt`,QUASI,,,,,,,1)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:110
msgid "1.0 for energy error convergence (ENGY)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
