"to 1.0, that is, use scale factor as automatically calculated)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/scaling.pydocstring
#: of ansys.mapdl.core._commands.graphics.scaling.Scaling.vscale:16
msgid "Relative scaling key:"
msgstr ""

