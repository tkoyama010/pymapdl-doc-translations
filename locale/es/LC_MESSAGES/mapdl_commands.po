"(one at the tip and two on each face)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/_special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1._special_purpose.SpecialPurpose.kcalc:29
