msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.prcamp:42
msgid "Flag to print the stability values:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.prcamp:44
msgid ""
"``0 (OFF, or NO)`` - Print the frequencies (the imaginary parts of the "
"eigenvalues in Hz). This value is the default."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.prcamp:47
msgid ""
"``1 (ON, or YES)`` - Print the stability values (the real parts of the "
"eigenvalues in Hz)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.prcamp:49
msgid ""
"``2`` - Print the inverse of the logarithmic decrements. A negative "
"logarithmic decrement indicates stable motion."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.prcamp:52
msgid ""
"``3`` - Print the logarithmic decrements. A positive logarithmic decrement "
"indicates stable motion and is consistent with API (American Petroleum "
"Institute) standards."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.prcamp:61
msgid "Key to specify if all frequencies above FREQB are printed out:"
msgstr ""

