#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:11
msgid ""
"``ELEM`` - Elements. Use ``N1``, ``N2``, ``NINC`` fields for element "
"numbers."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.color:32
msgid ""
"``LINE`` - Solid model lines. Use ``N1``, ``N2``, ``NINC`` fields for line "
"numbers."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.color:34
