msgid ""
"Node location in the active coordinate system (R, θ, Z for cylindrical, R, "
"θ, Φ for spherical or toroidal). If ``X`` = P, graphical picking is enabled "
"and all remaining command fields are ignored (valid only in the GUI)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.n:28
msgid "First rotation about nodal Z (positive X toward Y)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
