msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.slashexpand:183
msgid "It does not support solid model entities."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.slashexpand:185
msgid ""
"POLAR, FULL or HALF operations are meaningful only in global cylindrical "
"systems and are unaffected by the :ref:`rsys` or :ref:`dsys` commands. "
"Cartesian symmetry or unsymmetric operations also occur about the global "
"Cartesian system."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.slashexpand:189
