"``NO. ATTEMPT`` - The number of attempts made in solving the current "
"substep. This number is equal to the number of failed attempts (bisections) "
"plus one (the successful attempt)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.monitor:75
msgid ""
"``NO. ITER`` - The number of iterations used by the last successful attempt."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.monitor:77
msgid ""
"``TOTL. ITER`` - Total cumulative number of iterations (including each "
"iteration used by a bisection)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.monitor:80
msgid "``INCREMENT`` -"
