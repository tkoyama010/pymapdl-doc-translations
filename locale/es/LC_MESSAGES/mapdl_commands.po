msgid ""
"Mechanical APDL Command: `NKPT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NKPT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.nkpt:9
msgid ""
"Arbitrary reference number for node. If zero or blank, defaults to the "
"highest node number +1 ( :ref:`numstr` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.nkpt:13
msgid ""
"Keypoint number defining global X, Y, Z location. If ``NPT`` = All, then a "
"node will be placed at each selected keypoint. If ``NPT`` = P, graphical "
"picking is enabled and all remaining command fields are ignored (valid only "
"in the GUI). A component name may also be substituted for ``NPT``."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.nodes.Nodes.nlist.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.nodes.Nodes.nlist"
msgstr ""

