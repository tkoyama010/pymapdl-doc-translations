msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edint:9
msgid "**shellip**"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edint:10
msgid ""
"Number of shell integration points used for output (defaults to 3). For "
"element SHELL163, each integration point is associated with a layer. SHELLIP"
" must be  3. If SHELLIP = 3, results are written for the shell top, middle, "
"and bottom. If SHELLIP >3, then the results for the first SHELLIP layers are"
" written."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edint:16
msgid "**beamip**"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edint:17
msgid ""
"Number of beam integration points used for stress output for BEAM161 "
"(defaults to 4)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edint:32
msgid ""
"The number of integration points is defined by the element real constant NIP"
" for both the beam elements (in the cross section) and the shell elements "
"(through the thickness)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edint:36
msgid ""
"For shell elements that have only 1 or 2 integration points (NIP = 1 or 2), "
"use the default of SHELLIP = 3. If NIP = 1, the same results are reported at"
" the top, middle, and bottom layers.  If the NIP = 2, the results at the "
"bottom correspond to integration point 1, the results at the top correspond "
"to integration point 2, and the results at the middle are an average of the "
"top and bottom results."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edint:43
msgid ""
"For shell elements with 2 x 2 integration points in the plane, the data from"
" the four points are averaged, and there is a single output value for each "
"layer."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edint:47
msgid ""
"If you set BEAMIP = 0, no stress output is written for BEAM161 elements. In "
"this case, the beams will not appear in any POST1 plots because the program "
"assumes they are failed elements."
msgstr ""

