msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.resp:22
msgid "**spectype** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
