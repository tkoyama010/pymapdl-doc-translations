msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/nodes.rst:43:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:2
msgid "Generates nodes for general axisymmetric element sections."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:4
msgid ""
"Mechanical APDL Command: `NAXIS "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NAXIS.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:11
msgid ""
"``GEN`` - Generates nodes around the axis of an axisymmetric section "
"(default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:13
msgid ""
"``CLEAR`` - Clears all nodes around the axis of an axisymmetric section."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:15
msgid ""
"``EFACET`` - Specifies the number of facets per edge between nodal planes "
"and integration planes in the circumferential direction to display using "
"PowerGraphics. This option is only valid with :ref:`eshape`,1 and "
":ref:`rsys`,SOLU commands."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:20
msgid "Tolerance value or number of facets per edge:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:22
msgid ""
"``TOLER`` - When ``Action`` = GEN, the tolerance to use for merging the "
"generated nodes around the axis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:25
msgid ""
"``NUM`` - When ``Action`` = EFACET, the number of facets per element edge "
"for element plots:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:27
msgid "``AUTO`` - Use program-chosen facets per edge (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:29
msgid ""
"``1`` - Use 1 facet per edge (default for elements with 9, 10, 11, or 12 "
"nodal planes). Shows nodal and integration planes only."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:32
msgid ""
"``2`` - Use 2 facets per edge (default for elements with 5, 6, 7, or 8 nodal"
" planes, and maximum for elements with 9, 10, 11, or 12 nodal planes)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:35
msgid ""
"``3`` - Use 3 facets per edge (default for elements with 3 or 4 nodal "
"planes, and maximum for elements with 6, 7, or 8 nodal planes)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:38
msgid ""
"``4`` - Use 4 facets per edge (maximum for elements with 5 nodal planes)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:40
msgid ""
"``5`` - Use 5 facets per edge (maximum for elements with 4 nodal planes)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:42
msgid ""
"``6`` - Use 6 facets per edge (maximum for elements with 3 nodal planes)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:58
msgid ""
"The :ref:`naxis` command generates or clears the nodes for general "
"axisymmetric element sections. The command applies to elements ``SURF159``, "
"``SOLID272``, and ``SOLID273``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:61
msgid ""
"The generate option ( ``Action`` = GEN) operates automatically on any "
"current-technology axisymmetric element. Any nodes within the tolerance "
"value ( ``TOLER`` ) of the axis are merged into a single node. The default "
"tolerance is 1.0e-4."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:65
msgid ""
"If you want to change the number of nodes, use the clear option ( ``Action``"
" = CLEAR) before regenerating the nodes."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.naxis:68
msgid ""
"To cause the 3D element plot to appear more like the actual 3D model, use "
":ref:`naxis`,EFACET, ``NUM``, where ``NUM`` > 1. In this case, the "
"coordinate system specified for displaying element and nodal results (RSYS) "
"must be solution ( :ref:`rsys`,SOLU); otherwise, Ansys resets ``NUM`` to 1."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.nodes.Nodes.ndele.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.nodes.Nodes.ndele"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/nodes.rst:43:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ndele:2
msgid "Deletes nodes."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ndele:4
msgid ""
"Mechanical APDL Command: `NDELE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NDELE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ndele:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ndele:16
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ndele:23
msgid ""
"Delete nodes from ``NODE1`` to ``NODE2`` (defaults to ``NODE1`` ) in steps "
"of ``NINC`` (defaults to 1). If ``NODE1`` = ALL, ``NODE2`` and ``NINC`` are "
"ignored and all selected nodes ( :ref:`nsel` ) are deleted. If ``NODE1`` = "
"P, graphical picking is enabled and all remaining command fields are ignored"
" (valid only in the GUI). A component name may also be substituted for "
"``NODE1``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.ndele:43
msgid ""
"Deletes selected nodes that are not connected to elements. Nodes may also be"
" redefined instead of deleted, if desired. Boundary conditions "
"(displacements, forces, etc.) as well as any coupling or constraint "
"equations containing the deleted nodes are also deleted."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.nodes.Nodes.ndist.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.nodes.Nodes.ndist"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/nodes.rst:43:<autosummary>:1
