#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.cecycms:68
msgid ""
"``0 ( or blank)`` - If the default array parameter named  ``Sname`` "
"_CYCNODPAIR already exists, it is used to specify the matching node pairs "
"(default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.cecycms:71
msgid ""
"If this array parameter does not exist, nodes are paired automatically, and "
"the array parameter named  ``Sname`` _CYCNODPAIR is created."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.cecycms:74
msgid ""
"``1`` - Nodes are paired automatically, and the array parameter named  "
"``Sname`` _CYCNODPAIR is created. If it exists, it is deleted and re-"
"created."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.cecycms:77
