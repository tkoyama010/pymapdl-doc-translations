msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.wtbcreate:18
msgid ""
"``0`` - Damping matrix obtained from the aeroelastic code plus Rayleigh "
"damping (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.wtbcreate:20
