msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.eshape:20
msgid ""
"``1`` - Use real constants, section definition, or other information to form"
" a solid shape display of the applicable elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.eshape:23
