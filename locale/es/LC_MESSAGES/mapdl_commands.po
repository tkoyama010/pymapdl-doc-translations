#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.post1.special\\_purpose.SpecialPurpose.cycphase"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/special_purpose.rst:57:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:2
msgid ""
"Provides tools for determining minimum and maximum possible result values "
"from frequency couplets produced in a modal cyclic symmetry analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:5
msgid ""
"Mechanical APDL Command: `CYCPHASE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_CYCPHASE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:11
msgid ""
"No defaults are available for the :ref:`cycphase` command. You must specify "
"an argument ( ``TYPE`` ) when issuing the command. Other values which may be"
" necessary ( ``OPTION`` ) depend upon which ``TYPE`` argument you specify."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:18
msgid "The type of operation requested:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:20
msgid ""
"``DISP`` - Calculate the maximum and minimum possible displacement at each "
"node in the original sector model. Store the values and the phase angle at "
"which they occurred."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:23
msgid ""
"``STRESS`` - Calculate the maximum and minimum possible stresses at each "
"node in the original sector model. Store the values and the phase angle at "
"which they occurred."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:26
msgid ""
"``STRAIN`` - Calculate the maximum and minimum possible strains at each node"
" in the original sector model. Store the values and the phase angle at which"
" they occurred."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:29
msgid ""
"``ALL`` - Calculate the maximum and minimum possible displacement, stress "
"and strain at each node in the original sector model. Store the values and "
"the phase angle at which they occurred."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:32
msgid ""
"``GET`` - Places the value of a MAX or MIN item into the _CYCVALUE "
"parameter, the node for that value in the _CYCNODE parameter, and the phase "
"angle for the value in the _CYCPHASE parameter."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:35
msgid ""
"``PUT`` - Put resulting sweep values for printing (via the :ref:`prnsol` "
"command ) or plotting (via the :ref:`plnsol` command)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:38
msgid ""
"``LIST`` - List the current minimum/maximum displacement, stress and strain "
"nodal values."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:40
msgid "``STAT`` - Summarize the results of the last phase sweep."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:42
msgid "``CLEAR`` - Clear phase-sweep information from the database."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:45
msgid ""
"If TYPE = DISP, STRAIN, STRESS or ALL, controls the sweep angle increment to"
" use in the search:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:47
msgid ""
"``Angle`` - The sweep angle increment in degrees, greater than 0.1 and less "
"than 10. The default is 1."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:50
msgid "If TYPE = PUT, controls which values are placed onto the model:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:52
msgid ""
"``MAX`` - Put all existing nodal maximum values onto the model. This option "
"is the default."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:54
msgid "``MIN`` - Put all existing nodal minimum values onto the model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:56
msgid "If TYPE = GET, controls the values placed into cyclic parameters:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:58
msgid "``Item`` - Specifies the type of values on which to operate:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:60
msgid "U -- Displacement"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:61
msgid "S -- Stress"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:62
msgid "EPEL -- Strain"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:63
msgid ""
"``Comp`` - Specifies the specific component of displacement, stress or "
"strain for which to get information:"
msgstr ""

