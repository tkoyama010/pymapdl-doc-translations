msgid ""
"``MxMn`` - Specifies whether the requested value information is for the "
"maximum or minimum value:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycphase:72
