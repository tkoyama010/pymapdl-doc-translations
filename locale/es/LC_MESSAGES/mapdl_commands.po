"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_PSF.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.psf:10
msgid "No surface load symbols are displayed."
