"Allows smoothing of noisy data and provides a graphical representation of "
"the data."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.smooth:4
msgid ""
"Mechanical APDL Command: `SMOOTH "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SMOOTH.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post26/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post26.special_purpose.SpecialPurpose.smooth:8
