msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/path_operations.pydocstring
#: of ansys.mapdl.core._commands.post1.path_operations.PathOperations.pvect:11
msgid ""
"``NORM`` - Defines a unit normal vector at each interpolation point in the "
"direction of the cross product of the tangent to the path and the active Z "
"axis. Resulting vector components are in the active coordinate system (which"
" must be Cartesian)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/path_operations.pydocstring
#: of ansys.mapdl.core._commands.post1.path_operations.PathOperations.pvect:15
msgid ""
"``TANG`` - Defines a unit vector tangent to the path at each interpolation "
"point. Vector components are in the active coordinate system (which must be "
"Cartesian)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/path_operations.pydocstring
#: of ansys.mapdl.core._commands.post1.path_operations.PathOperations.pvect:18
msgid ""
"``RADI`` - Defines the position vector of each interpolation point of the "
"path from the center of the active coordinate system (which must be "
"Cartesian)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/path_operations.pydocstring
#: of ansys.mapdl.core._commands.post1.path_operations.PathOperations.pvect:22
