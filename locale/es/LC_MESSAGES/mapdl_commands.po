#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:15
msgid ""
"``SEC`` - Section numbers and colors on element and solid model plots (see "
":ref:`s-PNUM_notes` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:17
msgid ""
"``MAT`` - Material set numbers and colors on element and solid model plots "
"(see :ref:`s-PNUM_notes` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:20
msgid ""
"``TYPE`` - Element type reference numbers and colors on element and solid "
"model plots (see :ref:`s-PNUM_notes` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:23
msgid ""
"``REAL`` - Real constant set numbers and colors on element and solid model "
"plots (see :ref:`s-PNUM_notes` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:26
msgid ""
"``ESYS`` - Element coordinate system numbers on element and solid model "
"plots (see :ref:`s-PNUM_notes` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:29
msgid ""
"``LOC`` - Location numbers/colors of the element in matrix assembly order on"
" element plots."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:31
msgid ""
"LOC and ELEM numbers will be the same unless the model has been reordered."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:33
msgid "``KP`` - Keypoint numbers on solid model plots."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:35
msgid ""
"``LINE`` - Line numbers on solid model plots (both numbers and colors on "
"line plots)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:37
msgid ""
"``AREA`` - Area numbers on solid model plots (both numbers and colors on "
"area plots)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:39
msgid ""
"``VOLU`` - Volume numbers on solid model plots (both numbers and colors on "
"volume plots)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:41
msgid ""
"``SVAL`` - Stress (or any contour) values on postprocessing plots, and "
"surface load values and colors on model plots when surface load symbols are "
"on ( :ref:`psf` ). For tabular boundary conditions, the table- evaluated "
"values will be displayed on node, element, or contour displays in POST1 when"
" load symbols ( :ref:`pbf`, :ref:`psf`, :ref:`pbc` ) are on and TABNAM is "
"OFF."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:46
msgid ""
"``TABNAM`` - Table names for tabular boundary conditions. If this label is "
"turned on, the table name appears next to the appropriate symbol, arrow, "
"face outline, or contour as dictated by the :ref:`psf`, :ref:`pbc`, and "
":ref:`pbf` commands."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:50
msgid "``STAT`` - Shows current settings for :ref:`pnum`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:52
msgid "``DEFA`` - Resets all :ref:`pnum` specifications back to default."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:57
msgid "``0`` - Turns OFF numbers/colors for specified label."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:59
msgid "``1`` - Turns ON numbers/colors for specified label."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:75
msgid ""
"This command specifies entity numbering and coloring for subsequent plots."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:77
msgid ""
"The MAT, TYPE, REAL, and ESYS labels activate both the numbering and "
"coloring of the corresponding attributes for :ref:`eplot`, :ref:`kplot`, "
":ref:`lplot`, :ref:`aplot`, and :ref:`vplot`. The ELEM, MAT, TYPE, REAL, "
"ESYS, and LOC labels are mutually exclusive, that is, only one can be "
"specified at a time. Also, turning on a LINE, AREA, or VOLU label will turn "
"off the MAT, TYPE, and REAL labels."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:82
msgid ""
"PowerGraphics ( :ref:`graphics`,POWER) displays for :ref:`pnum` can be "
"problematic. :ref:`pnum` ,ELEM will display erratically depending on other "
"display command specifications, while :ref:`pnum` ,LOC and :ref:`pnum`,ESYS "
"are not supported."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:86
msgid ""
"Element and volume numbers are not visible for 3D elements and volumes when "
"Z-buffering is turned on ( :ref:`slashtype`,,[6,7, or 8])."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:89
msgid ""
"Use :ref:`pstatus` or :ref:`pnum`,STAT to show settings. Use "
":ref:`pnum`,DEFA to reset all specifications back to default. Use the "
":ref:`number` command to control whether numbers and colors are displayed "
"together."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.pnum:93
msgid "This command is valid in any processor"
msgstr ""

