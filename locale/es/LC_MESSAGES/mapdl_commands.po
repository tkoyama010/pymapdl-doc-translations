#: ansys.mapdl.core._commands.prep7.elements.Elements.egen:4
msgid ""
"Mechanical APDL Command: `EGEN "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_EGEN.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.egen:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.egen:15
msgid ""
"Do this generation operation a total of ``ITIME`` s, incrementing all nodes "
"in the given pattern by ``NINC`` each time after the first. ``ITIME`` must "
"be >1 if generation is to occur. ``NINC`` may be positive, zero, or "
"negative. If ``DX``, ``DY``, and/or ``DZ`` is specified, ``NINC`` should be "
"set so any existing nodes (as on :ref:`ngen` ) are not overwritten."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.egen:21
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.egen:31
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.egen:41
msgid ""
"Generate elements from selected pattern beginning with ``IEL1`` to ``IEL2`` "
"(defaults to ``IEL1`` ) in steps of ``IEINC`` (defaults to 1). If ``IEL1`` "
"is negative, ``IEL2`` and ``IEINC`` are ignored and the last \\| ``IEL1`` "
"\\| elements (in sequence backward from the maximum element number) are used"
" as the pattern to be repeated. If ``IEL1`` = ALL, ``IEL2`` and ``IEINC`` "
"are ignored and use all selected elements ( :ref:`esel` ) as pattern to be "
"repeated. If ``P1`` = P, graphical picking is enabled and all remaining "
"command fields are ignored (valid only in the GUI). A component name may "
"also be substituted for ``IEL1`` ( ``IEL2`` and ``INC`` are ignored)."
msgstr ""

