#: ../../pymapdl/doc/source/mapdl_commands/graphics/style.rst:32:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.normal:2
msgid "Allows displaying area elements by top or bottom faces."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.normal:4
msgid ""
"Mechanical APDL Command: `/NORMAL "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NORMAL.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.normal:12
msgid "Display key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.normal:14
msgid "``0`` - No face distinction."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.normal:16
msgid ""
"``1`` - Show only area elements having their positive normals directed "
"toward the viewing point."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.normal:18
msgid ""
"``-1`` - Show only area elements having their positive normals directed away"
" from the viewing point."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.normal:35
msgid ""
":ref:`normal` allows you to select area elements and area plots by the top "
"or bottom faces. It is useful for checking the normal directions on shell "
"elements. The positive normal (element Z direction) is defined by the right-"
"hand rule following the node I, J, K, L input direction. This command is "
"available only with raster or hidden-line displays, for WIN32 or X11 2D "
"displays only."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.style.Style.shade.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.style.Style.shade"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/style.rst:32:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.shade:2
msgid "Defines the type of surface shading used with Z-buffering."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.shade:4
msgid ""
"Mechanical APDL Command: `/SHADE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SHADE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.shade:12
msgid "Shading type:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.shade:14
msgid "``FACET or 0`` - Facet shading (one color per area face)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.shade:16
msgid ""
"``GOURAUD or 1`` - Gouraud smooth shading (smooth variation of color based "
"on interpolated vertex colors) (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.shade:19
msgid ""
"``PHONG or 2`` - Phong smooth shading (smooth variation of color based on "
"interpolated vertex normals)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.shade:36
msgid ""
"Defines the type of surface shading used on area, volume, and PowerGraphics "
"( :ref:`graphics`,POWER) displays when software Z-buffering is enabled ( "
":ref:`slashtype` ). This command is only functional for 2D display devices."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.style.Style.slashtype.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.style.Style.slashtype"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/style.rst:32:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:2
msgid "Defines the type of display."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:4
msgid ""
"Mechanical APDL Command: `/TYPE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TYPE_sl.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:12
msgid ""
"Display type. Defaults to ZBUF for raster mode displays or BASIC for vector "
"mode displays:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:14
msgid "``BASIC or 0`` - Basic display (no hidden or section operations)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:16
msgid ""
"``SECT or 1`` - Section display (plane view). Use the :ref:`cplane` command "
"to define the cutting plane."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:19
msgid "``HIDC or 2`` - Centroid hidden display (based on item centroid sort)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:21
msgid "``HIDD or 3`` - Face hidden display (based on face centroid sort)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:23
msgid ""
"``HIDP or 4`` - Precise hidden display (like HIDD but with more precise "
"checking). Because all facets are sorted, this mode can be extremely slow, "
"especially for large models."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:26
msgid ""
"``CAP or 5`` - Capped hidden display (same as combined SECT and HIDD with "
"model in front of section plane removed)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:29
msgid ""
"``ZBUF or 6`` - Z-buffered display (like HIDD but using software "
"Z-buffering)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:31
msgid ""
"``ZCAP or 7`` - Capped Z-buffered display (same as combined SECT and ZBUF "
"with model in front of section plane removed)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:34
msgid ""
"``ZQSL or 8`` - QSLICE Z-buffered display (same as SECT but the edge lines "
"of the remaining 3D model are shown)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:37
msgid ""
"``HQSL or 9`` - QSLICE precise hidden display (like ZQSL but using precise "
"hidden)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:53
msgid ""
"Defines the type of display, such as section display or hidden-line display."
" Use the :ref:`device` command to specify either raster or vector mode."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:56
msgid ""
"The SECT, CAP, ZCAP, ZQSL, and HQSL options produce section displays. The "
"section or \"cutting\" plane is specified on the :ref:`cplane` command as "
"either normal to the viewing vector at the focus point (default), or as the "
"working plane."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:60
msgid ""
"When you use PowerGraphics, the section display options (Section, Slice, and"
" Capped) use different averaging techniques for the interior and exterior "
"results. Because of the different averaging schemes, anomalies may appear at"
" the transition areas. In many cases, the automatically computed MIN and MAX"
" values will differ from the full range of interior values. You can lessen "
"the effect of these anomalies by issuing :ref:`avres`,,FULL ( Main Menu> "
"General Post Proc> Options for Outp ). This command sets your legend's "
"automatic contour interval range according to the minimum and maximum "
"results found throughout the entire model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:68
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:47
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.efacet:58
msgid ""
"With PowerGraphics active ( :ref:`graphics`,POWER), the averaging scheme for"
" surface data with interior element data included ( :ref:`avres`,,FULL) and "
"multiple facets per edge ( :ref:`efacet` ,2 or :ref:`efacet`,4) will yield "
"differing minimum and maximum contour values depending on the Z-Buffering "
"options ( :ref:`slashtype`,,6 or :ref:`slashtype`,,7). When the Section data"
" is not included in the averaging schemes ( :ref:`slashtype`,,7), the "
"resulting absolute value for the midside node is significantly smaller."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:75
msgid ""
"The HIDC, HIDD, HIDP, ZBUF, ZQSL, and HQSL options produce displays with "
"\"hidden\" lines removed. Hidden lines are lines obscured from view by "
"another element, area, etc. The choice of non-Z- buffered hidden-line "
"procedure types is available only for raster mode ( :ref:`device` ) "
"displays. For vector mode displays, all non-Z-buffered \"hidden-line\" "
"options use the same procedure (which is slightly different from the raster "
"procedures). Both geometry and postprocessing displays may be of the hidden-"
"line type. Interior stress contour lines within solid elements can also be "
"removed as hidden lines, leaving only the stress contour lines and element "
"outlines on the visible surfaces. Midside nodes of elements are ignored on "
"postprocessing displays. Overlapping elements will not be displayed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.slashtype:85
msgid ""
"The ZBUF, ZCAP, and ZQSL options use a specific hidden-line technique called"
" software Z-buffering. This technique allows a more accurate display of "
"overlapping surfaces (common when using Boolean operations or :ref:`eshape` "
"on element displays), and allows smooth shaded displays on all interactive "
"graphics displays. Z-buffered displays can be performed faster than HIDP and"
" CAP type displays for large models. See also the :ref:`light`, "
":ref:`shade`, and :ref:`gfile` commands for additional options when "
"Z-buffering is used."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.style.Style.trlcy.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.style.Style.trlcy"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/style.rst:32:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:2
msgid "Specifies the level of translucency."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:4
msgid ""
"Mechanical APDL Command: `/TRLCY "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TRLCY.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:9
msgid ""
"Apply translucency level to the items specified by the following labels:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:17
msgid ""
"``ISURF`` - Isosurfaces (surfaces of constant stress, etc., value). "
"Translucency varies with result value, to a maximum of the specified "
"translucency level."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:20
msgid ""
"``CM`` - Component group. Use ``N1`` for component name, ignore ``N2`` and "
"``NINC``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:22
msgid ""
"``CURVE`` - Filled areas under curves of line graphs. Use ``N1``, ``N2``, "
"``NINC`` fields for curve numbers."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:25
msgid ""
"``ZCAP`` - If :ref:`slashtype`, ``WN``,ZCAP is the current display type, "
"then :ref:`trlcy`,ZCAP, ``TLEVEL`` will display the model in window ``WN`` "
"with the portion of the model in front of the section plane displayed at the"
" translucency level ``TLEVEL``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:29
msgid ""
"``ON, OFF`` - Sets the specified translucency display on or off. All other "
"fields are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:31
msgid "**tlevel** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:32
msgid "Translucency level: 0.0 (opaque) to 1.0 (transparent)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:35
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:44
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:53
msgid ""
"Used only with labels as noted above. Apply translucency level to ``Lab`` "
"items numbered ``N1`` to ``N2`` (defaults to ``N1`` ) in steps of ``NINC`` "
"(defaults to 1). If ``N1`` is blank or ALL, apply specified translucency "
"level to entire selected range. If ``Lab`` is CM, use component name for "
"``N1`` and ignore ``N2`` and ``NINC``. A value of ``N1`` = P allows you to "
"graphically pick elements, areas, and volumes. You can then assign "
"translucency levels to the entities via the picker. The ``Lab`` and "
"``TLEVEL`` fields are ignored when translucency is applied by picking."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:75
msgid ""
"Specifies the level of translucency for various items. Issue "
":ref:`trlcy`,DEFA to reset the default (0) translucency levels. This command"
" is valid only on selected 2D and 3D graphics devices; see "
"filename=\"Hlp_G_BAS11_3.html\"? in the `Basic Analysis Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_bas/Hlp_G_BAS19.html>`_"
" for more information on applying translucency."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.trlcy:81
msgid ""
"For 2D devices, the program displays only the visible faces of the items "
"being displayed. The information behind the facing planes is not displayed. "
"Issuing the :ref:`shrink` command will force the hardware to display "
"information behind the translucent items."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.style.Style.txtre.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.style.Style.txtre"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/style.rst:32:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:2
msgid "Controls application of texture to selected items."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:4
msgid ""
"Mechanical APDL Command: `/TXTRE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TXTRE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:9
msgid "You can apply texture according to the following labels:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:11
msgid ""
"``ELEM`` - Apply texture to elements ``N1`` through ``N2`` in steps of "
"``NINC``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:13
msgid ""
"``AREA`` - Apply texture to areas ``N1`` through ``N2`` in steps of "
"``NINC``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:15
msgid ""
"``VOLU`` - Apply texture to volumes ``N1`` through ``N2`` in steps of "
"``NINC``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:17
msgid ""
"``CM`` - Apply texture to the component named in ``N1``. ``N2`` and ``NINC``"
" are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:19
msgid ""
"``ON, OFF`` - Sets the specified texture display on or off. All other fields"
" are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:21
msgid ""
"``File`` - If Lab = File, the command format is :ref:`txtre`, File, "
"``Key_Index``, ``Fname``, ``Fext``, ``--``, ``Format`` (This variant of the "
"command is applicable to 2D drivers)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:23
msgid ""
"``Key_Index`` - The texture index associated with the file. If the number "
"fifty-one (51) is used, the imported bitmap will be used as the window's "
"logo."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:26
msgid ""
"``Fname`` - File name and directory path (248 characters maximum, including "
"the characters needed for the"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:27
msgid ""
"directory path). An unspecified directory path defaults to the working "
"directory; in this case, you can use all 248 characters for the file name."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:29
msgid "``Fext`` - Filename extension (eight-character maximum)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:30
msgid ""
"``Format`` - The file format. If ``Format`` = 0, the file is a pixmap "
"(Linux) or Bitmap (PC). The file cannot contain a compressed image, and the "
"PC file must be 8 or 24 bit BI_RGB format. If ``Format`` = 1 or JPEG, then "
"the file is in JPEG (Joint Photographic Experts Group) format. If ``Format``"
" = 2 or PNG, then the file is in PNG (Portable Network Graphics) format."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:36
msgid "Select the texture index number from the following list:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:38
msgid "``0`` - No Texturing"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:40
msgid "``1`` - Aluminum"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:42
msgid "``2`` - Aluminum, Brushed"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:44
msgid "``3`` - Steel With Bumps"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:46
msgid "``4`` - Steel, Embossed"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:48
msgid "``5`` - Iron"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:50
msgid "``6`` - Steel, Pattern"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:52
msgid "``7`` - Steel, Riveted"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:54
msgid "``8`` - Steel, Scratched"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:56
msgid "``9`` - Tin"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:58
msgid "``10`` - Metal"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/style.pydocstring of
#: ansys.mapdl.core._commands.graphics.style.Style.txtre:60
