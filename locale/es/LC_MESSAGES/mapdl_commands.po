#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:10
msgid "Fiber length from the reference point. Defaults to 1."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:12
msgid "**xref** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
#: ansys.mapdl.core._commands.prep7.meshing.Meshing.gsgdata:13
msgid "X coordinate of the reference point. Defaults to zero."
