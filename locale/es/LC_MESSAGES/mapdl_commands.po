"``LAYR1`` if ``LAYR1`` is input or to the number of layers (or to 19+ "
"``LAYR1``, if smaller) if ``LAYR1`` is not input."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.layplot:38
msgid ""
