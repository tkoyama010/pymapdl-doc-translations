#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.einfin:14
msgid ""
"If the component includes only one node, the node becomes the pole node. The"
" pole node is typically located at or near the geometric center of the "
"finite element domain if there is a single pole."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.einfin:18
msgid ""
"If the component includes two (2D) or three nodes (3D), the program "
"constructs an infinite line or area, then calculates the pole positions by "
"drawing a perpendicular line from a selected node to the line or area."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.einfin:22
msgid ""
"If the component includes more than two (2D) or three nodes (3D), the "
"program uses the first two or three nodes calculate the position of poles."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.einfin:25
msgid "**pnode_nref1** : :class:`python:str`"
