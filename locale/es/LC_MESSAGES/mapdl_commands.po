#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:220
msgid ""
"2 -- Print wave component details (valid only when ``KWAVE`` = 5 through 7)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:222
msgid ""
"**The following input values are valid only when** ``KWAVE`` = 5 through 7:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:224
msgid ""
"``VAL7`` - ``APC`` -- Activate apparent period calculation when a wave is "
"superimposed upon a"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:225
msgid "current:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:227
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:273
msgid "0 -- Not activated (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:228
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:274
msgid "1 -- Activated."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:230
msgid "``VAL8`` - ``DSA`` -- Stretching depth factor:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:232
msgid ""
"Stretching is performed between a distance of ``DSA`` \\* ``Hs`` below the "
"mean water level (MWL) and the water surface, where ``Hs`` is the "
"significant wave height measured from the MWL. No stretching occurs outside "
"this range, or if the wave surface is below the MWL. If ``DSA`` \\* ``Hs`` "
"is negative, stretching is performed between that level above the MWL and "
"the water surface. The default ``DSA`` value is 0.5."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:238
msgid ""
"``VAL9`` - ``DELTA`` -- Delta stretching parameter (0.0 :math:`equation not "
"available`   ``DELTA``"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:239
msgid ":math:`equation not available`  1.0):"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:241
msgid ""
"A value of 0.0 corresponds to Wheeler stretching under wave crests, 1.0 "
"corresponds to linear extrapolation of kinematics at mean water level to "
"crest. (Default = 0.3.) If zero is required, specify a small positive number"
" (0.01 or less) instead."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:245
msgid "``VAL10`` - Wave kinematics factor or wave spreading angle:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:247
msgid ""
"``KINE`` ( ``KWAVE`` = 5 or 7) -- Wave kinematics factor (0.0 < ``KINE``  "
":math:`equation not available`  1.0). The factor is used to account forwave "
"spreading by modifying the horizontal wave velocities and accelerations.A "
"value of 1.0 corresponds to uni-directional wave with no spreading.(Default "
"= 1.0, no spreading.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:251
msgid ""
"``SPANGLE`` ( ``KWAVE`` = 6) -- Wave spreading angle in degrees (0.0 "
":math:`equation not available`           ``SPANGLE`` ≤ 40.0). The angle is "
"used to compute a wave spreading factor to modify the horizontal wave "
"kinematics for nearly unidirectional seas. ``SPANGLE`` = 0.0 corresponds to "
"no spreading. (Default = 0.0, no spreading.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:256
msgid ""
"``VAL11`` - Random seed value for phase angle generation, or wave crest "
"amplitude value:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:258
msgid ""
"``SEED`` ( ``KWAVE`` = 5) -- Initial seed for random phase angle generation."
" (Default = 1.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:259
msgid ""
"``AMPMAX`` ( ``KWAVE`` = 6) -- Maximum wave crest amplitude (distance "
"between the mean water level and maximum wave crest)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:261
msgid ""
"``AMPCONST`` ( ``KWAVE`` = 7) -- Constrained wave crest amplitude (distance "
"between the mean water level and wave crest)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:264
msgid "**The following input values are valid only when** ``KWAVE`` = 6 or 7:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:266
msgid ""
"``VAL12`` - ``TOFF`` -- Time offset at which the maximum wave crest will "
"occur. (Default = 0.0.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:268
msgid ""
"``VAL13`` - ``ROFF`` -- Position offset along the wave direction where the "
"maximum wave crest will occur. (Default = 0.0.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:271
msgid "``VAL14`` - ``EVOLVING`` ( ``KWAVE`` = 6) -- Activate evolving wave:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:276
msgid ""
"``SEED`` ( ``KWAVE`` = 7) -- Initial seed for random phase angle generation."
" (Default = 1.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:281
msgid ""
"When using waves in a `superelement generation run "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_substr/aKa7uq1a9ldm.html#advsupmtr2jla062999>`_"
" ( :ref:`antype`,SUBSTR), consider whether you should take the ocean level "
"into account ( ``SeOcLvL`` on the :ref:`seopt` command)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:288
msgid ""
"An ocean zone is a local space where you can override global ocean-loading "
"parameters. The following arguments specifying the ocean zone values are "
"described in more detail under `Ocean Data Type: Basic ( OCTYPE,BASIC) "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_cmd/Hlp_C_OCDATA.html#ocdatafigbasic>`_."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:293
msgid "``VAL1`` - ``KFLOOD`` -- The inside-outside fluid-interaction key."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:295
msgid ""
"``VAL2`` - ``Cay`` -- The ratio of added mass of the external fluid over the"
" mass of a cross section in the element y direction (normal)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:298
msgid ""
"``VAL3`` - ``Caz`` -- The ratio of added mass of the external fluid over the"
" mass of a cross section in the element z direction (normal)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:301
msgid ""
"``VAL4`` - ``Cb`` -- The ratio of buoyancy force used over buoyancy force "
"based on the outside diameter and water density."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:304
msgid ""
"Ocean zone values specified via the :ref:`ocdata` command override global "
"ocean-loading parameters."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:306
msgid ""
"Arguments not specified default to the global values specified for the basic"
" ocean type. Therefore, the relationship between ``Ca`` and ``CM`` values ( "
"``Ca`` = ``CM`` - 1.0) is not applied to ocean zones."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/ocean.pydocstring of
#: ansys.mapdl.core._commands.solution.ocean.Ocean.ocdata:310
msgid ""
"For a pipe-type ocean zone ( :ref:`oczone`,PIP), ``KFLOOD`` is the only "
"valid option."
msgstr ""

