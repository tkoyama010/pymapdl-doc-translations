#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.nmodif:33
msgid ""
"Second rotation of nodal coordinate system about nodal X (positive Y toward "
"Z). Leaving this field blank retains the previous value."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.nmodif:37
msgid ""
"Third rotation of nodal coordinate system about nodal Y (positive Z toward "
"X). Leaving this field blank retains the previous value."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.nmodif:54
