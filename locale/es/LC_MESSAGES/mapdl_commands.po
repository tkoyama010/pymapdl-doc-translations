"the command log ( :file:`File.LOG` ) and the database log:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/run_controls.pydocstring
#: of ansys.mapdl.core._commands.session.run_controls.RunControls.input:34
msgid "``0`` - Record only the :ref:`input` command on the log (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/run_controls.pydocstring
#: of ansys.mapdl.core._commands.session.run_controls.RunControls.input:36
