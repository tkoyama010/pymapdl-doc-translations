msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:226
msgid "**Command Specifications for Action= SURF**"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:230
msgid ""
"``Par1`` - Crack-surface node component 1 (top or bottom crack face). "
"(Component name must be 32 characters or less.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/special_purpose.pydocstring
#: of ansys.mapdl.core._commands.prep7.special_purpose.SpecialPurpose.cint:233
msgid ""
"``Par2`` - Crack-surface node component 2 (top or bottom crack face, but the"
