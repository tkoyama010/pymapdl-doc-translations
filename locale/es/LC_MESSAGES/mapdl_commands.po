#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.autots:4
msgid ""
"Mechanical APDL Command: `AUTOTS "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_AUTOTS.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
