"``0 or OFF`` - No rewrite operations are performed to compensate for items "
"that obscure or overlay the graphics window (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/run_controls.pydocstring
#: of ansys.mapdl.core._commands.session.run_controls.RunControls.uis:160
msgid ""
