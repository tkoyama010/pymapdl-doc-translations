msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/analysis_options.rst:70:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:2
msgid "Controls PCG solver options."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:4
msgid ""
"Mechanical APDL Command: `PCGOPT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_PCGOPT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:8
msgid "**lev_diff** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:9
msgid ""
"Indicates the level of difficulty of the analysis. Valid settings are AUTO "
"or 0 (default), 1, 2, 3, 4, or 5. This option applies to both the PCG solver"
" when used in static and full transient analyses and to the PCG Lanczos "
"method in modal analyses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:13
msgid ""
"Specify AUTO to allow Mechanical APDL to select the proper level of "
"difficulty for the model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:14
msgid ""
"Lower values (1 or 2) generally provide the best performance for well-"
"conditioned problems."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:15
msgid ""
"Values of 3 or 4 generally provide the best performance for ill-conditioned "
"problems; however, higher values may increase the solution time for well-"
"conditioned problems. Higher level-of- difficulty values typically require "
"more memory."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:18
msgid ""
"The highest value of 5 essentially performs a factorization of the global "
"matrix (similar to the sparse solver) and may require a very large amount of"
" memory. This level is generally recommended for small- to medium-sized "
"problems when using the PCG Lanczos mode-extraction method."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:22
msgid ""
"For example, models containing elongated elements (that is, elements with "
"high aspect ratios) and models containing contact elements can lead to ill-"
"conditioned problems. To determine if your problem is ill-conditioned, view "
"the :file:`Jobname.PCS` file to see the number of PCG iterations needed to "
"reach a converged solution. Generally, static or full transient solutions "
"that require more than 1500 iterations are considered to be ill-conditioned "
"for the PCG solver."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:28
msgid "**fallback** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:29
msgid ""
"Controls whether Mechanical APDL switches to the sparse direct solver "
"automatically ( :ref:`eqslv`,SPARSE) under certain conditions. (The criteria"
" are listed below.) When Mechanical APDL switched the equation solver, the "
"simulation attempts to continue without interruption."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:33
msgid ""
"``AUTO`` - Automatically switch to the sparse solver when one of the "
"following conditions apply (default):"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:35
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:44
msgid "The assembled matrix is detected to be indefinite."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:37
msgid ""
"The PCG solver requires more than 2000 iterations to reach convergence."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:39
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:48
msgid "The PCG solver fails to converge."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:41
msgid ""
"``ON`` - More aggressive fallback criteria. Automatically switch to the "
"sparse solver when one of the following conditions apply:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:46
msgid ""
"The PCG solver requires more than 1500 iterations to reach convergence."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:50
msgid ""
"``OFF`` - Disables the fallback logic so that there is no automatic "
"switching, and only the PCG solver is used to solve the equations for this "
"simulation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:53
msgid ""
"After switching to the sparse solver, the program reverts back to the PCG "
"solver under certain conditions. See the :ref:`Notes section for details. "
"<PCGOPT_Notes_revertAfterFallback>`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:56
msgid "**reduceio** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:57
msgid ""
"Controls whether the PCG solver will attempt to reduce I/O performed during "
"equation solution:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:59
msgid ""
"``AUTO`` - Automatically chooses whether to reduce I/O or not (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:61
msgid ""
"``YES`` - Reduces I/O performed during equation solution in order to reduce "
"total solver time."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:63
msgid "``NO`` - Does NOT reduce I/O performed during equation solution."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:65
msgid ""
"This option applies to both the PCG solver when used in static and full "
"transient analyses and to the PCG Lanczos method in modal analyses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:69
msgid "Controls whether or not a Sturm sequence check is performed:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:71
msgid "``OFF`` - Does NOT perform Sturm sequence check (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:73
msgid "``ON`` - Performs Sturm sequence check"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:75
msgid ""
"This option applies only when using the PCG Lanczos method in modal "
"analyses. When using this option, a factorization must be performed and will"
" require a very large amount of memory for extra computations. This option "
"is generally recommended for small- to medium-sized problems. If the Sturm "
"sequence check takes a large amount of computing time, use the "
":file:`Jobname.ABT` file to abort the Sturm check, or press the STOP button "
"if in interactive mode."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:81
msgid "**wrtfull** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:82
msgid "Controls whether or not the :file:`.FULL` file is written."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:84
msgid "``ON`` - Write :file:`.FULL` file (default)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:86
msgid "``OFF`` - Do not write :file:`.FULL` file."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:88
msgid ""
"This option applies only when using the PCG Lanczos method in modal analyses"
" because the :file:`.FULL` file is never written when using the PCG solver "
"in static or full transient analyses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:91
msgid ""
"If using :ref:`msave`,ON and conditions for the :ref:`msave` command are "
"met, a complete :file:`.FULL` file is never written regardless of this "
"option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:94
msgid ""
"If constraint equations are present in the model, a :file:`.FULL` file is "
"always written regardless of this option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:97
msgid ""
"This option is useful in a distributed-memory parallel processing analysis "
"because assembling the global stiffness and mass matrices on the head "
"compute node before writing the :file:`.FULL` file can take a considerable "
"amount of memory. By setting ``Wrtfull`` = OFF, this assembly process is "
"skipped on the head compute node, decreasing the amount of memory required "
"to compute the modes and mode shapes. ``Wrtfull`` = OFF does not affect the "
"results for the modes and mode shapes. However, without a :file:`.FULL` "
"file, the participation factor table computations do not occur."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:104
msgid ""
"To generate the :file:`.FULL` file, such as for a harmonic, transient mode-"
"superposition, or spectrum analysis, rerun the modal analysis with "
"``Wrtfull`` = ON, or use the :ref:`wrfull` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:107
msgid "**lm_key** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:108
msgid ""
"Controls use of the PCG solver for ``MPC184``  elements that involve the "
"Lagrange multiplier method. This option applies only to the PCG solver when "
"used in static analyses, full transient analyses, and modal analyses that "
"use the PCG Lanczos mode-extraction method ( :ref:`modopt`,LANPCG)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:112
msgid ""
"``ON`` - Allow use of the PCG solver with certain ``MPC184`` element types "
"that use the Lagrange multiplier method. (default)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:115
msgid ""
"``OFF`` - Do not use the PCG solver with any ``MPC184`` element types that "
"use the Lagrange multiplier method."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:118
msgid ""
"The Lagrange multiplier method used by ``MPC184`` elements transfers the "
"Lagrange multipliers into multiple point constraints and, hence, can be "
"solved by the PCG solver. The current ``MPC184`` element types supported "
"are: `rigid beam "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184link.html#mpc184linkprores>`_,"
" `rigid link "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184link.html#mpc184linkprores>`_,"
" `slider "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184slid.html#mpc184slidprores>`_,"
" `revolute joint "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184revo.html#mpc184revoprores>`_,"
" `universal joint "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184univ.html#mpc184univprores>`_,"
" `translational joint "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184tran.html#mpc184transprores>`_,"
" `cylindrical joint "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184cyl.html#mpc184cylinprores>`_,"
" `weld joint "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184weld.html#mpc184weldprores>`_,"
" `spherical joint "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184sphe.html#mpc184spherprores>`_,"
" and `general joint "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_MPC184gen.html#mpc184generprores>`_"
" . For all other ``MPC184`` element types, the PCG solver cannot be used, "
"and the equation solver automatically switches to the sparse solver "
"regardless of the ``LM_Key`` setting on :ref:`pcgopt`. The :ref:`msave` "
"command does not support the ``LM_Key`` = ON option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:156
msgid ""
"``ReduceIO`` works independently of the :ref:`msave` command in the PCG "
"solver. Setting ``ReduceIO`` to YES can significantly increase the memory "
"usage in the PCG solver."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:159
msgid ""
"To minimize the memory used by the PCG solver with respect to the "
"``Lev_Diff`` option only, set ``Lev_Diff`` = 1 if you do not have sufficient"
" memory to run the PCG solver with ``Lev_Diff`` = AUTO."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:163
msgid "The :ref:`msave`,ON command is not valid in these circumstances:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:165
msgid ""
"when ``Lev_Diff`` = 5; in this case, the ``Lev_Diff`` value will "
"automatically be reset to 2."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:167
msgid ""
"with the ``StrmCk`` option; in this case, ``StrmCk`` will be set to OFF."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:169
msgid ""
"when the ``Fallback`` option is enabled (set to AUTO or ON); in this case, "
"``Fallback`` will automatically be reset to OFF."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:172
msgid ""
"For Lagrange-formulation contact methods and mixed u-P formulations, the PCG"
" solver cannot be used, and the sparse solver is required."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:175
msgid ""
"``Fallback`` logic is automatically disabled ( ``Fallback`` = OFF) in these "
"circumstances:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:177
msgid ""
"for analyses that include ``MPC184`` elements using the Lagrange multiplier "
"method to impose kinematic constraints"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:180
msgid ""
"for thermal analyses that use the quasi-static ( :ref:`thopt`,QUASI) option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:182
msgid ""
"**Reverting to the PCG Solver After an Automatic Switch to the Sparse "
"Solver**"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:184
msgid ""
"**Linear Analysis:** When fallback logic is enabled ( ``Fallback`` = AUTO or"
" ON) and the program switches to the sparse direct solver during a linear "
"analysis, the sparse solver is used for the remainder of the simulation "
"unless the solver choice is changed by issuing the :ref:`eqslv` command "
"between load steps."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:189
msgid ""
"**Nonlinear Analysis:** If the program switches to the sparse direct solver "
"during a nonlinear analysis, the sparse solver is used for the remaining "
"equilibrium iterations of the current substep. The program reverts back to "
"the PCG solver at the end of the current substep unless one of the following"
" conditions apply:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:194
msgid ""
"The previous call to the sparse solver involved an indefinite or near-"
"singular matrix."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:196
msgid ""
"The last equilibrium iteration of the current substep using the sparse "
"solver was faster than the last successful equilibrium iteration using the "
"PCG solver."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:199
msgid ""
"Three consecutive fallback switches between the sparse and the PCG solvers "
"have occurred."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.pcgopt:201
msgid ""
"For both linear and nonlinear analyses, the solver choice can be changed "
"using the :ref:`eqslv` command between any subsequent load steps."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.analysis\\_options.AnalysisOptions.perturb"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/analysis_options.rst:70:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:2
msgid "Sets linear perturbation analysis options."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:4
msgid ""
"Mechanical APDL Command: `PERTURB "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_PERTURB.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:10
msgid ""
"Linear perturbation analysis is disabled ( ``Type`` = OFF) by default. When "
"the linear perturbation analysis is enabled, linear material property "
"behavior is assumed for stress calculations; contact status for all contact "
"pairs from the point of restart is used by default; and all loads and "
"constraints from the restart step are deleted, except for displacement "
"constraints and inertia loads, by default."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:19
msgid "Type of linear perturbation analysis to be performed:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:21
msgid "``STATIC`` - Perform a linear perturbation static analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:23
msgid "``MODAL`` - Perform a linear perturbation modal analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:25
msgid ""
"``BUCKLE`` - Perform a linear perturbation eigenvalue buckling analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:27
msgid "``HARMONIC`` - Perform a linear perturbation full harmonic analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:29
msgid ""
"``SUBSTR`` - Perform a linear perturbation substructure generation pass."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:31
msgid "``OFF`` - Do not perform a linear perturbation analysis (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:33
msgid "**matkey** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:34
msgid ""
"Key for specifying how the linear perturbation analysis uses material "
"properties, valid for all structural elements except contact elements. For "
"more information, see `Linear Perturbation Analysis "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_thry/thylinpert.html#anplpdown>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:37
msgid ""
"``AUTO`` - The program selects the material properties for the linear "
"perturbation analysis automatically (default). The materials are handled in "
"the following way:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:40
msgid ""
"For pure linear elastic materials used in the base analysis, the same "
"properties are used in the linear perturbation analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:43
msgid ""
"For hyperelastic materials used in the base analysis, the material "
"properties are assumed to be linear elastic in the linear perturbation "
"analysis. The material property data (or material Jacobian) is obtained "
"based on the tangent of the hyperelastic material's constitutive law at the "
"point where restart occurs."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:48
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:68
msgid ""
"For hyperviscoelastic materials used in the base analysis, the program uses "
"the harmonic material formulation in perturbed full harmonic solutions."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:51
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:71
msgid ""
"For other nonlinear materials used in the base analysis, the material "
"properties are assumed to be linear elastic in the linear perturbation "
"analysis. The material data is the same as the linear portion of the "
"nonlinear materials (that is, the parts defined via :ref:`mp` commands)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:55
msgid ""
"For ``COMBIN39``, the stiffness is that of the first segment of the force-"
"deflection curve."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:57
msgid ""
"``TANGENT`` - Use the tangent (material Jacobian) on the material "
"constitutive curve as the material property. The material property remains "
"linear in the linear perturbation analysis and is obtained at the point of "
"the base analysis where restart occurs. The materials are handled in the "
"following way:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:61
msgid ""
"For pure linear elastic materials used in the base analysis, the same "
"properties are used in the linear perturbation analysis. Because the "
"material constitutive curve is linear, the tangent is the same as the base "
"analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:65
msgid ""
"For hyperelastic materials used in the base analysis, the program uses the "
"same tangent as that used for ``MatKey`` = AUTO, and the results are "
"therefore identical."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:75
msgid ""
"The materials and properties typically differ from ``Matkey`` = AUTO, but it"
" is possible the results"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:76
msgid ""
"could be identical or very similar if a.) the material is elastoplastic "
"rate-independent and is unloading (or has neutral loading) at the restart "
"point, or b.) the material is rate-dependent, depending on the material "
"properties and loading conditions."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:80
msgid ""
"For ``COMBIN39``, the stiffness is equal to the tangent of the current "
"segment of the force- deflection curve."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:83
msgid ""
"In a modal restart solution that follows a linear perturbation modal "
"analysis, the TANGENT option is overridden by the AUTO option and linear "
"material properties are used for stress calculations in the modal restart. "
"See the :ref:`discussion in the Notes for more information. <TANmodrest>`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:87
msgid ""
"``SPOFF`` - Provide the same values as AUTO, but set the spin softening "
"matrix to zero (ignoring the spin softening effect)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:90
msgid ""
"The spin softening effect is excluded in all the linear perturbation "
"analysis types except for linear perturbation buckling. Note that although "
"the spin softening effect is excluded in linear perturbation analysis, it is"
" still included in the base static or full transient analysis if "
":ref:`nlgeom`,ON is issued in the base analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:95
msgid "**contkey** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:96
msgid ""
"Key that controls contact status for the linear perturbation analysis. This "
"key controls all contact elements ( ``TARGE169``, ``TARGE170``, "
"``CONTA172``, ``CONTA174``, ``CONTA175``, ``CONTA177``, and ``CONTA178`` ) "
"globally for all contact pairs. Alternatively, contact status can be "
"controlled locally per contact pair by using the :ref:`cnkmod` command. Note"
" that the contact status from the base analysis solution is always adjusted "
"by the local contact controls specified by :ref:`cnkmod` first and then "
"modified by the global sticking or bonded control ( ``ContKey`` = STICKING "
"or BONDED). The tables in the `Notes "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_cmd/Hlp_C_PERTURB.html#>`_"
" Notes section show how the contact status is adjusted by :ref:`cnkmod` "
"and/or the ``ContKey`` setting."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:101
msgid ""
"``CURRENT`` - Use the current contact status from the restart snapshot "
"(default). If the previous run is nonlinear, then the nonlinear contact "
"status at the point of restart is frozen and used throughout the linear "
"perturbation analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:105
msgid ""
"``STICKING`` - For frictional contact pairs (MU > 0), use sticking contact "
"(for example, MU\\*KN for tangential contact stiffness) everywhere the "
"contact state is closed (that is, status is sticking or sliding). This "
"option only applies to contact pairs that are in contact and have a "
"frictional coefficient MU greater than zero. Contact pairs without friction "
"(MU = 0) and in a sliding state remain free to slide in the linear "
"perturbation analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:111
msgid ""
"``BONDED`` - Any contact pairs that are in the closed (sticking or sliding) "
"state are moved to bonded (for example, KN for both normal and tangential "
"contact stiffness). Contact pairs that have a status of far-field or near-"
"field remain open."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:115
msgid "**loadcontrol** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:116
msgid ""
"Key that controls how the load vector of {F:sub:`perturbed` } is calculated."
" This control is provided for convenience of load generation for linear "
"perturbation analysis. In general, a new set of loads is required for a "
"linear perturbation analysis. This key controls all mechanical loads; it "
"does not affect non-mechanical loads. Non-mechanical loads (including "
"thermal loads) are always kept (that is, not deleted)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:118
msgid ""
"``ALLKEEP`` - Keep all the boundary conditions (loads and constraints) from "
"the end of the load step of the current restart point. This option is "
"convenient for further load application and is useful for a linear "
"perturbation analysis restarted from a previous linear analysis. For this "
"option, {F:sub:`end` } is the total load vector at the end of the load step "
"at the restart point."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:123
msgid ""
"``INERKEEP`` - Delete all loads and constraints from the restart step, "
"except for displacement constraints and inertia loads (default). All "
"displacement constraints and inertia loads are kept for convenience when "
"performing the linear perturbation analysis. Note that nonzero and tabular "
"displacement constraints can be considered as external loads; however, they "
"are not deleted when using this option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:129
msgid ""
"``PARKEEP`` - Delete all loads and constraints from the restart step, except"
" for displacement constraints. All displacement constraints are kept for "
"convenience when performing the linear perturbation analysis. Note that "
"nonzero and tabular displacement constraints can be considered as external "
"loads; however, they are not deleted when using this option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:134
msgid ""
"``DZEROKEEP`` - Behaves the same as the PARKEEP option, except that all "
"nonzero displacement constraints are set to zero upon the onset of linear "
"perturbation."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:137
msgid ""
"``NOKEEP`` - Delete all the loads and constraints, including all "
"displacement constraints. For this option, {F:sub:`end` } is zero unless "
"non-mechanical loads (for example, thermal loads) are present."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:155
msgid ""
"This command controls options relating to `linear perturbation analyses "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_str/strlinpertother.html>`_."
" It must be issued in the first phase of a linear perturbation analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:161
msgid ""
"A linear perturbation analysis consists of two phases (two :ref:`solve` "
"commands). The first phase is a restart from a base analysis. This base "
"analysis must be a linear or nonlinear static analysis or full transient "
"analysis. The first phase starts with the :ref:`antype`,,RESTART,,,PERTURB "
"command and ends with the :ref:`solve`,ELFORM command. The purpose of the "
"first phase is to re- establish a snapshot of the stiffness matrices at the "
"specified restart point. The second phase, ending with the second "
":ref:`solve` command, is for the actual linear perturbation analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:168
msgid "The total perturbed loads are calculated as follows:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:170
msgid "{F:sub:`perturbed` } = {F:sub:`end` } + {F:sub:`add` }"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:174
msgid ""
"{F :sub:`end` } = total loads at the end of the load step of the current "
"restart point (load applications are read from the :file:`.LDHI` file). By "
"default, all of the loads in {F :sub:`end` } are deleted except for "
"displacement boundary conditions and inertia loads (see the description of "
"``LoadControl`` above)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:178
msgid ""
"{F :sub:`add` } = Additional (new) loads prescribed by the user in the "
"second phase of the linear perturbation analysis (after the first "
":ref:`solve` command is invoked)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:181
msgid ""
"In the first phase of a linear perturbation analysis, the "
":ref:`antype`,,RESTART command resumes the :file:`Jobname.RDB` database and "
"reads in the :file:`.LDHI` file to establish the {F:sub:`end` } load. New "
"load application (adding to {F:sub:`add` }) or load removal (changing "
"{F:sub:`end` }) can be done only in the second phase of the linear "
"perturbation analysis (after the first :ref:`solve` command), allowing "
"flexibility in controlling the final {F:sub:`perturbed` } to be used."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:187
msgid ""
"For ``Type`` = STATIC, {F:sub:`perturbed` } is the actual external load for "
"the static analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:189
msgid ""
"For ``Type`` = MODAL, {F:sub:`perturbed` } is calculated and stored in the "
":file:`.FULL` and :file:`.MODE` files for a subsequent mode-superposition, "
"PSD, or other type of modal-based linear dynamic analysis. Linear dynamic "
"options such as multiple load generations ( :ref:`modcont`,ON), enforced "
"motion ( :ref:`modcont`,,ON), and residual vector methods ( "
":ref:`resvec`,ON) can be used in a linear perturbation analysis. For these "
"methods, the :ref:`modcont` or :ref:`resvec` command must be invoked in the "
"second phase (after the first :ref:`solve` ) of the linear perturbation "
"procedure. For the enforced motion method, the base identification number "
"should be specified ( :ref:`d` command) in the second phase of the linear "
"perturbation analysis. This base identification number is used later in the "
"downstream mode-superposition or other mode-superposition based analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:200
msgid ""
"For ``Type`` = BUCKLE, {F:sub:`perturbed` } is the actual linear buckling "
"load which is used to generate the linear stress stiffening matrix for the "
"buckling analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:203
msgid ""
"For ``Type`` = HARMONIC, {F:sub:`perturbed` } is the actual external load "
"for the full harmonic analysis. In this case, {F:sub:`perturbed` } can be "
"frequency dependent and can use complex input."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:206
msgid ""
"For ``Type`` = SUBSTR, {F:sub:`perturbed` } is used to generate the first "
"reduced external load vector of the substructure."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:209
msgid ""
"In most cases involving linear perturbation analysis, ``Matkey`` = AUTO is "
"the best option for controlling material behavior. ``Matkey`` = TANGENT is "
"often the better option, however, in special cases such as the following:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:213
msgid ""
"A linear perturbation buckling analysis, to introduce preferred buckling "
"modes into a subsequent post-buckling nonlinear analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:216
msgid ""
"A linear perturbation modal analysis, to introduce preferred modes into a "
"subsequent bifurcation analysis."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:219
msgid ""
"If the TANGENT option is used in conjunction with a modal restart solution "
"that follows a linear perturbation modal analysis, then the AUTO option is "
"assumed and linear material properties are used for stress calculations in "
"the modal restart solution. This occurs because the TANGENT material "
"properties are not available during the modal restart phase due to a data "
"architecture limitation. Furthermore, linear material properties are used "
"for the stress calculation in any downstream analysis that uses the modal "
"restart solution."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:226
msgid ""
"For more information about the automatic and tangent options, see in the "
"`Element Reference "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_elem/Hlp_E_BIBLIO.html>`_."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:229
msgid ""
"You can control the contact status for the linear perturbation analysis by "
"using the ``ContKey`` field on this command and/or the :ref:`cnkmod` "
"command. The first table shows the effects of using only the ``ContKey`` "
"setting on the :ref:`perturb` command. The second table shows the effects of"
" using both the :ref:`cnkmod` command and the ``ContKey`` setting on "
":ref:`perturb`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:235
msgid "Adjusted Contact Status when PERTURB Command Is Issued"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:240
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:265
msgid "**ContKeySetting on PERTURB Command**"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:241
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:268
msgid "``ContKey`` Value"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:250
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:285
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:299
msgid "CURRENT or STICKING (mu=0)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:252
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:287
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:301
msgid "STICKING (mu>0) or BONDED"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:259
msgid "Adjusted Contact Status when Both CNKMOD and PERTURB Are Issued"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:269
msgid "Final Adjusted Contact Status"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:275
msgid ":rspan:`5` 1 - near-field"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.perturb:280
msgid ":rspan:`2` 4"
msgstr ""

