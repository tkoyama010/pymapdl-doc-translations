msgid ""
"Creates a regular polygonal area or prism volume anywhere on the working "
"plane."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rpr4:4
msgid ""
"Mechanical APDL Command: `RPR4 "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_RPR4.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rpr4:9
msgid ""
"The number of sides in the polygon or prism face. Must be greater than 2."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rpr4:12
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rpr4:15
msgid ""
"Working plane X and Y coordinates of the center of the polygon or prism "
"face."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rpr4:18
msgid ""
"Distance (major radius) from the center to a vertex of the polygon or prism "
"face (where the first keypoint is defined)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rpr4:22
msgid ""
"Angle (in degrees) from the working plane X-axis to the vertex of the "
"polygon or prism face where the first keypoint is defined. Used to orient "
"the polygon or prism face. Defaults to zero."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rpr4:26
msgid ""
"The perpendicular distance (either positive or negative based on the working"
" plane Z direction) from the working plane representing the depth of the "
"prism. If ``DEPTH`` = 0 (default), a polygonal area is created on the "
"working plane."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rpr4:44
msgid ""
"Defines a regular polygonal area anywhere on the working plane or prism "
"volume with one face anywhere on the working plane. The top and bottom faces"
" of the prism are polygonal areas. See the :ref:`rpoly`, :ref:`poly`, "
":ref:`rprism`, and :ref:`prism` commands for other ways to create polygons "
"and prisms."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.primitives.Primitives.rprism"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/primitives.rst:39:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:2
msgid ""
"Creates a regular prism volume centered about the working plane origin."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:4
msgid ""
"Mechanical APDL Command: `RPRISM "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_RPRISM.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:12
msgid "Working plane Z coordinates of the prism."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:15
msgid ""
"Number of sides in the polygon defining the top and bottom faces of the "
"prism. Must be greater than 2."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:19
msgid ""
"Length of each side of the polygon defining the top and bottom faces of the "
"prism."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:22
msgid ""
"Radius of the major (or circumscribed) circle of the polygon defining the "
"top and bottom faces of the prism. Not used if ``LSIDE`` is input."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:26
msgid ""
"Radius of the minor (or inscribed circle) of the polygon defining the top "
"and bottom faces of the prism. Not used if ``LSIDE`` or ``MAJRAD`` is input."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.rprism:43
msgid ""
"Defines a regular prism volume centered about the working plane origin. The "
"prism must have a spatial volume greater than zero. (that is, this volume "
"primitive command cannot be used to create a degenerate volume as a means of"
" creating an area.) The top and bottom faces are polygonal areas that are "
"parallel to the working plane but neither face need be coplanar with (that "
"is, \"on\") the working plane. The first keypoint defined for each face is "
"at θ = 0°. See the :ref:`rpr4` and :ref:`prism` commands for other ways to "
"create prisms."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.primitives.Primitives.sph4"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/primitives.rst:39:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:2
msgid "Creates a spherical volume anywhere on the working plane."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:4
msgid ""
"Mechanical APDL Command: `SPH4 "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SPH4.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:12
msgid "Working plane X and Y coordinates of the center of the sphere."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:15
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:19
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:13
msgid ""
"Inner and outer radii (either order) of the sphere. A value of zero or blank"
" for either ``RAD1`` or ``RAD2`` defines a solid sphere."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:27
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:25
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:37
msgid "Volume number of the sphere."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:40
msgid ""
"Defines either a solid or hollow spherical volume anywhere on the working "
"plane. The sphere must have a spatial volume greater than zero. (that is, "
"this volume primitive command cannot be used to create a degenerate volume "
"as a means of creating an area.) A sphere of 360° will be defined with two "
"areas, each consisting of a hemisphere. See the :ref:`sphere` and "
":ref:`sph5` commands for other ways to create spheres."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:46
msgid ""
"When working with a model imported from an IGES file (DEFAULT import "
"option), you can create only solid spheres. If you enter a value for both "
"``RAD1`` and ``RAD2`` the command is ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph4:52
msgid ""
"This example creates a hollow sphere with an inner radius of 0.9 and an "
"outer radius of 1.0 centered at ``(0, 0)``"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.primitives.Primitives.sph5"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/primitives.rst:39:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:2
msgid "Creates a spherical volume by diameter end points."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:4
msgid ""
"Mechanical APDL Command: `SPH5 "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SPH5.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:12
msgid "Working plane X and Y coordinates of one edge of the sphere."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:15
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:18
msgid "Working plane X and Y coordinates of the other edge of the sphere."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:38
msgid ""
"Defines a solid spherical volume anywhere on the working plane by specifying"
" diameter end points. The sphere must have a spatial volume greater than "
"zero. (that is, this volume primitive command cannot be used to create a "
"degenerate volume as a means of creating an area.) A sphere of 360° will be "
"defined with two areas, each consisting of a hemisphere. See the "
":ref:`sphere` and :ref:`sph4` commands for other ways to create spheres."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sph5:47
msgid ""
"This example creates a sphere with one point at ``(1, 1)`` and one point at "
"``(2, 2)``"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.primitives.Primitives.sphere"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/primitives.rst:39:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:2
msgid "Creates a spherical volume centered about the working plane origin."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:4
msgid ""
"Mechanical APDL Command: `SPHERE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SPHERE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:17
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:25
msgid ""
"Starting and ending angles (either order) of the sphere. Used for creating a"
" spherical sector. The sector begins at the algebraically smaller angle, "
"extends in a positive angular direction, and ends at the larger angle. The "
"starting angle defaults to 0.0° and the ending angle defaults to 360.0°. See"
" the `Modeling and Meshing Guide "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_mod/Hlp_G_MOD14.html>`_"
" for an illustration."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:50
msgid ""
"Defines either a solid or hollow sphere or spherical sector centered about "
"the working plane origin. The sphere must have a spatial volume greater than"
" zero. (that is, this volume primitive command cannot be used to create a "
"degenerate volume as a means of creating an area.) Inaccuracies can develop "
"when the size of the object you create is much smaller than the relative "
"coordinate system values (ratios near to or greater than 1000). If you "
"require an exceptionally small sphere, create a larger object, and scale it "
"down to the appropriate size."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.sphere:57
msgid ""
"For a solid sphere of 360°, you define it with two areas, each consisting of"
" a hemisphere. See the :ref:`sph4` and :ref:`sph5` commands for the other "
"ways to create spheres."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.primitives.Primitives.torus.rst:2
msgid "ansys.mapdl.core.\\_commands.prep7.primitives.Primitives.torus"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/primitives.rst:39:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:2
msgid "Creates a toroidal volume."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:4
msgid ""
"Mechanical APDL Command: `TORUS "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TORUS.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:19
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:29
msgid ""
"Three values that define the radii of the torus. You can specify the radii "
"in any order. The smallest of the values is the inner minor radius, the "
"intermediate value is the outer minor radius, and the largest value is the "
"major radius. (There is one exception regarding the order of the radii "
"values--if you want to create a solid torus, specify zero or blank for the "
"inner minor radius, in which case the zero or blank must occupy either the "
"``RAD1`` or ``RAD2`` position.) At least two of the values that you specify "
"must be positive values; they will be used to define the outer minor radius "
"and the major radius. See the diagram in the Notes section for a view of a "
"toroidal sector showing all radii."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:28
msgid "**rad3** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:39
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:45
msgid ""
"Starting and ending angles (either order) of the torus. Used for creating a "
"toroidal sector. The sector begins at the algebraically smaller angle, "
"extends in a positive angular direction, and ends at the larger angle. The "
"starting angle defaults to 0° and the ending angle defaults to 360°."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:55
msgid "Volume number of the torus."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:68
msgid ""
"Defines a toroidal volume centered about the working plane origin. A solid "
"torus of 360° will be defined with four areas, each area spanning 180° "
"around the major and minor circumference."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:71
msgid ""
"To create the toroidal sector shown below, the command "
":ref:`torus`,5,1,2,0,180 was issued. Since \"1\" was the smallest radii "
"value specified, it defined the inner minor radius; since \"2\" was the "
"intermediate radii value specified, it defined the outer minor radius; and "
"since \"5\" was the largest radii value specified, it defined the major "
"radius. The values \"0\" and \"180\" defined the starting and ending angles "
"of the torus."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/primitives.pydocstring
#: of ansys.mapdl.core._commands.prep7.primitives.Primitives.torus:82
msgid ""
"This example creates a torus with an inner minor radius of 1, an "
"intermediate radii of 2, and a major radius of 5.  The values 0 and 180 "
"define the starting and ending angles of the torus."
msgstr ""

