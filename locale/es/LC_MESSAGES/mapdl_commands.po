"block, including directly on the lines where the macro block identifier and "
"the macro block terminator appear as shown in the example. Do not place "
"comment lines (or any other lines) outside of a macro block."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/apdl/macro_files.pydocstring
#: of ansys.mapdl.core._commands.apdl.macro_files.MacroFiles.ulib:71
