#: ../../pymapdl/doc/source/mapdl_commands/graphics/labeling.rst:33:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.hbc:2
msgid ""
"Determines how boundary condition symbols are displayed in a display window."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.hbc:4
msgid ""
"Mechanical APDL Command: `/HBC "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_HBC.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.hbc:9
msgid ""
"Window reference number. This number can be any window numbered 1 to 5, or "
"ALL (for all active windows). Default = 1."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.hbc:13
msgid "Controls hidden-surface boundary condition display behavior:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.hbc:15
msgid ""
"ON, YES or 1 = Enable - Your boundary condition symbols are processed by the"
" hidden-surface algorithm (for 2D graphics devices) and use an improved "
"pressure-contour display (for 2D and 3D graphics devices)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.hbc:19
msgid ""
"OFF, NO or 0 (default) = Disable (default) - Your boundary condition symbols"
" are not processed by the hidden-surface algorithm.."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.hbc:36
msgid ""
"With :ref:`hbc`, ``WN``,ON in effect, Mechanical APDL does not display "
"symbols obscured by the model in the current view (that is, symbols inside "
"of or behind the model are not drawn). This behavior lessens display "
"clutter."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/_autosummary/ansys.mapdl.core._commands.graphics.labeling.Labeling.number.rst:2
msgid "ansys.mapdl.core.\\_commands.graphics.labeling.Labeling.number"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/graphics/labeling.rst:33:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:2
msgid "Specifies whether numbers, colors, or both are used for displays."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:4
msgid ""
"Mechanical APDL Command: `/NUMBER "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NUMBER.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:9
msgid "Numbering style:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:11
msgid ""
"``0`` - Color (terminal dependent) the numbered items and show numbers."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:13
msgid "``1`` - Color the numbered items. Do not show the numbers."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:15
msgid "``2`` - Show the numbers. Do not color the items."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:17
msgid ""
"``-1`` - Do not color the items or show the numbers. For contour plots, the "
"resulting display will vary (see below)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:34
msgid ""
"Specifies whether numbers, colors, or both are used for numbering displays ("
" :ref:`pnum` ) of nodes, elements, keypoints, lines, areas, and volumes."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:37
msgid ""
"Shading is also available for terminals configured with more than 4 color "
"planes ( :ref:`show` ). Color automatically appears for certain items and "
"may be manually controlled (off or on) for other items."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:41
msgid ""
"When you suppress color ( ``NKEY`` = -1) your contour plots will produce "
"different results, depending on your graphics equipment. For non-3D devices "
"(X11, Win32, etc.) your contour plot will be white (no color). For 3D "
"devices, such as OpenGL, the resulting display will be in color."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:45
msgid ""
"The following items are automatically given discrete colors: Boundary "
"condition symbols ( :ref:`pbc` ), curves on graph displays, and distorted "
"geometry on postprocessing displays. Contour lines in postprocessing "
"displays are automatically colored based upon a continuous, rather than a "
"discrete, spectrum so that red is associated with the highest contour value."
" On terminals with raster capability ( :ref:`show` ), the area between "
"contour lines is filled with the color of the higher contour."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/labeling.pydocstring
#: of ansys.mapdl.core._commands.graphics.labeling.Labeling.number:52
msgid ""
"Explicit entity colors or the discrete color mapping may be changed with the"
" :ref:`color` command."
msgstr ""

