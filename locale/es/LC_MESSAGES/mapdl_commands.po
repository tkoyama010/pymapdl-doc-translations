#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/element_table.pydocstring
#: of ansys.mapdl.core._commands.post1.element_table.ElementTable.esort:35
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/results.pydocstring of
#: ansys.mapdl.core._commands.post1.results.Results.nsort:25
