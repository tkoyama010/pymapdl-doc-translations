#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.eintf:44
msgid ""
"Node location increments that define the node offset in the active "
"coordinate system (DR, Dθ, DZ for cylindrical and DR, Dθ, DΦ for spherical "
"or toroidal)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/elements.pydocstring of
#: ansys.mapdl.core._commands.prep7.elements.Elements.eintf:47
