" :"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/database/components.pydocstring
#: of ansys.mapdl.core._commands.database.components.Components.cm:33
msgid ""
"0 - Component is not updated during remeshing and therefore contains only "
"initial mesh elements (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/database/components.pydocstring
#: of ansys.mapdl.core._commands.database.components.Components.cm:35
msgid ""
