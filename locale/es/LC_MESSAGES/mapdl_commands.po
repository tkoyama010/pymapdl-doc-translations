#: of
#: ansys.mapdl.core._commands.apdl.parameter_definition.ParameterDefinition.starstatus:149
msgid ""
"``PARM`` - Lists all parameters (except local macro parameters and those "
"with names beginning or ending with an underbar)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/apdl/parameter_definition.pydocstring
#: of
#: ansys.mapdl.core._commands.apdl.parameter_definition.ParameterDefinition.starstatus:32
