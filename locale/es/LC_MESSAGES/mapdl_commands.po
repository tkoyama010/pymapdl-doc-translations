#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:20
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.nlhist:9
msgid "Specifies the command operation:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:22
msgid ""
"``ADD`` - Add the specified component results file ( ``Fname`` ) to the list"
" of files to plot. This option is the default."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:25
msgid ""
"``DELETE`` - Remove the specified component results file ( ``Fname`` ) from "
"the list of files to plot."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:28
msgid "``LIST`` - List all specified component results files."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:30
msgid "``CLEAR`` - Clear all previous files added."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:32
msgid ""
"``ALL`` - Add all component results ( :file:`.rst` ) files from the working "
"directory to the list of files to plot."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:36
msgid ""
"The file name (with full directory path) of the component results file. The "
"default file name is the :file:`Jobname` (specified via the :ref:`filname` "
"command)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:40
msgid ""
"The file name ( ``Fname`` ) extension. The default extension is :file:`rst`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:42
msgid "**cmskey** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:43
msgid ""
"Valid only when adding a results file ( ``Option`` = ADD or ALL), this key "
"specifies whether or not to check the specified :file:`.rst` file to "
"determine if it was created via a CMS expansion pass:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:45
msgid "``ON`` - Check (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:47
msgid "``OFF`` - Do not check."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:63
msgid ""
"The :ref:`cmsfile` command specifies the list of component mode synthesis "
"(CMS) results files to include when plotting the mode shape of an assembly."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:66
msgid ""
"During postprocessing ( :ref:`post1` ) of a CMS analysis, issue the "
":ref:`cmsfile` command to point to component results files of interest. (You"
" can issue the command as often as needed to include all or some of the "
"component results files.) Issue the :ref:`set` command to acquire the "
"frequencies and mode shapes from substeps for all specified results files. "
"Execute a plot ( :ref:`plnsol` ) or print ( :ref:`prnsol` ) operation to "
"display the mode shape of the entire assembly."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:72
msgid ""
"When you specify a results file to add to the plot list, the default "
"behavior of the command ( ``CmsKey`` = ON) is to first verify that the file "
"is from a CMS analysis and that the frequencies of the result sets on the "
"file match the frequencies on the first file in the list. If ``CmsKey`` = "
"OFF, you can add any :file:`.rst` file to the list of files to plot, even if"
" the file was not expanded via a CMS expansion pass."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:78
msgid ""
"If ``CmsKey`` = ON (default), output from the command appears as: ``ADD CMS "
"FILE =`` filename.rst ``CmsKey`` = OFF, output from the command appears as: "
"``ADD FILE =`` filename.rst"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:81
msgid ""
"If ``Option`` = DELETE or CLEAR, you must clear the database ( :ref:`clear` "
"), then re-enter the postprocessor ( :ref:`post1` ) and issue a :ref:`set` "
"command for the change to take effect on subsequent plots."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cmsfile:85
msgid ""
"Clearing the database does not clear the list of files specified via the "
":ref:`cmsfile` command. Specify ``Option`` = CLEAR to clear the list of "
"files."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.post1.special\\_purpose.SpecialPurpose.cyccalc"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/special_purpose.rst:57:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:2
msgid ""
"Calculates results from a cyclic harmonic mode-superposition analysis using "
"the specifications defined by :ref:`cycspec`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:5
msgid ""
"Mechanical APDL Command: `CYCCALC "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_CYCCALC.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:11
msgid "Write the result tables to the output file."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:15
msgid "**fileprefix** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:16
msgid ""
"Each result table (corresponding to each :ref:`cycspec` specification) is "
"written to a file beginning with ``FilePrefix``. If blank (default), the "
"result tables are written to the output file."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:20
msgid "**fileformat** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:21
msgid ""
"If ``FilePrefix`` is specified, then use ``FileFormat`` to specify the "
"format of the file to be written:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:24
msgid "``FORM`` - Formatted file (default)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:26
msgid "``CSV`` - Comma-separated value file"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:28
msgid "**separator** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:29
msgid ""
"If ``FileFormat`` is CSV, use ``Separator`` to specify the field separator:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:31
msgid "``COMMA`` - Use a comma () as the field separator (default)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:33
msgid "``COLON`` - Use a colon (:) as the field separator"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:35
msgid "``DOT`` - Use a period (.) as the field separator"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:51
msgid ""
":ref:`cyccalc` loops through the specification given by :ref:`cycspec` and "
"computes the requested outputs. The outputs are given in a table format, "
"with the rows corresponding to each frequency solution from the harmonic "
"analysis, and the columns corresponding to each sector. The table entries "
"are the maximum value of the specified quantity at the specified location in"
" the sector. In addition, columns containing the maximum value at the "
"frequency, the sector in which it occurs, and the node in the sector at "
"which it occurs are output."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:58
msgid ""
"If ``FilePrefix`` is specified, a file is created for each output table with"
" the name :file:`FilePrefix_node_type.ext`, where ``node`` is the node "
"number or component name, ``type`` is the item/component requested, and the "
"file extension ``.ext`` is either :file:`.txt` or :file:`.csv`, depending on"
" ``FileFormat``."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:63
msgid "A :ref:`set` command must precede the :ref:`cyccalc` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:65
msgid ""
"The :ref:`cyccalc` results are based on the currently active :ref:`rsys`, "
":ref:`shell`, :ref:`layer`, and :ref:`avprin` settings."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cyccalc:68
msgid ""
"The :ref:`cyccalc` command only supports matched nodes. For more details on "
"matching cyclic edge node pairs see `Edge Component Pairs "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_cycsym/advcycedgecomp.html#>`_"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.special_purpose.SpecialPurpose.cycfiles.rst:2
