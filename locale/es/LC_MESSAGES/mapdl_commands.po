msgid "**rmshky** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/morphing.pydocstring of
#: ansys.mapdl.core._commands.prep7.morphing.Morphing.damorph:20
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/morphing.pydocstring of
