#: ../../pymapdl/doc/source/mapdl_commands/graphics/set_up.rst:44:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.noerase:2
msgid "Prevents the screen erase between displays."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.noerase:4
msgid ""
"Mechanical APDL Command: `/NOERASE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_NOERASE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.noerase:21
msgid ""
"Preventing the normal screen erase between requested displays allows you to "
"overlay multiple views."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.noerase:23
msgid ""
"Clearing the screen with the ``ERASE`` command ( Utility Menu> PlotCtrls> "
"Erase Options> Erase screen ) active simply clears the display area. "
"Subsequent replots will provide the cumulative plots previously generated by"
" the :ref:`noerase` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.noerase:27
msgid ""
"For 3D devices, you can issue :ref:`dv3d`,DELS to suppress repeated screen "
"overlays and generate clear contour plots."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.noerase:30
msgid "Use the ``/ERASE`` command to reactivate automatic screen erase."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.noerase:32
msgid ""
"For 3D devices ( :ref:`show`,3D), the model in all active windows will be "
"the same, even if you issue a different display command ( :ref:`nplot`, "
":ref:`eplot`, etc.) for each active window. Use the Multi-Plot command ( "
":ref:`gplot` ) to display different entities, in different windows, on 3D "
"devices."
msgstr ""

