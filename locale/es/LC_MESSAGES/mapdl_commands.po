msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/animation.rst:32:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/animation.pydocstring of
#: ansys.mapdl.core._commands.post1.animation.Animation.trtime:2
msgid ""
"Defines the options used for the :ref:`pltrac` (charged particle trace) "
"command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/animation.pydocstring of
#: ansys.mapdl.core._commands.post1.animation.Animation.trtime:4
msgid ""
"Mechanical APDL Command: `TRTIME "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_TRTIME.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/animation.pydocstring of
#: ansys.mapdl.core._commands.post1.animation.Animation.trtime:9
msgid ""
"Total Trace Time (seconds) (defaults to 0, which is the full particle "
"trace)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/animation.pydocstring of
#: ansys.mapdl.core._commands.post1.animation.Animation.trtime:14
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/surface_operations.pydocstring
#: of
#: ansys.mapdl.core._commands.post1.surface_operations.SurfaceOperations.suvect:33
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.rstoff:21
msgid "**offset** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/animation.pydocstring of
#: ansys.mapdl.core._commands.post1.animation.Animation.trtime:15
msgid ""
"Particle offset in seconds (defaults to 0). It is used internally in the "
":ref:`anflow` macro to produce an animation of charged particle motion in an"
" electric or magnetic field."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/animation.pydocstring of
#: ansys.mapdl.core._commands.post1.animation.Animation.trtime:38
msgid ""
"The :ref:`trtime` command varies the type of :ref:`pltrac` display produced."
" Charged particle traces follow a particle's path in the forward and "
"backward direction of travel. The DOF selected determines the color of the "
"particle trace. ``SPACING`` defines the particle spacing in seconds from "
"adjacent particles in the stream line. ``OFFSET`` defines the offset in "
"seconds from the spacing set by the ``SPACING`` argument."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/animation.pydocstring of
#: ansys.mapdl.core._commands.post1.animation.Animation.trtime:44
msgid ""
"``LENGTH`` defines the particle length fraction. The default value (.1), "
"means the particle occupies 10% of the trace region, and the other 90% is a "
"color-coded line."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/animation.pydocstring of
#: ansys.mapdl.core._commands.post1.animation.Animation.trtime:47
msgid ""
"``SIZE`` sets the radius of the particle. Use ``SPACING``, ``OFFSET`` and "
"``LENGTH`` only when ``SIZE`` is nonzero (that is, the particle is bigger "
"than the line)."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.controls.Controls.avprin.rst:2
msgid "ansys.mapdl.core.\\_commands.post1.controls.Controls.avprin"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/controls.rst:27:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:2
msgid "Specifies how principal and vector sums are to be calculated."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:4
msgid ""
"Mechanical APDL Command: `AVPRIN "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_AVPRIN.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:10
msgid ""
"Average components at common node before principal or vector sum calculation"
" except for the von Mises equivalent strain (EQV), see below."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:16
msgid "Averaging key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:18
msgid ""
"``0`` - Average the component values from the elements at a common node, "
"then calculate the principal or vector sum from the averaged components "
"(default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:21
msgid ""
"``1`` - Calculate the principal or vector sum values on a per element basis,"
" then average these values from the elements at a common node."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:24
msgid "**effnu** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:25
msgid ""
"Effective Poisson's ratio used for computing the von Mises equivalent strain"
" (EQV). This command option is intended for use with line elements or in "
"load case operations ( :ref:`lcoper` ); the program automatically selects "
"the most appropriate effective Poisson's ratio, as discussed below."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:44
msgid ""
"Selects the method of combining components for certain derived nodal results"
" when two or more elements connect to a common node. The methods apply to "
"the calculations of derived nodal principal stresses, principal strains, and"
" vector sums for selects, sorts, and output ( :ref:`nsel`, :ref:`nsort`, "
":ref:`prnsol`, :ref:`plnsol`, etc.). The calculation of these nodal results "
"excludes beam and pipe elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:50
msgid ""
"This command also defines the effective Poisson's ratio ( ``EFFNU`` ) used "
"for equivalent strain calculations. If you use ``EFFNU``, the default "
"effective Poisson's ratios shown below will be overridden for all elements "
"by the ``EFFNU`` value. To return to the default settings, issue the "
":ref:`reset` command. The default value for ``EFFNU`` is:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:55
msgid "Poisson's ratio as defined on the :ref:`mp` commands for EPEL and EPTH"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:57
msgid "0.5 for EPPL and EPCR"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:59
msgid "0.5 if the referenced material is hyperelastic"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:61
msgid ""
"0.0 for line elements (includes beam, link, and pipe elements, as well as "
"discrete elements), `cyclic symmetry analysis "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_cycsym/cycsym_example.html>`_,"
" mode superposition analyses (with ``MSUPkey`` = YES on the :ref:`mxpand` "
"command), and load case operations ( :ref:`lcoper` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:67
msgid ""
"For multistage analysis, a value of ``EFFNU`` must always be specified."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:69
msgid ""
"If ``EFFNU`` is specified, the calculation of von Mises equivalent strain "
"(EQV) is performed according to the ``KEY`` setting. However, if ``EFFNU`` "
"is not specified, or if the :ref:`avprin` command is not issued, the von "
"Mises equivalent strain is calculated using the average of the equivalent "
"strains from the elements at a common node (behavior of ``KEY`` =1) "
"irrespective of the value of the averaging KEY."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:75
msgid ""
"For a random vibration (PSD) analysis (for more details, see `Review the "
"Results "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_str/Hlp_G_STR6_8.html#strcovtlm61199>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:78
msgid ""
"Issuing either :ref:`avprin`,0 or :ref:`avprin`,1 calculates the principal "
"stresses using the appropriate averaging method. They are then used to "
"determine SEQV. The output will have non-zero values for the principal "
"stresses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:82
msgid ""
"If :ref:`avprin` is not issued, the Segalman-Fulcher method is used to "
"calculate SEQV. This method does not calculate principal stresses, but "
"directly calculates SEQV from the component stresses; therefore, the output "
"will have zero values for the principal stresses."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:86
msgid "This command is also valid in POST26, where applicable."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avprin:88
msgid ""
"See `Combined Stresses and Strains "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_thry/thy_str4.html#strucfailure>`_"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.controls.Controls.avres.rst:2
msgid "ansys.mapdl.core.\\_commands.post1.controls.Controls.avres"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/controls.rst:27:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:2
msgid ""
"Specifies how results data will be averaged when PowerGraphics is enabled."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:4
msgid ""
"Mechanical APDL Command: `AVRES "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_AVRES.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:9
msgid "Averaging key."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:11
msgid "``1`` - Average results at all common subgrid locations."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:13
msgid ""
"``2`` - Average results at all common subgrid locations except where "
"material type ( :ref:`mat` ) discontinuities exist. (Default.)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:16
msgid ""
"``3`` - Average results at all common subgrid locations except where real "
"constant ( :ref:`real` ) discontinuities exist."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:19
msgid ""
"``4`` - Average results at all common subgrid locations except where "
"material type ( :ref:`mat` ) or real constant ( :ref:`real` ) "
"discontinuities exist."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:23
msgid "Option to determine how results data are averaged."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:25
msgid ""
"``(blank)`` - Average surface results data using only the exterior element "
"faces (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:27
msgid ""
"``FULL`` - Average surface results data using the exterior face and interior"
" element data."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:43
msgid ""
"The :ref:`avres` command specifies how results data will be averaged at "
"subgrid locations that are common to 2 or more elements. The command is "
"valid only when PowerGraphics is enabled (via the :ref:`graphics`,POWER "
"command)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:54
msgid ""
"PowerGraphics does not average your stresses across discontinuous surfaces. "
"The normals for various planes and facets are compared to a tolerance to "
"determine continuity. The ``ANGLE`` value you specify in the :ref:`edge` "
"command is the tolerance for classifying surfaces as continuous or "
"\"coplanar.\""
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:59
msgid ""
"The command affects nodal solution contour plots ( :ref:`plnsol` ), nodal "
"solution printout ( :ref:`prnsol` ), and subgrid solution results accessed "
"through the Query Results function (under General Postprocessing) in the "
"GUI."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:63
msgid ""
"The command has no effect on the nodal degree of freedom solution values "
"(UX, UY, UZ, TEMP, etc.)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:65
msgid ""
"For cyclic symmetry mode-superposition harmonic solutions, "
":ref:`avres`,,FULL is not supported. Additionally, averaging does not occur "
"across discontinuous surfaces, and the ``ANGLE`` value on the :ref:`edge` "
"command has no effect."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:69
msgid ""
"The section-based ( :ref:`mat` ) discontinuity in shells is accommodated via"
" :ref:`eshape`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/controls.pydocstring of
#: ansys.mapdl.core._commands.post1.controls.Controls.avres:71
msgid "The command is also available in :ref:`slashsolu`."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/post1/_autosummary/ansys.mapdl.core._commands.post1.controls.Controls.efacet.rst:2
