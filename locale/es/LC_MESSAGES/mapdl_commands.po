msgid ":ref:`rstcontrol` is also valid in PREP7."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.sbclist.rst:2
msgid "ansys.mapdl.core.\\_commands.solution.misc\\_loads.MiscLoads.sbclist"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/misc_loads.rst:39:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.sbclist:2
msgid "Lists solid model boundary conditions."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.sbclist:4
msgid ""
"Mechanical APDL Command: `SBCLIST "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SBCLIST.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.sbclist:21
msgid ""
"Lists all solid model boundary conditions for the selected solid model "
"entities. See also :ref:`dklist`, :ref:`dllist`, :ref:`dalist`, "
":ref:`fklist`, :ref:`sfllist`, :ref:`sfalist`, :ref:`bfllist`, "
":ref:`bfalist`, :ref:`bfvlist`, and :ref:`bfklist` to list items separately."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.sbctran.rst:2
msgid "ansys.mapdl.core.\\_commands.solution.misc\\_loads.MiscLoads.sbctran"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/misc_loads.rst:39:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.sbctran:2
msgid "Transfers solid model loads and boundary conditions to the FE model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.sbctran:4
msgid ""
"Mechanical APDL Command: `SBCTRAN "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_SBCTRAN.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.sbctran:21
msgid ""
"Causes a manual transfer of solid model loads and boundary conditions to the"
" finite element model. Loads and boundary conditions on unselected "
"keypoints, lines, areas, and volumes are not transferred. Boundary "
"conditions and loads will not be transferred to unselected nodes or "
"elements. The :ref:`sbctran` operation is also automatically done upon "
"initiation of the solution calculations ( :ref:`solve` )."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.wsprings.rst:2
msgid "ansys.mapdl.core.\\_commands.solution.misc\\_loads.MiscLoads.wsprings"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/misc_loads.rst:39:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.wsprings:2
msgid ""
"Creates weak springs on corner nodes of a bounding box of the currently "
"selected elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.wsprings:4
msgid ""
"Mechanical APDL Command: `WSPRINGS "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_WSPRINGS.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.wsprings:21
msgid ""
"This command invokes a predefined Mechanical APDL macro that is used during "
"the import of loads from the ADAMS program into Mechanical APDL."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.wsprings:25
msgid ""
"The command creates weak springs on the corner nodes of the bounding box of "
"the currently selected elements. The six nodes of the bounding box are "
"attached to ground using ``COMBIN14`` elements. The stiffness is chosen as a"
" small number and can be changed by changing the real constants of the "
"``COMBIN14`` elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.wsprings:30
msgid ""
"The command works only for models that have a geometric extension in two or "
"three dimensions. One- dimensional problems (pure beam in one axis) are not "
"supported."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.wsprings:33
msgid ""
"For more information about how :ref:`wsprings` is used during the transfer "
"of loads from the ADAMS program to Mechanical APDL, see `Import Loads into "
"Mechanical APDL "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_substr/advtrans12902.html#advimport>`_."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/misc_loads.pydocstring
#: of ansys.mapdl.core._commands.solution.misc_loads.MiscLoads.wsprings:37
msgid ""
"Distributed-Memory Parallel (DMP) Restriction This command is not supported "
"in a DMP solution."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.arclen"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:2
msgid "Activates the arc-length method."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:4
msgid ""
"Mechanical APDL Command: `ARCLEN "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_ARCLEN.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:9
msgid "Arc-length key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:11
msgid "``OFF`` - Do not use the arc-length method (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:13
msgid "``ON`` - Use the arc-length method."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:15
msgid "**maxarc** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:16
msgid "Maximum multiplier of the reference arc-length radius (default = 25)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:18
msgid "**minarc** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:19
msgid ""
"Minimum multiplier of the reference arc-length radius (default = 1/1000)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:35
msgid ""
"Activates the arc-length method and sets the minimum and maximum multipliers"
" for controlling the arc-length radius based on the initial arc-length "
"radius."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:38
msgid ""
"The initial arc-length radius, t:sub:`0`, is proportional (in absolute "
"value) to the initial load factor. The initial load factor is given by:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:41
msgid "Initial Load Factor = ``TIME`` / ``NSBSTP``"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:43
msgid ""
"where ``TIME`` is the time specified by the :ref:`time` command for the arc-"
"length load step, and ``NSBSTP`` is the number of substeps specified by the "
":ref:`nsubst` command."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:46
msgid ""
"The factors ``MAXARC`` and ``MINARC`` are used to define the range for the "
"arc-length radius to expand and shrink during the substep solution:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:49
msgid "t :sub:`MAX` = ``MAXARC`` \\* t :sub:`0`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:50
msgid "t :sub:`MIN` = ``MINARC`` \\* t :sub:`0`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:52
msgid ""
"In each substep, the arc-length radius is kept constant throughout the "
"equilibrium iterations. After each converged substep, the arc-length radius "
"for the next substep is modified depending on the convergence behavior. If "
"the substep converges and the program heuristic predicts an easy "
"convergence, the arc-length radius is enlarged. If the enlarged value is "
"greater than t:sub:`MAX`, the arc-length radius is reset to t:sub:`MAX`. If "
"the substep does not converge, bisection will take place until the arc-"
"length radius is reduced to t:sub:`MIN`. If further nonconvergence is "
"encountered, the solution terminates."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:60
msgid ""
"The arc-length method predicts the next time increment (that is, load factor"
" increment). Therefore, the :ref:`autots` and :ref:`pred` commands are "
"ignored when the arc-length method is used."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:63
msgid "The :ref:`stabilize` and :ref:`lnsrch` commands are also ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:65
msgid "The arc-length method cannot be used in a multiframe restart."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:67
msgid ""
"For difficult problems, one suggestion is to increase the initial number of "
"substeps ( :ref:`nsubst` ), and to prevent the arc-length radius from "
"increasing too rapidly ( ``MAXARC`` = 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:70
msgid ""
":ref:`arclen` cannot be used for any load step that has no applied load or "
"displacement."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:72
msgid ""
"The arc-length method does not support tabular loads. In order to use the "
"arc-length method, you must replace tabular loads by other load types and "
"then run the analysis again."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arclen:75
msgid ""
"The arc-length method can only be used with the sparse solver ( "
":ref:`eqslv`,SPARSE). If any other solver is specified, the solver method is"
" automatically changed to sparse, and a warning message is issued to notify "
"you."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.arctrm"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:2
msgid ""
"Controls termination of the solution when the arc-length method is used."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:4
msgid ""
"Mechanical APDL Command: `ARCTRM "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_ARCTRM.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:9
msgid "Specifies the basis of solution termination:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:11
msgid "``OFF`` - Does not use :ref:`arctrm` to terminate analysis (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:13
msgid ""
"``L`` - Terminates the analysis if the first limit point has been reached. "
"The first limit point is that point in the response history when the tangent"
" stiffness matrix becomes singular (that is, the point at which the "
"structure becomes unstable). If ``Lab`` = L, arguments ``VAL``, ``NODE``, "
"``DOF`` are ignored."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:18
msgid ""
"``U`` - Terminates the analysis when the displacement first equals or "
"exceeds the maximum desired value."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:22
msgid ""
"Maximum desired displacement (absolute value). Valid only if ``Lab`` = U. "
"The analysis terminates whenever the calculated displacement first equals or"
" exceeds this value. For rotational degrees of freedom, ``VAL`` must be in "
"radians (not degrees)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:27
msgid ""
"Node number corresponding to displacement used to compare with displacement "
"specified by ``VAL``. If blank, the maximum displacement will be used. Valid"
" only if ``Lab`` = U."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:31
msgid ""
"Valid degree of freedom label for nodal displacement specified by ``NODE``. "
"Valid labels are UX, UY, UZ, ROTX, ROTY, ROTZ. Valid only if ``NODE`` >0 and"
" ``Lab`` = U."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:48
msgid ""
"The :ref:`arctrm` command is valid only when the arc-length method ( "
":ref:`arclen`,ON) is used."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.arctrm:50
msgid ""
"It can be convenient to use this command to terminate the analysis when the "
"first limit point is reached. In addition, the :ref:`ncnv` command should be"
" used to limit the maximum number of iterations. If the :ref:`arctrm` "
"command is not used, and the applied load is so large that the solution path"
" can never reach that load, the arc-length solution will continue to run "
"until a CPU time limit or a \"maximum number of iterations\" is reached."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.bucopt"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/nonlinear_options.rst:38:<autosummary>:1
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:2
msgid "Specifies buckling analysis options."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:4
msgid ""
"Mechanical APDL Command: `BUCOPT "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_BUCOPT.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:9
msgid "Mode extraction method to be used for the buckling analysis:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:13
msgid "``SUBSP`` - Subspace iteration"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:15
msgid ""
"See `Eigenvalue and Eigenvector Extraction "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en/ans_thry/thy_tool13.html#eltcomplexeigens>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:19
msgid ""
"Number of buckling modes (that is, eigenvalues or load multipliers) to "
"extract (defaults to 1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:21
msgid "**shift** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:22
msgid ""
"By default, this value acts as the initial shift point about which the "
"buckling modes are calculated (defaults to 0.0)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:25
msgid ""
"When ``RangeKey`` = RANGE, this value acts as the lower bound of the load "
"multiplier range of interest ( ``LDMULTE`` is the upper bound)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:28
msgid "**ldmulte** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:29
msgid ""
"Boundary for the load multiplier range of interest (defaults to "
":math:`equation not available` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:32
msgid ""
"When ``RangeKey`` = CENTER, the ``LDMULTE`` value determines the lower and "
"upper bounds of the load multiplier range of interest (- ``LDMULTE``, + "
"``LDMULTE`` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:35
msgid ""
"When ``RangeKey`` = RANGE, the ``LDMULTE`` value is the upper bound for the "
"load multiplier range of interest ( ``SHIFT`` is the lower bound)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:38
msgid "**rangekey** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:39
msgid ""
"Key used to control the behavior of the eigenvalue extraction method "
"(defaults to CENTER):"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:41
msgid ""
"``CENTER`` - Use the CENTER option control (default); the program computes "
"``NMODE`` buckling modes centered around ``SHIFT`` in the range of (- "
"``LDMULTE``, + ``LDMULTE`` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:44
msgid ""
"``RANGE`` - Use the RANGE option control; the program computes ``NMODE`` "
"buckling modes in the range of ( ``SHIFT``, ``LDMULTE`` )."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:61
msgid ""
"Specifies buckling analysis ( :ref:`antype`,BUCKLE) options. Additional "
"options used only for the Block Lanczos (LANB) eigensolver are specified by "
"the :ref:`lanboption` command. For more difficult buckling problems, you can"
" specify an alternative version of the Block Lanczos eigensolver ( "
":ref:`lanboption`,,,ALT1)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:66
msgid ""
"Eigenvalues from a buckling analysis can be negative and/or positive. The "
"program sorts the eigenvalues from the most negative to the most positive "
"values. The minimum buckling load factor may correspond to the smallest "
"eigenvalue in absolute value, or to an eigenvalue within the range, "
"depending on your application (that is, linear perturbation buckling "
"analysis or purely linear buckling analysis)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:72
msgid ""
"It is recommended that you request an additional few buckling modes beyond "
"what is needed in order to enhance the accuracy of the final solution. It is"
" also recommended that you input a non zero ``SHIFT`` value and a reasonable"
" ``LDMULTE`` value (that is, a smaller ``LDMULTE`` that is closer to the "
"last buckling mode of interest) when numerical problems are encountered."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.bucopt:77
msgid ""
"When using the RANGE option, defining a range that spans zero is not "
"recommended. If you are seeking both negative and positive eigenvalues, it "
"is recommended that you use the CENTER option."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.nonlinear\\_options.NonlinearOptions.cnvtol"
msgstr ""

