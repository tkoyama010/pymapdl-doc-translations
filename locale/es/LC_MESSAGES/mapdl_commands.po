msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:4
msgid ""
"Mechanical APDL Command: `LGWRITE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_LGWRITE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:14
msgid ""
"Filename extension (eight-character maximum). The extension defaults to LGW "
"if ``Fname`` and ``Ext`` are blank."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:17
msgid "**kedit** : :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:18
msgid "Flag to suppress nonessential commands:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:20
msgid "``NONE`` - Do not suppress any commands (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:22
msgid ""
"``COMMENT`` - Write nonessential commands as comments (starting with !)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:24
msgid "``REMOVE`` - Do not write nonessential commands or comments."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/session/files.pydocstring of
#: ansys.mapdl.core._commands.session.files.Files.lgwrite:40
msgid ""
"Writes the database command log to a named file. The database command log "
"contains all commands that were used to create the current database. These "
"commands are recorded in the database as they are issued, and saved in the "
"database file ( :file:`File.DB` ) whenever the database is saved. The "
":ref:`lgwrite` command extracts these commands from the database and writes "
"them to a file. Nonessential commands (for listing, graphics displays, help,"
" etc.) can be excluded from the file by using the ``Kedit`` field. The file "
"resulting from :ref:`lgwrite` can be used as command input to the program. "
"This command is most useful if the session log file ( :file:`File.LOG` ), "
"which is normally saved during an interactive session, has been lost or "
"corrupted."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/session/_autosummary/ansys.mapdl.core._commands.session.files.Files.slashclog.rst:2
msgid "ansys.mapdl.core.\\_commands.session.files.Files.slashclog"
msgstr ""

