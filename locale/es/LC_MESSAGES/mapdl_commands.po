"with the corresponding degrees of freedom of the nodes of the second part "
"interface elements using the shape functions of those elements."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.ceims:86
