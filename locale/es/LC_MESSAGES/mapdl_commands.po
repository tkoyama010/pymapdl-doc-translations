#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.n:41
msgid "Node number of the generated node."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/nodes.pydocstring of
#: ansys.mapdl.core._commands.prep7.nodes.Nodes.n:54
msgid ""
"Defines a node in the active coordinate system ( :ref:`csys` ). The nodal "
"coordinate system is parallel to the global Cartesian system unless rotated."
