#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:2
msgid "Lists the constraint equations."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:4
msgid ""
"Mechanical APDL Command: `CELIST "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_CELIST.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:9
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:14
#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:19
msgid ""
"List constraint equations from ``NEQN1`` to ``NEQN2`` (defaults to ``NEQN1``"
" ) in steps of ``NINC`` (defaults to 1). If ``NEQN1`` = ALL (default), "
"``NEQN2`` and ``NINC`` are ignored and all constraint equations are listed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:24
msgid "Options for listing constraint equations:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:26
msgid ""
"``ANY`` - List equation set if any of the selected nodes are in the set "
"(default). Only externally-generated constraint equations are listed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:29
msgid ""
"``ALL`` - List equation set only if all of the selected nodes are in the "
"set. Only externally- generated constraint equations are listed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:32
msgid ""
"``INTE`` - List internally-generated constraint equations that are "
"associated with MPC-based contact. Constraint equations are listed only if "
"all the nodes in the set are selected."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:35
msgid ""
"``CONV`` - Convert internal constraint equations to external constraint "
"equations. Internal constraint equations are converted only if all of the "
"nodes in the set are selected."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/constraint_equations.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.celist:52
msgid ""
"This command is valid in any processor. However, the INTE and CONV options "
"are only valid in the Solution processor after a :ref:`solve` command has "
"been issued."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/prep7/_autosummary/ansys.mapdl.core._commands.prep7.constraint_equations.ConstraintEquations.cerig.rst:2
