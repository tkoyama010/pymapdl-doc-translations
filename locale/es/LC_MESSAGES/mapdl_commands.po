#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.mode:2
msgid "Specifies the harmonic loading term for this load step."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.mode:4
msgid ""
"Mechanical APDL Command: `MODE "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_MODE.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.mode:9
msgid ""
"Number of harmonic waves around circumference for this harmonic loading term"
" (defaults to 0)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.mode:11
msgid "**isym** : :class:`python:int` or :class:`python:str`"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.mode:12
msgid ""
"Symmetry condition for this harmonic loading term (not used when ``MODE`` = "
"0):"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.mode:14
msgid ""
"``1`` - Symmetric (UX, UY, ROTZ, TEMP use cosine terms; UZ uses sine term) "
"(default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.mode:16
msgid ""
"``-1`` - Antisymmetric (UX, UY, ROTZ, TEMP use sine terms; UZ uses cosine "
"term)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.mode:32
msgid ""
"Used with axisymmetric elements having nonaxisymmetric loading capability "
"(for example, ``PLANE25``, ``SHELL61``, etc.). For analysis types "
":ref:`antype`,MODAL, HARMIC, TRANS, and SUBSTR, the term must be defined in "
"the first load step and may not be changed in succeeding load steps."
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/_autosummary/ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst.rst:2
msgid ""
"ansys.mapdl.core.\\_commands.solution.load\\_step\\_options.LoadStepOptions.nsubst"
msgstr ""

#: ../../pymapdl/doc/source/mapdl_commands/solution/load_step_options.rst:36:<autosummary>:1
