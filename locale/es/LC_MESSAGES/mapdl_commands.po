msgid ""
"``0 or 1`` - Half-crack model with symmetry boundary conditions ( "
":ref:`dsym` ]) in the crack-tip coordinate system. K:sub:`II` = K:sub:`III` "
"= 0. Three nodes are required on the path."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/post1/_special_purpose.pydocstring
#: of
#: ansys.mapdl.core._commands.post1._special_purpose.SpecialPurpose.kcalc:24
