#: ansys.mapdl.core._commands.prep7.meshing.Meshing.mshcopy:5
msgid ""
"Mechanical APDL Command: `MSHCOPY "
"<https://ansyshelp.ansys.com/Views/Secured/corp/v232/en//ans_cmd/Hlp_C_MSHCOPY.html>`_"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/meshing.pydocstring of
