#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:89
msgid ""
"The minimum value allowed for the program-calculated reference value. If "
"negative, no minimum is enforced. Used only if ``VALUE`` is blank. Default "
"values are as follows:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:92
msgid ""
"maximum of 0.01 or internally calculated minimum reference value for force "
"(F), moment (M)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
