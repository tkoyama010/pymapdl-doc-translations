#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:52
msgid ""
"For all other ``Lab`` labels, the default tolerance value is 0.005 (0.5%)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:54
msgid "If :ref:`cnvtol` is not issued, the ``TOLER`` defaults are as follows:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:56
msgid "0.005 (0.5%) for force (F) and moment (M)"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/nonlinear_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.nonlinear_options.NonlinearOptions.cnvtol:58
