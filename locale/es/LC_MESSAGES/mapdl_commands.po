msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edcurve:14
msgid ""
"DELE - Delete the specified data curve (LCID). If LCID is blank, all data "
"curves are"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edcurve:15
msgid "deleted. Par1 and Par2 are ignored for this option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edcurve:17
msgid ""
"LIST - List defined data curve (LCID). If LCID is blank, all data curves are"
" listed."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edcurve:18
msgid "Par1 and Par2 are ignored for this option."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/explicit_dynamics.pydocstring
#: of
#: ansys.mapdl.core._commands.prep7.explicit_dynamics.ExplicitDynamics.edcurve:20
msgid ""
"PLOT - Plot defined data curve (LCID). If Option = PLOT, LCID must be "
