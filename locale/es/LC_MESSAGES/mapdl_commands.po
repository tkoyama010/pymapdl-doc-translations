msgid "Control key:"
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:100
msgid "``OFF or 0`` - Turns specified function off."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:102
msgid ""
"``ON or 1`` - Turns specified function on or designates the LEGEND font."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/graphics/set_up.pydocstring of
#: ansys.mapdl.core._commands.graphics.set_up.SetUp.device:104
msgid "``2`` - Designates the ENTITY font."
