"``VTPA`` - Frequency-sweep (Variational Technology) perfect absorber method "
"(based on the FULL harmonic algorithm). See :ref:`HROPT_VT_VTPA`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/dynamic_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.dynamic_options.DynamicOptions.hropt:25
msgid "``KRYLOV`` - Frequency-sweep Krylov method. See :ref:`HROPT_KRYLOV`."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/dynamic_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.dynamic_options.DynamicOptions.hropt:27
