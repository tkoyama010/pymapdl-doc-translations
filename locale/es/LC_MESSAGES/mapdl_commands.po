"Node where valve is to be placed (as described below). Defaults to current "
"run starting point."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/prep7/piping.pydocstring of
#: ansys.mapdl.core._commands.prep7.piping.Piping.valve:12
msgid "Length of valve (defaults to larger pipe OD)."
msgstr ""

