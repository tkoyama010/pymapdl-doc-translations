#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.eresx:10
msgid ""
"Extrapolate integration-point results to the nodes for all elements except "
"those with active plasticity, creep, or swelling nonlinearities (default)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/analysis_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.analysis_options.AnalysisOptions.eresx:13
