#: of
#: ansys.mapdl.core._commands.apdl.parameter_definition.ParameterDefinition.dim:122
msgid ""
"``var1 : str`` - Variable name corresponding to the first dimension (row) "
"for ``Type`` = TABLE, TAB4, or TAB5. Default = Row."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/apdl/parameter_definition.pydocstring
#: of
#: ansys.mapdl.core._commands.apdl.parameter_definition.ParameterDefinition.dim:125
msgid ""
"``var2 : str`` - Variable name corresponding to the second dimension "
"(column) for ``Type`` = TABLE, TAB4, or TAB5. Default = Column."
msgstr ""

