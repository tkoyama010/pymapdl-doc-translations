"step (if automatic time stepping is used)."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.deltim:33
#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.nsubst:35
msgid ""
"The program automatically determines the default based on the physics of the"
" model."
msgstr ""

#: ../../pymapdl/src/ansys/mapdl/core/_commands/solution/load_step_options.pydocstring
#: of
#: ansys.mapdl.core._commands.solution.load_step_options.LoadStepOptions.deltim:49
